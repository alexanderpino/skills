{
  "name": "@skills/terrain-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Terrain Studio \u2014 node-graph WebGL terrain generator. Installable PWA; ES modules, no runtime dependencies.",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build",
    "bridge:surface": "node scripts/run-legacy-verify.mjs _verify_bridge.js --file",
    "bridge:check": "node scripts/run-legacy-verify.mjs _verify_bridge.js --check --file",
    "bridge:gen": "node scripts/generate-bridge.mjs",
    "verify": "node scripts/run-legacy-verify.mjs",
    "verify:all": "node scripts/sweep-oracles.mjs",
    "test:runner": "node --test tests/runner/isolated-verify-runner.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "bridge:apply": "node scripts/apply-bridge.mjs",
    "bridge:verify": "node scripts/apply-bridge.mjs --check",
    "plugins:extract": "node scripts/extract-plugins.cjs",
    "plugins:exports": "node scripts/export-plugin-helpers.cjs",
    "plugins:tdz": "node scripts/check-plugin-tdz.cjs",
    "plugins:check": "node scripts/check-plugin-imports.cjs && node scripts/check-plugin-exports.cjs && node scripts/check-plugin-tdz.cjs",
    "syntax:check": "node scripts/check-syntax.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "vite": "^7.1.5"
  }
}
