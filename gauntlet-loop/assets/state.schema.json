{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/gauntlet/state.schema.json",
  "title": "Gauntlet workbench spec",
  "description": "The document gauntlet/workbench.html renders. Normally written by `gauntlet.py board`; documented here so it can also be written by hand in degraded mode. Every field is optional except those in `required` \u2014 the board draws what is present and reports what is malformed, so a partial spec produces a smaller board rather than an error.",
  "type": "object",
  "required": [
    "wave",
    "columns"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "integer",
      "description": "Spec version. The board renders version 1 and warns on anything higher.",
      "const": 1
    },
    "generated": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp. The board greys out its status dot when this is more than 15 minutes old \u2014 a stale board is worse than no board.",
      "format": "date-time"
    },
    "goal": {
      "type": [
        "string",
        "null"
      ],
      "description": "The run's destination, one sentence. Read from the GOAL line of contract.md."
    },
    "bar_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "reference",
        "acceptance criteria",
        "hybrid",
        null
      ]
    },
    "wave": {
      "type": "integer",
      "minimum": 0
    },
    "budget_waves": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "initial_budget_waves": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The budget agreed at intake, before extensions. Shown so the board distinguishes 'agreed' from 'current'."
    },
    "read": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "improving",
        "mixed",
        "at-ceiling",
        "unclear",
        "nothing-open",
        null
      ],
      "description": "The log's read on whether the artifact is still moving. A reading, not a decision."
    },
    "read_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "One line explaining the read in words."
    },
    "evidence_lines": {
      "type": "array",
      "description": "Per-open-dimension trend lines backing the read.",
      "items": {
        "type": "string"
      }
    },
    "fired": {
      "type": "array",
      "description": "Stop conditions currently firing. A non-empty list means the run should not still be running, and the board says so in red.",
      "items": {
        "type": "string"
      }
    },
    "stops": {
      "type": "object",
      "description": "The armed thresholds, for the reader who wants to know what retirement and shelving mean in this run.",
      "properties": {
        "bar_met_n": {
          "type": "integer",
          "minimum": 1
        },
        "clean_streak_n": {
          "type": "integer",
          "minimum": 1
        },
        "flat_rounds_n": {
          "type": "integer",
          "minimum": 2
        },
        "hard_cap_waves": {
          "type": [
            "integer",
            "null"
          ]
        },
        "hard_cap_tokens": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "models": {
      "type": "object",
      "description": "Which model each tier label resolves to, what it costs relative to the cheapest tier, and how much of the run it consumed. The multiplier \u2014 not the absolute price \u2014 is what a routing decision turns on.",
      "properties": {
        "as_of": {
          "type": "string",
          "description": "Date the published prices were recorded."
        },
        "attributed_calls": {
          "type": "integer",
          "description": "Calls that carried a --model. Zero means the board can show the roster but not who did the work."
        },
        "roster": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "enum": [
                  "cheap",
                  "mid",
                  "high"
                ]
              },
              "id": {
                "type": "string",
                "description": "Resolved model id, e.g. claude-sonnet-5"
              },
              "ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Output-token cost relative to the cheapest tier. null when the model has no price on file."
              },
              "price": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Published USD per million tokens.",
                "properties": {
                  "in": {
                    "type": "number"
                  },
                  "out": {
                    "type": "number"
                  }
                }
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "escalation": {
          "type": [
            "object",
            "null"
          ],
          "description": "Verdicts re-judged on a stronger critic, and whether it agreed. The run's own evidence about whether the cheap tier was good enough.",
          "properties": {
            "escalations": {
              "type": "integer",
              "minimum": 0
            },
            "agreed": {
              "type": "integer",
              "minimum": 0
            },
            "overturned": {
              "type": "integer",
              "minimum": 0
            },
            "agreement_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "tier": {
      "type": "object",
      "description": "Where the run sits on the effort ladder, and what that tier costs per round.",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "builder_model": {
          "type": "string",
          "description": "Tier label as configured."
        },
        "critic_model": {
          "type": "string",
          "description": "Tier label as configured."
        },
        "builder_model_id": {
          "type": "string",
          "description": "Resolved model id."
        },
        "critic_model_id": {
          "type": "string",
          "description": "Resolved model id."
        },
        "calls_per_lane_round": {
          "type": "integer",
          "minimum": 1
        },
        "allowance_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ladder": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "lanes": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "dims": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "critic_calls": {
                "type": "integer",
                "minimum": 1
              },
              "builder_model": {
                "type": "string"
              },
              "critic_model": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "done",
                  "current",
                  "locked"
                ]
              }
            }
          }
        },
        "history": {
          "type": "array",
          "description": "Every escalation, with the evidence that bought it.",
          "items": {
            "type": "object",
            "properties": {
              "at_wave": {
                "type": "integer"
              },
              "from_tier": {
                "type": "integer"
              },
              "to_tier": {
                "type": "integer"
              },
              "spend_at": {
                "type": "integer"
              },
              "reason": {
                "type": "string"
              },
              "log_read": {
                "type": "string"
              },
              "forced": {
                "type": "boolean"
              },
              "failing_gates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "spend": {
      "type": "object",
      "description": "What the run has cost. Money is what the user is spending; tokens are how it is measured. When cost_eur_per_mtok was set at init, both are present and the board leads with money.",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "budget_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "budget_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "per_wave": {
          "type": [
            "integer",
            "null"
          ]
        },
        "waves_left_at_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "by_role": {
          "type": "object",
          "description": "Tokens per role \u2014 builder, critic, smoother, lead, other.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_tier": {
          "type": "object",
          "description": "Tokens per effort tier, keyed by tier index as a string.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "priced_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "total_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "by_model": {
          "type": "object",
          "description": "Tokens per model id, for the calls that carried a --model.",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "evidence_mix": {
      "type": "object",
      "description": "Blind, rubric and oracle bar-round counts. Not equivalent evidence, and the board labels them so.",
      "properties": {
        "blind": {
          "type": "integer",
          "minimum": 0
        },
        "rubric": {
          "type": "integer",
          "minimum": 0
        },
        "oracle": {
          "type": "integer",
          "minimum": 0,
          "description": "Bar rounds decided by measurement rather than by a model \u2014 no critic tokens, and stronger evidence."
        }
      }
    },
    "extensions": {
      "type": "array",
      "description": "Granted budget extensions, in order.",
      "items": {
        "type": "object",
        "properties": {
          "at_wave": {
            "type": "integer"
          },
          "waves": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "log_read": {
            "type": "string"
          }
        }
      }
    },
    "shelved": {
      "type": "array",
      "description": "Dimensions parked mid-run. Parked is not retired: the report keeps their open gaps.",
      "items": {
        "type": "object",
        "properties": {
          "lane": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "at_wave": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "open_gap": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "columns": {
      "type": "object",
      "description": "The Kanban. Every lane/dimension pair lives in exactly one column.",
      "properties": {
        "open": {
          "$ref": "#/definitions/cardList"
        },
        "flat": {
          "$ref": "#/definitions/cardList"
        },
        "shelved": {
          "$ref": "#/definitions/cardList"
        },
        "retired": {
          "$ref": "#/definitions/cardList"
        }
      }
    },
    "rounds": {
      "type": "array",
      "description": "Recent rounds, newest first. A glance surface, not an archive \u2014 rounds.jsonl stays the full record.",
      "items": {
        "$ref": "#/definitions/round"
      }
    },
    "skipped": {
      "type": "object",
      "description": "Rounds deliberately not run. The cheapest round is the one management removes; without this the saving is invisible.",
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "calls_saved": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_saved_est": {
          "type": "integer",
          "minimum": 0,
          "description": "Conservative estimate: the critic calls that dimension would have cost, at this run's measured rate."
        },
        "by_reason": {
          "type": "object",
          "description": "Counts keyed by reason code (no-change, gap-too-small, oracle-unchanged, structural, other).",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "pace": {
      "type": [
        "object",
        "null"
      ],
      "description": "Wall-clock read derived from the timestamps the ledgers already carry. Wave spans include the lead agent's orchestration time between calls \u2014 steering figures, not billing figures.",
      "properties": {
        "waves_timed": {
          "type": "integer",
          "minimum": 0
        },
        "avg_wave_seconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "last_wave_seconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "active_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum of per-wave spans \u2014 time the run was actually doing something."
        },
        "elapsed_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "First record to last record overall, idle gaps included."
        },
        "waves_per_hour": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null until five minutes of active time exist \u2014 below that the rate is noise."
        },
        "projected_seconds_remaining": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Remaining waves (whichever budget binds first) times the average wave span."
        },
        "stage_seconds": {
          "type": [
            "object",
            "null"
          ],
          "description": "Build/judge/smooth split, present only when records carried --seconds. This is what says what to pipeline.",
          "properties": {
            "build": {
              "type": "integer"
            },
            "judge": {
              "type": "integer"
            },
            "smooth": {
              "type": "integer"
            },
            "other": {
              "type": "integer"
            }
          }
        },
        "judging": {
          "type": [
            "string",
            "null"
          ],
          "description": "Serial-vs-concurrent critic advice computed from the revert rate; null when the log is too thin or the rate is mid-range."
        }
      }
    },
    "aim": {
      "type": [
        "object",
        "null"
      ],
      "description": "Whether the run's rounds knew what they were aiming at. An aim states a hypothesis and an expected outcome before the build; the verdict then confirms or refutes it. The hit rate measures understanding \u2014 a dimension where aims keep missing needs a diagnosis, not more rounds.",
      "properties": {
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "misses": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "description": "Aims whose round has no verdict yet."
        },
        "hit_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "unbriefed_bar_rounds": {
          "type": "integer",
          "minimum": 0,
          "description": "Bar rounds from tier 1 up that ran without a stated aim \u2014 rounds that could not miss, and so could not teach."
        },
        "failed": {
          "type": "array",
          "description": "Approaches that missed \u2014 never retried without a new reason.",
          "items": {
            "type": "object",
            "properties": {
              "lane": {
                "type": "string"
              },
              "dimension": {
                "type": "string"
              },
              "approach": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "reverted",
                  "fell short"
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "cardList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/card"
      }
    },
    "card": {
      "type": "object",
      "description": "One lane/dimension pair as the board draws it.",
      "required": [
        "lane",
        "dimension"
      ],
      "properties": {
        "lane": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "bar_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "reverts": {
          "type": "integer",
          "minimum": 0
        },
        "bar_met_streak": {
          "type": "integer",
          "minimum": 0
        },
        "clean_streak": {
          "type": "integer",
          "minimum": 0
        },
        "bar_met_n": {
          "type": "integer",
          "minimum": 1
        },
        "clean_streak_n": {
          "type": "integer",
          "minimum": 1
        },
        "margins": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "decisive",
              "clear",
              "thin"
            ]
          }
        },
        "scores": {
          "type": "array",
          "description": "Bar-round scores in order, drawn as a sparkline on a fixed 0\u201310 scale.",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "severity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "major",
            "minor",
            "none",
            null
          ]
        },
        "gap": {
          "type": [
            "string",
            "null"
          ],
          "description": "The open gap from the latest verdict, or null when the last round was clean."
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "rubric_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "trend": {
          "type": [
            "string",
            "null"
          ]
        },
        "shelved_reason": {
          "type": "string"
        },
        "shelved_at_wave": {
          "type": "integer"
        },
        "retired_by": {
          "type": "string",
          "enum": [
            "bar-met",
            "clean-streak"
          ]
        },
        "aim": {
          "type": [
            "object",
            "null"
          ],
          "description": "This dimension's aim record: how many rounds stated an expectation and how many met it.",
          "properties": {
            "scored": {
              "type": "integer"
            },
            "hits": {
              "type": "integer"
            }
          }
        }
      }
    },
    "round": {
      "type": "object",
      "required": [
        "wave",
        "round",
        "lane",
        "dimension",
        "mode"
      ],
      "properties": {
        "ts": {
          "type": "string"
        },
        "wave": {
          "type": "integer"
        },
        "round": {
          "type": "integer"
        },
        "lane": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "blind",
            "rubric",
            "oracle",
            "champion"
          ]
        },
        "winner": {
          "type": "string",
          "enum": [
            "ours",
            "other"
          ]
        },
        "margin": {
          "type": "string",
          "enum": [
            "decisive",
            "clear",
            "thin"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "severity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "major",
            "minor",
            "none",
            null
          ]
        },
        "gap": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "promoted",
            "reverted",
            null
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "champion_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "critic_framing": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model that produced this verdict."
        },
        "escalated_from": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model whose verdict this round re-judged, when a thin verdict was escalated to a stronger critic."
        },
        "seconds": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Wall-clock seconds the calls behind this record took, when tracked."
        }
      }
    }
  }
}
