d(open('data/skills.json'))\nfor k in s['skills']:\n  if k['id'] in ('platform-architect','platform-desktop','platform-console','platform-mobile','platform-web','platform-services','input-system','input-devices-haptics','xr-runtime','gpu-platform-architect','rhi-core','rhi-d3d12','rhi-vulkan','rhi-metal','rhi-webgpu','certification-compliance','build-system-toolchains','packaging-release-patching','online-services-liveops'):\n    print(json.dumps(k,indent=0)); print('-----')\n\"","description":"Dump platform skill records"}},"apiBlockIndex":1,"requestId":"req_011CfY31EUb3VU2y96SKCv8Z","attributionAgent":"general-purpose","type":"assistant","uuid":"7e212d58-21b6-41fe-b510-b32986c932c4","timestamp":"2026-09-29T16:20:11.579Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"7e212d58-21b6-41fe-b510-b32986c932c4","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a0890b76854d165da","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017J6yjkKxntP7HWkgKtMMvx","type":"tool_result","content":"{\n\"id\": \"certification-compliance\",\n\"name\": \"Certification & Compliance\",\n\"tier\": \"expert\",\n\"parent\": \"test-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Tracks and pre-validates external requirements: platform certification (TRC/XR/Lotcheck class), age ratings, privacy law, accessibility law (CVAA, EAA), third-party licenses and SBOM, photosensitivity testing.\",\n\"non_responsibilities\": [\n[\n\"Implementing platform features\",\n\"platform-architect\"\n],\n[\n\"Implementing accessibility features\",\n\"accessibility\"\n]\n],\n\"provides\": [\n\"C-CERT\"\n],\n\"consumes\": [\n\"C-A11Y?\",\n\"C-SVC\"\n],\n\"expertise\": [\n\"platform requirements\",\n\"privacy law\",\n\"accessibility law\",\n\"license compliance\"\n],\n\"kind\": \"process\",\n\"targets\": [],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"quality\"\n}\n-----\n{\n\"id\": \"platform-architect\",\n\"name\": \"Platform Architect\",\n\"tier\": \"lead\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Platform abstraction layer and porting strategy: OS services, CPU/GPU capability discovery, windowing, process lifecycle, capability tiers, and evaluation of new targets (web, cloud streaming).\",\n\"non_responsibilities\": [\n[\n\"Graphics API backends\",\n\"rhi-core\"\n],\n[\n\"Store and online services\",\n\"platform-services\"\n],\n[\n\"Toolchains\",\n\"build-system-toolchains\"\n]\n],\n\"provides\": [\n\"C-PAL\",\n\"C-BASE\"\n],\n\"consumes\": [],\n\"expertise\": [\n\"OS internals (Windows, Linux, macOS)\",\n\"porting\",\n\"CPU topology\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"platform\"\n}\n-----\n{\n\"id\": \"platform-desktop\",\n\"name\": \"Desktop & Handheld PC Platforms\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Windows, Linux, SteamOS and macOS integration: display modes, HDR and VRR capability, DPI, OS-specific IO and scheduling behavior, handheld-PC specifics, server host OS.\",\n\"non_responsibilities\": [\n[\n\"HDR signal encoding\",\n\"post-color-hdr\"\n],\n[\n\"Swapchain\",\n\"rhi-core\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-PAL\"\n],\n\"expertise\": [\n\"Win32/GameInput\",\n\"Linux/Proton\",\n\"macOS\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"platform\",\n\"platforms\": [\n\"pc\"\n]\n}\n-----\n{\n\"id\": \"platform-console\",\n\"name\": \"Console Platforms\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Console-class integration from platform-holder documentation: OS and memory model (UMA), suspend/resume, multi-user model, devkit workflows, platform requirements feeding certification.\",\n\"non_responsibilities\": [\n[\n\"Certification tracking\",\n\"certification-compliance\"\n],\n[\n\"Console graphics API backend\",\n\"rhi-core\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-PAL\",\n\"C-SVC\",\n\"C-GPUTIER\"\n],\n\"expertise\": [\n\"console architectures\",\n\"platform requirements\",\n\"UMA memory\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [\n\"C-RHI\"\n],\n\"workstream\": \"platform\",\n\"platforms\": [\n\"pc\"\n]\n}\n-----\n{\n\"id\": \"platform-mobile\",\n\"name\": \"Mobile Platforms\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"iOS and Android (incl. Android-based standalone XR) integration: app lifecycle, thermal/power adaptivity, tile-based GPU implications, frame pacing, storage, notifications, deep links.\",\n\"non_responsibilities\": [\n[\n\"Render-graph TBDR optimizations\",\n\"render-graph-scheduling\"\n],\n[\n\"Touch input\",\n\"input-devices-haptics\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-PAL\"\n],\n\"expertise\": [\n\"Android/iOS\",\n\"mobile GPUs\",\n\"power management\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"platform\",\n\"platforms\": [\n\"mobile\",\n\"xr-standalone\"\n]\n}\n-----\n{\n\"id\": \"platform-services\",\n\"name\": \"Platform Services\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"First-party platform and store services: identity and sign-in, achievements and presence, entitlements and commerce through first-party stores, privileges and parental controls, social graph and invites, block/mute and text filtering, crossplay policy, leaderboards, cloud-save APIs, media capture, age and region policy enforcement.\",\n\"non_responsibilities\": [\n[\n\"Third-party/own backend & live-ops boundaries\",\n\"online-services-liveops\"\n],\n[\n\"Game-server hosting\",\n\"dedicated-server\"\n],\n[\n\"Save-game content\",\n\"persistence-save\"\n],\n[\n\"Backend implementation\",\n\"external:backend\"\n]\n],\n\"provides\": [\n\"C-SVC\"\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-TASK\",\n\"C-CFG\"\n],\n\"expertise\": [\n\"platform SDKs\",\n\"online service APIs\",\n\"auth tokens\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"platform\",\n\"untrusted_inputs\": [\n\"invites-deep-links\"\n]\n}\n-----\n{\n\"id\": \"input-system\",\n\"name\": \"Input Actions\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Action-level input: mapping and context stacks, rebinding, buffering and latency accounting, local-multiplayer assignment, accessibility input options, UI navigation routing, per-device glyphs, recording and replay.\",\n\"non_responsibilities\": [\n[\n\"Device drivers and haptics\",\n\"input-devices-haptics\"\n],\n[\n\"UI focus logic\",\n\"ui-architect\"\n]\n],\n\"provides\": [\n\"C-INPUT\"\n],\n\"consumes\": [\n\"C-DEVICE?\",\n\"C-FRAME\",\n\"C-SER\",\n\"C-A11Y\"\n],\n\"expertise\": [\n\"input systems\",\n\"latency measurement\",\n\"remapping UX\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"platform\"\n}\n-----\n{\n\"id\": \"input-devices-haptics\",\n\"name\": \"Input Devices & Haptics\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Device layer: keyboard/mouse raw input, gamepads, touch and gestures, motion sensors, pen, hotplug and user pairing, haptics (rumble, HD haptics, adaptive triggers).\",\n\"non_responsibilities\": [\n[\n\"Action mapping\",\n\"input-system\"\n],\n[\n\"XR controllers\",\n\"xr-runtime\"\n]\n],\n\"provides\": [\n\"C-DEVICE\"\n],\n\"consumes\": [\n\"C-PAL\"\n],\n\"expertise\": [\n\"HID\",\n\"GameInput/SDL-class APIs\",\n\"haptics\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"platform\"\n}\n-----\n{\n\"id\": \"xr-runtime\",\n\"name\": \"XR Runtime\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"xr\"\n],\n\"purpose\": \"XR integration: OpenXR, stereo/multiview rendering hooks, foveation, reprojection and latency, XR input and hand tracking, comfort and safety requirements.\",\n\"non_responsibilities\": [\n[\n\"Render pipeline\",\n\"render-architect\"\n],\n[\n\"Generic input actions\",\n\"input-system\"\n]\n],\n\"provides\": [\n\"C-XRVIEW\"\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-INPUT\",\n\"C-FRAME\",\n\"C-PRESENT\",\n\"C-VIEW\",\n\"C-DEVICE\",\n\"C-TEMPORAL?\",\n\"C-A11Y\"\n],\n\"expertise\": [\n\"OpenXR\",\n\"stereo rendering\",\n\"motion-to-photon latency\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"platform\"\n}\n-----\n{\n\"id\": \"rhi-core\",\n\"name\": \"RHI Core\",\n\"tier\": \"expert\",\n\"parent\": \"gpu-platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Render hardware interface over D3D12, Vulkan, Metal, console APIs and WebGPU: queues and command recording, synchronization, bindless descriptors, PSOs and PSO caching, presentation, capability tiers, GPU crash breadcrumbs, driver workarounds.\",\n\"non_responsibilities\": [\n[\n\"GPU memory allocation\",\n\"gpu-memory-resources\"\n],\n[\n\"Barrier planning\",\n\"render-graph-scheduling\"\n],\n[\n\"Shader compilation\",\n\"shader-system\"\n],\n[\n\"Per-API backend code\",\n[\n\"rhi-d3d12\",\n\"rhi-vulkan\",\n\"rhi-metal\",\n\"rhi-webgpu\",\n\"platform-console\"\n]\n]\n],\n\"provides\": [\n\"C-RHI\"\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-SYNC\",\n\"C-PRESENT\",\n\"C-FRAME\"\n],\n\"expertise\": [\n\"D3D12\",\n\"Vulkan\",\n\"Metal\",\n\"GPU synchronization\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"rendering\"\n}\n-----\n{\n\"id\": \"build-system-toolchains\",\n\"name\": \"Build System & Toolchains\",\n\"tier\": \"expert\",\n\"parent\": \"build-release-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Build graph, compiler and toolchain matrix, C++ modules/unity/PCH, compile caching and distribution, codegen integration, third-party dependencies, static analysis, build configurations.\",\n\"non_responsibilities\": [\n[\n\"CI orchestration\",\n\"ci-cd-automation\"\n],\n[\n\"Supply-chain policy\",\n\"security-engineering\"\n]\n],\n\"provides\": [\n\"C-BUILD\"\n],\n\"consumes\": [],\n\"expertise\": [\n\"CMake/FASTBuild/Bazel-class systems\",\n\"Clang/MSVC\",\n\"remote execution\"\n],\n\"kind\": \"tool\",\n\"targets\": [\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"release\"\n}\n-----\n{\n\"id\": \"packaging-release-patching\",\n\"name\": \"Packaging, Patching & Release\",\n\"tier\": \"expert\",\n\"parent\": \"build-release-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Platform packaging and signing, store-submission artifacts, delta/chunk patching, DLC, install-on-demand, client/server/content version compatibility, CDN boundary, release rollback.\",\n\"non_responsibilities\": [\n[\n\"Package runtime format\",\n\"package-formats-vfs\"\n],\n[\n\"Certification tracking\",\n\"certification-compliance\"\n]\n],\n\"provides\": [\n\"C-PKG\"\n],\n\"consumes\": [\n\"C-VFS\",\n\"C-BUILD\",\n\"C-SVC\",\n\"C-COOK\",\n\"C-RELEASE\"\n],\n\"expertise\": [\n\"platform packaging\",\n\"binary diffing\",\n\"content delivery\"\n],\n\"kind\": \"tool\",\n\"targets\": [\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"release\"\n}\n-----\n{\n\"id\": \"gpu-platform-architect\",\n\"name\": \"GPU Platform Architect\",\n\"tier\": \"lead\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"tools\"\n],\n\"workstream\": \"rendering\",\n\"purpose\": \"GPU platform architecture shared by every renderer tier: layering of RHI, GPU memory, render graph, shader system, ray-query and inference infrastructure; the GPU feature-tier model (binding, pipeline-state, queue, mesh, RT, tensor tiers) and API baselines per hardware tier; task-based parallel command recording.\",\n\"non_responsibilities\": [\n[\n\"Rendering pipeline and features\",\n\"render-architect\"\n],\n[\n\"Individual API backends\",\n[\n\"rhi-d3d12\",\n\"rhi-vulkan\",\n\"rhi-metal\",\n\"rhi-webgpu\"\n]\n],\n[\n\"Frames in flight / thread existence\",\n\"frame-orchestration\"\n]\n],\n\"consumes\": [\n\"C-RHI\",\n\"C-PAL\"\n],\n\"expertise\": [\n\"explicit graphics APIs\",\n\"GPU architecture across vendors\",\n\"API evolution tracking\"\n],\n\"tool_consumes\": [],\n\"provides\": [\n\"C-GPUTIER\"\n],\n\"implements\": []\n}\n-----\n{\n\"id\": \"rhi-d3d12\",\n\"name\": \"RHI D3D12 backend\",\n\"tier\": \"expert\",\n\"parent\": \"gpu-platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"tools\"\n],\n\"platforms\": [\n\"pc\"\n],\n\"workstream\": \"rendering\",\n\"purpose\": \"Implements C-RHI on D3D12 (Agility SDK features: enhanced barriers, work graphs, SM 6.x, GPU upload heaps); owns its validation-layer runs and vendor/driver quirks.\",\n\"non_responsibilities\": [\n[\n\"RHI abstraction & capability model\",\n\"rhi-core\"\n],\n[\n\"Other API backends\",\n\"rhi-core\"\n]\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-SYNC\",\n\"C-GPUTIER\"\n],\n\"implements\": [\n\"C-RHI\"\n],\n\"expertise\": [\n\"D3D12\",\n\"Agility SDK\",\n\"DXGI\"\n],\n\"tool_consumes\": [],\n\"provides\": []\n}\n-----\n{\n\"id\": \"rhi-vulkan\",\n\"name\": \"RHI Vulkan backend\",\n\"tier\": \"expert\",\n\"parent\": \"gpu-platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"tools\"\n],\n\"platforms\": [\n\"pc\",\n\"mobile\",\n\"xr-standalone\"\n],\n\"workstream\": \"rendering\",\n\"purpose\": \"Implements C-RHI on Vulkan (profiles incl. Android Baseline, descriptor buffers/heaps, synchronization2, dynamic rendering); owns its validation-layer runs and vendor/driver quirks.\",\n\"non_responsibilities\": [\n[\n\"RHI abstraction & capability model\",\n\"rhi-core\"\n],\n[\n\"Other API backends\",\n\"rhi-core\"\n]\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-SYNC\",\n\"C-GPUTIER\"\n],\n\"implements\": [\n\"C-RHI\"\n],\n\"expertise\"