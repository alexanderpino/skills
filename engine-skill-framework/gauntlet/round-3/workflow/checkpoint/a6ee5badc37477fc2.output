{"parentUuid":"a1aed41d-7eda-4e56-a507-bb7499759282","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a6ee5badc37477fc2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CPHNC55fnPJvHoGAJRkvs6","type":"tool_result","content":"{\n\"id\": \"program-orchestration\",\n\"name\": \"Engine Program Orchestration\",\n\"tier\": \"orchestrator\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Turns architecture into coordinated multi-agent work: decomposes milestones into tasks by skill territory, keeps the ownership ledger and territory locks, sequences integration through vertical slices, routes contract change requests, and schedules critic gates.\",\n\"non_responsibilities\": [\n[\n\"Deciding architecture\",\n\"engine-architect\"\n],\n[\n\"CI mechanics\",\n\"ci-cd-automation\"\n],\n[\n\"Release versioning\",\n\"build-release-architect\"\n]\n],\n\"provides\": [\n\"C-ORCH\"\n],\n\"consumes\": [\n\"C-PROD\"\n],\n\"expertise\": [\n\"multi-agent coordination\",\n\"work breakdown\",\n\"integration planning\",\n\"critical-path analysis\"\n],\n\"kind\": \"process\",\n\"targets\": [],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"governance\"\n}\n-----\n{\n\"id\": \"robustness-fuzzing\",\n\"name\": \"Robustness & Fuzzing\",\n\"tier\": \"expert\",\n\"parent\": \"test-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Robustness engineering: fuzzing every untrusted-input parser (assets, packets, saves, scripts, mods), sanitizer build policy, fault injection (IO errors, OOM, device lost), concurrency stress and schedule perturbation.\",\n\"non_responsibilities\": [\n[\n\"Threat model\",\n\"security-engineering\"\n],\n[\n\"Fixing parsers\",\n\"serialization-schema\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-SER\",\n\"C-IO\"\n],\n\"expertise\": [\n\"libFuzzer/AFL++\",\n\"sanitizers\",\n\"fault injection\",\n\"TSan\"\n],\n\"kind\": \"process\",\n\"targets\": [],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"quality\",\n\"fuzz_targets\": [\n\"assets\",\n\"packets\",\n\"saves\",\n\"scripts\",\n\"mods\",\n\"replays\",\n\"remote-config\",\n\"chat-text\",\n\"fonts\",\n\"media-decoders\",\n\"decompressors\",\n\"cloud-saves\",\n\"invites-deep-links\",\n\"ugc-graphs\",\n\"generated-content\",\n\"editor-plugins\",\n\"imported-dcc-files\"\n]\n}\n-----\n{\n\"id\": \"certification-compliance\",\n\"name\": \"Certification & Compliance\",\n\"tier\": \"expert\",\n\"parent\": \"test-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Tracks and pre-validates external requirements: platform certification (TRC/XR/Lotcheck class), age ratings, privacy law, accessibility law (CVAA, EAA), third-party licenses and SBOM, photosensitivity testing.\",\n\"non_responsibilities\": [\n[\n\"Implementing platform features\",\n\"platform-architect\"\n],\n[\n\"Implementing accessibility features\",\n\"accessibility\"\n]\n],\n\"provides\": [\n\"C-CERT\"\n],\n\"consumes\": [\n\"C-A11Y?\",\n\"C-SVC\"\n],\n\"expertise\": [\n\"platform requirements\",\n\"privacy law\",\n\"accessibility law\",\n\"license compliance\"\n],\n\"kind\": \"process\",\n\"targets\": [],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"quality\"\n}\n-----\n{\n\"id\": \"security-engineering\",\n\"name\": \"Security Engineering\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Threat modeling and trust boundaries for every untrusted input, secure-coding and memory-safety policy, supply-chain security, secrets, anti-tamper boundary, privacy engineering, mod/UGC sandbox policy.\",\n\"non_responsibilities\": [\n[\n\"Cheat detection\",\n\"anti-cheat-integrity\"\n],\n[\n\"Fuzzing campaigns\",\n\"robustness-fuzzing\"\n],\n[\n\"Transport encryption implementation\",\n\"network-transport\"\n]\n],\n\"provides\": [\n\"C-TRUST\"\n],\n\"consumes\": [],\n\"expertise\": [\n\"threat modeling (STRIDE)\",\n\"memory safety\",\n\"SLSA/SBOM\",\n\"privacy engineering\"\n],\n\"kind\": \"process\",\n\"targets\": [],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"quality\"\n}\n-----\n{\n\"id\": \"anti-cheat-integrity\",\n\"name\": \"Anti-Cheat & Game Integrity\",\n\"tier\": \"expert\",\n\"parent\": \"security-engineering\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Cheat resistance for online games: server-authoritative validation patterns (movement, hits, economy), rate limiting, anomaly signals, integration boundary for client anti-cheat middleware.\",\n\"non_responsibilities\": [\n[\n\"Replication design\",\n\"replication\"\n],\n[\n\"Transport encryption\",\n\"network-transport\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-NET?\",\n\"C-PREDICT?\",\n\"C-PHYS?\",\n\"C-GAME?\",\n\"C-SVC?\",\n\"C-LIVE?\"\n],\n\"expertise\": [\n\"cheat taxonomies\",\n\"server validation\",\n\"anomaly detection\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"online\"\n}\n-----\n{\n\"id\": \"observability-telemetry\",\n\"name\": \"Observability & Telemetry\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Instrumentation substrate: structured logging, trace zones (CPU, GPU, IO, memory), counters and metrics, profiler integrations, in-game stats, development and live telemetry with privacy consent; zero cost when compiled out.\",\n\"non_responsibilities\": [\n[\n\"Crash capture\",\n\"crash-diagnostics\"\n],\n[\n\"Debug drawing and consoles\",\n\"visual-debugging-tools\"\n],\n[\n\"Perf budgets\",\n\"performance-architect\"\n]\n],\n\"provides\": [\n\"C-INSTR\"\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-BASE\",\n\"C-SYNC\"\n],\n\"expertise\": [\n\"low-overhead tracing\",\n\"Tracy/Perfetto formats\",\n\"telemetry pipelines\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"foundation\"\n}\n-----\n{\n\"id\": \"crash-diagnostics\",\n\"name\": \"Crash & Hang Diagnostics\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Crash, hang and GPU-fault capture and reporting: minidumps, symbolication, bucketing and triage, GPU crash dumps, watchdogs, OOM reports, assert reporting.\",\n\"non_responsibilities\": [\n[\n\"Emitting GPU breadcrumbs\",\n\"rhi-core\"\n],\n[\n\"Symbol server infrastructure\",\n\"ci-cd-automation\"\n]\n],\n\"provides\": [\n\"C-CRASH\"\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-BASE\",\n\"C-INSTR\"\n],\n\"expertise\": [\n\"minidumps\",\n\"DRED/Aftermath/RGD\",\n\"crash bucketing\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"foundation\"\n}\n-----\n{\n\"id\": \"plugin-system\",\n\"name\": \"Plugin System\",\n\"tier\": \"expert\",\n\"parent\": \"api-lifecycle-migration\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Plugin architecture: manifests, discovery, dependency resolution, load phases, binary vs source plugins, isolation, distribution format.\",\n\"non_responsibilities\": [\n[\n\"Mods & UGC\",\n\"modding-ugc\"\n],\n[\n\"Module linking internals\",\n\"core-runtime-architect\"\n]\n],\n\"provides\": [\n\"C-PLUGIN\"\n],\n\"consumes\": [\n\"C-MOD\",\n\"C-BASE\",\n\"C-API\"\n],\n\"expertise\": [\n\"plugin architectures\",\n\"dynamic loading\",\n\"ABI stability\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"foundation\",\n\"untrusted_inputs\": [\n\"editor-plugins\"\n]\n}\n-----\n{\n\"id\": \"modding-ugc\",\n\"name\": \"Modding & UGC\",\n\"tier\": \"expert\",\n\"parent\": \"api-lifecycle-migration\",\n\"profiles\": [\n\"ugc\"\n],\n\"purpose\": \"Mod and UGC support: mod SDK, content overrides via VFS layering, sandboxed mod scripting, UGC upload and moderation boundaries, mod compatibility across patches.\",\n\"non_responsibilities\": [\n[\n\"Sandbox policy\",\n\"security-engineering\"\n],\n[\n\"Script VM\",\n\"scripting-runtime\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-VFS\",\n\"C-SCRIPT\",\n\"C-PLUGIN\",\n\"C-SVC\"\n],\n\"expertise\": [\n\"mod ecosystems\",\n\"sandboxing\",\n\"content overrides\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"gameplay\",\n\"untrusted_inputs\": [\n\"mods\",\n\"ugc-graphs\"\n]\n}\n-----\n{\n\"id\": \"ml-inference-runtime\",\n\"name\": \"ML Inference Runtime\",\n\"tier\": \"expert\",\n\"parent\": \"gpu-platform-architect\",\n\"profiles\": [\n\"lite3d\",\n\"std3d\"\n],\n\"purpose\": \"Runtime neural-network inference shared by neural rendering, animation, audio and AI: GPU (cooperative-vector / tensor) and CPU backends, model packaging and quantization, scheduling within frame budgets, determinism characteristics.\",\n\"non_responsibilities\": [\n[\n\"Vendor upscalers\",\n\"reconstruction-upscaling\"\n],\n[\n\"In-shader (fused) networks\",\n\"shader-system\"\n],\n[\n\"Neural feature design\",\n\"owning-skill\"\n],\n[\n\"Model training\",\n\"external:ml-training\"\n]\n],\n\"provides\": [\n\"C-ML\",\n\"C-MLGPU\"\n],\n\"consumes\": [\n\"C-TASK\",\n\"C-RHI?@C-MLGPU\",\n\"C-RG?@C-MLGPU\",\n\"C-PAL\"\n],\n\"expertise\": [\n\"inference engines\",\n\"quantization\",\n\"cooperative vectors\",\n\"ONNX\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"rendering\"\n}\n-----\n{\n\"id\": \"platform-services\",\n\"name\": \"Platform Services\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"First-party platform and store services: identity and sign-in, achievements and presence, entitlements and commerce through first-party stores, privileges and parental controls, social graph and invites, block/mute and text filtering, crossplay policy, leaderboards, cloud-save APIs, media capture, age and region policy enforcement.\",\n\"non_responsibilities\": [\n[\n\"Third-party/own backend & live-ops boundaries\",\n\"online-services-liveops\"\n],\n[\n\"Game-server hosting\",\n\"dedicated-server\"\n],\n[\n\"Save-game content\",\n\"persistence-save\"\n],\n[\n\"Backend implementation\",\n\"external:backend\"\n]\n],\n\"provides\": [\n\"C-SVC\"\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-TASK\",\n\"C-CFG\"\n],\n\"expertise\": [\n\"platform SDKs\",\n\"online service APIs\",\n\"auth tokens\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"platform\",\n\"untrusted_inputs\": [\n\"invites-deep-links\"\n]\n}\n-----\n{\n\"id\": \"dedicated-server\",\n\"name\": \"Dedicated Servers\",\n\"tier\": \"expert\",\n\"parent\": \"network-architect\",\n\"profiles\": [\n\"online\"\n],\n\"purpose\": \"Headless server builds and stripping, tick cost and multi-instance density, fleet orchestration boundary, server observability, listen servers and host migration.\",\n\"non_responsibilities\": [\n[\n\"Fleet operation (outside engine scope)\",\n\"platform-services\"\n],\n[\n\"Server logging substrate\",\n\"observability-telemetry\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-NET\",\n\"C-NETLINK\",\n\"C-FRAME\",\n\"C-SVC?\",\n\"C-LIVE\",\n\"C-WORLD?\"\n],\n\"expertise\": [\n\"headless builds\",\n\"Linux containers\",\n\"server performance\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"online\"\n}\n-----\n{\n\"id\": \"scripting-runtime\",\n\"name\": \"S