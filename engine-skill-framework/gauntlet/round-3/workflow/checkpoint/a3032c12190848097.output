d compatibility across patches.\", \"non_responsibilities\": [[\"Sandbox policy\", \"security-engineering\"], [\"Script VM\", \"scripting-runtime\"]], \"provides\": [], \"consumes\": [\"C-VFS\", \"C-SCRIPT\", \"C-PLUGIN\", \"C-SVC\"], \"expertise\": [\"mod ecosystems\", \"sandboxing\", \"content overrides\"]}\n\n{\"id\": \"asset-import-interchange\", \"name\": \"Asset Import & Interchange\", \"tier\": \"expert\", \"parent\": \"content-pipeline-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Importers and interchange: glTF, FBX, OpenUSD, texture and audio source formats, MaterialX/OpenPBR, DCC live link, reimport and source tracking, scan data.\", \"non_responsibilities\": [[\"Cooking\", \"content-pipeline-architect\"], [\"Material model\", \"material-system\"]], \"provides\": [], \"consumes\": [\"C-ASSET\", \"C-COOK\"], \"expertise\": [\"glTF\", \"FBX SDK\", \"OpenUSD\", \"MaterialX\"]}\n\n{\"id\": \"atmosphere-weather\", \"name\": \"Atmosphere, Volumetrics & Weather\", \"tier\": \"expert\", \"parent\": \"world-architect\", \"profiles\": [\"mobile3d\", \"std3d\"], \"runtime\": true, \"purpose\": \"Sky and atmospheric scattering, volumetric clouds, volumetric fog and local media, weather state and surface response, time of day.\", \"non_responsibilities\": [[\"Sky lighting capture for GI\", \"global-illumination\"], [\"Translucency compositing\", \"translucency-decals\"]], \"provides\": [], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-FRAME\"], \"expertise\": [\"atmospheric scattering\", \"volumetric rendering\", \"weather systems\"]}\n\n{\"id\": \"character-rendering\", \"name\": \"Character Rendering\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"aaa\"], \"runtime\": true, \"purpose\": \"Skin subsurface scattering, eyes, strand-based hair and fur rendering, digital-human LOD.\", \"non_responsibilities\": [[\"Hair simulation\", \"cloth-deformables\"], [\"Skinning\", \"deformation-skinning\"]], \"provides\": [], \"c