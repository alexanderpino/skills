{"parentUuid":"dec03d56-76b7-4d05-9980-b3e056cc484b","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a3032c12190848097","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012rDkwaU4RVVwkZNUzCou2K","type":"tool_result","content":"{\"id\": \"architecture-governance\", \"name\": \"Architecture Governance\", \"tier\": \"orchestrator\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Runs architecture as an evidence-backed, governed process: ADR lifecycle with revisit conditions, technology radar with maturity tiers and promotion criteria, automated fitness functions (layering, dependency direction, contract conformance), anti-legacy review, coding standard.\", \"non_responsibilities\": [[\"Making the architecture decisions themselves\", \"engine-architect\"], [\"Grading sources and running spikes\", \"research-evidence\"], [\"Test definition of done\", \"test-architect\"]], \"provides\": [\"C-ADR\"], \"consumes\": [], \"expertise\": [\"ADRs\", \"fitness functions\", \"static dependency analysis\", \"technology radar\"]}\n\n{\"id\": \"program-orchestration\", \"name\": \"Engine Program Orchestration\", \"tier\": \"orchestrator\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Turns architecture into coordinated multi-agent work: decomposes milestones into tasks by skill territory, keeps the ownership ledger and territory locks, sequences integration through vertical slices, routes contract change requests, and schedules critic gates.\", \"non_responsibilities\": [[\"Deciding architecture\", \"engine-architect\"], [\"CI mechanics\", \"ci-cd-automation\"], [\"Release versioning\", \"build-release-architect\"]], \"provides\": [\"C-ORCH\"], \"consumes\": [], \"expertise\": [\"multi-agent coordination\", \"work breakdown\", \"integration planning\", \"critical-path analysis\"]}\n\n{\"id\": \"research-evidence\", \"name\": \"Research & Evidence\", \"tier\": \"cross-cutting\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Research discipline for every major decision: finds and grades authoritative evidence (production talks, platform docs, peer-reviewed work, reproducible benchmarks), classifies techniques as established / emerging / experimental / speculative, and runs spikes where literature is thin.\", \"non_responsibilities\": [[\"Making the decision (the owning skill does, via an ADR)\", \"architecture-governance\"], [\"Benchmark infrastructure\", \"perf-benchmarking\"]], \"provides\": [\"C-EVID\"], \"consumes\": [], \"expertise\": [\"literature review\", \"SIGGRAPH/GDC/HPG corpus\", \"source provenance\", \"experimental design\"]}\n\n{\"id\": \"test-architect\", \"name\": \"Test Architect\", \"tier\": \"cross-cutting\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Test strategy and architecture: per-subsystem test pyramid, frameworks, the test definition of done every skill must meet, contract tests, test content, coverage and mutation policy, flakiness policy.\", \"non_responsibilities\": [[\"Running pipelines\", \"ci-cd-automation\"], [\"Performance regression\", \"perf-benchmarking\"], [\"Rendering image validation\", \"render-validation\"]], \"provides\": [\"C-TEST\"], \"consumes\": [], \"expertise\": [\"test strategy\", \"contract testing\", \"mutation testing\", \"test determinism\"]}\n\n{\"id\": \"functional-automation-soak\", \"name\": \"Functional Automation & Soak\", \"tier\": \"expert\", \"parent\": \"test-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Game-level automation: scripted and bot playthroughs, smoke/boot tests, soak and stability runs (memory growth, leaks), hardware/OS compatibility matrix, network harnesses and server load tests.\", \"non_responsibilities\": [[\"Unit test frameworks\", \"test-architect\"], [\"Device-farm infrastructure\", \"ci-cd-automation\"]], \"provides\": [], \"consumes\": [\"C-GAME?\", \"C-INPUT?\", \"C-NET?\"], \"expertise\": [\"game automation\", \"bots\", \"long-run stability analysis\"]}\n\n{\"id\": \"robustness-fuzzing\", \"name\": \"Robustness & Fuzzing\", \"tier\": \"expert\", \"parent\": \"test-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Robustness engineering: fuzzing every untrusted-input parser (assets, packets, saves, scripts, mods), sanitizer build policy, fault injection (IO errors, OOM, device lost), concurrency stress and schedule perturbation.\", \"non_responsibilities\": [[\"Threat model\", \"security-engineering\"], [\"Fixing parsers\", \"serialization-schema\"]], \"provides\": [], \"consumes\": [\"C-SER\", \"C-IO\"], \"expertise\": [\"libFuzzer/AFL++\", \"sanitizers\", \"fault injection\", \"TSan\"]}\n\n{\"id\": \"security-engineering\", \"name\": \"Security Engineering\", \"tier\": \"cross-cutting\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Threat modeling and trust boundaries for every untrusted input, secure-coding and memory-safety policy, supply-chain security, secrets, anti-tamper boundary, privacy engineering, mod/UGC sandbox policy.\", \"non_responsibilities\": [[\"Cheat detection\", \"anti-cheat-integrity\"], [\"Fuzzing campaigns\", \"robustness-fuzzing\"], [\"Transport encryption implementation\", \"network-transport\"]], \"provides\": [\"C-TRUST\"], \"consumes\": [], \"expertise\": [\"threat modeling (STRIDE)\", \"memory safety\", \"SLSA/SBOM\", \"privacy engineering\"]}\n\n{\"id\": \"developer-experience-docs\", \"name\": \"Developer Experience & Documentation\", \"tier\": \"cross-cutting\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Documentation and developer experience: API reference, architecture docs, the sample-project ladder (2D \\u2192 open-world online) that doubles as integration tests, templates, onboarding, doc testing, error-message standards, DX metrics.\", \"non_responsibilities\": [[\"ADR records\", \"architecture-governance\"], [\"Iteration-time tooling\", \"hot-reload-iteration\"]], \"provides\": [], \"consumes\": [], \"expertise\": [\"technical writing\", \"docs-as-code\", \"sample design\", \"DX metrics\"]}\n\n{\"id\": \"ml-inference-runtime\", \"name\": \"ML Inference Runtime\", \"tier\": \"expert\", \"parent\": \"engine-architect\", \"profiles\": [\"aaa\"], \"runtime\": true, \"purpose\": \"Runtime neural-network inference shared by neural rendering, animation, audio and AI: GPU (cooperative-vector / tensor) and CPU backends, model packaging and quantization, scheduling within frame budgets, determinism characteristics.\", \"non_responsibilities\": [[\"Vendor upscalers\", \"reconstruction-upscaling\"], [\"Neural feature design (texture, material, animation)\", \"texture-streaming-vt\"]], \"provides\": [\"C-ML\"], \"consumes\": [\"C-RHI\", \"C-RG\", \"C-TASK\"], \"expertise\": [\"inference engines\", \"quantization\", \"cooperative vectors\", \"ONNX\"]}\n\n{\"id\": \"core-runtime-architect\", \"name\": \"Core Runtime Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Core runtime architecture: layering within core, module system and engine lifecycle (parallel boot, init graph, shutdown), configuration and cvars, error-handling and failure model, language and compiler feature policy.\", \"non_responsibilities\": [[\"Allocator design\", \"memory-allocators\"], [\"Scheduler\", \"job-system-task-graph\"], [\"Frame loop\", \"frame-orchestration\"]], \"provides\": [\"C-MOD\", \"C-CFG\", \"C-ERR\"], \"consumes\": [\"C-PAL\"], \"expertise\": [\"C++20/23\", \"module systems\", \"error models\", \"configuration systems\"]}\n\n{\"id\": \"memory-allocators\", \"name\": \"Memory & Allocators\", \"tier\": \"expert\", \"parent\": \"core-runtime-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Memory management: virtual memory, allocator families, thread-local and NUMA-aware allocation, tagging and attribution, budget enforcement mechanisms, fragmentation control, memory debugging, OOM policy, UMA accounting.\", \"non_responsibilities\": [[\"GPU heaps\", \"gpu-memory-resources\"], [\"Budget numbers\", \"performance-architect\"]], \"provides\": [\"C-MEM\"], \"consumes\": [\"C-PAL\"], \"expertise\": [\"allocator design\", \"virtual memory\", \"TLSF\", \"memory profiling\"]}\n\n{\"id\": \"reflection-metadata\", \"name\": \"Reflection & Metadata\", \"tier\": \"expert\", \"parent\": \"core-runtime-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Type registry, reflection generation (codegen now, C++26 static reflection when toolchains allow), attributes, the property system, script-binding substrate, dynamic invocation.\", \"non_responsibilities\": [[\"Serialization formats\", \"serialization-schema\"], [\"Editor widgets\", \"editor-ui-framework\"], [\"Script VM\", \"scripting-runtime\"]], \"provides\": [\"C-REFL\"], \"consumes\": [\"C-TYPES\"], \"expertise\": [\"metaprogramming\", \"code generation\", \"C++26 reflection\"]}\n\n{\"id\": \"platform-architect\", \"name\": \"Platform Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Platform abstraction layer and porting strategy: OS services, CPU/GPU capability discovery, windowing, process lifecycle, capability tiers, and evaluation of new targets (web, cloud streaming).\", \"non_responsibilities\": [[\"Graphics API backends\", \"rhi-core\"], [\"Store and online services\", \"platform-online-services\"], [\"Toolchains\", \"build-system-toolchains\"]], \"provides\": [\"C-PAL\"], \"consumes\": [], \"expertise\": [\"OS internals (Windows, Linux, macOS)\", \"porting\", \"CPU topology\"]}\n\n{\"id\": \"platform-online-services\", \"name\": \"Platform & Online Services\", \"tier\": \"expert\", \"parent\": \"platform-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Abstraction over first-party platform services and third-party online backends: identity and sign-in, achievements and presence, entitlements and store, cloud saves, matchmaking/lobby/session boundaries, remote config, moderation boundaries, media capture, crossplay identity.\", \"non_responsibilities\": [[\"Game-server hosting\", \"dedicated-server\"], [\"Save-game content\", \"persistence-save\"], [\"Backend implementation (outside engine scope)\", \"engine-architect\"]], \"provides\": [\"C-SVC\"], \"consumes\": [\"C-PAL\", \"C-TASK\"], \"expertise\": [\"platform SDKs\", \"online service APIs\", \"auth tokens\"]}\n\n{\"id\": \"input-devices-haptics\", \"name\": \"Input Devices & Haptics\", \"tier\": \"expert\", \"parent\": \"platform-architect\", \"profiles\": [\"client\"], \"runtime\": true, \"purpose\": \"Device layer: keyboard/mouse raw input, gamepads, touch and gestures, motion sensors, pen, hotplug and user pairing, haptics (rumble, HD haptics, adaptive triggers).\", \"non_responsibilities\": [[\"Action mapping\", \"input-system\"], [\"XR controllers\", \"xr-runtime\"]], \"provides\": [], \"consumes\": [\"C-PAL\", \"C-INPUT\"], \"expertise\": [\"HID\", \"GameInput/SDL-class APIs\", \"haptics\"]}\n\n{\"id\": \"xr-runtime\", \"name\": \"XR Runtime\", \"tier\": \"expert\", \"parent\": \"platform-architect\", \"profiles\": [\"xr\"], \"runtime\": true, \"purpose\": \"XR integration: OpenXR, stereo/multiview rendering hooks, foveation, reprojection and latency, XR input and hand tracking, comfort and safety requirements.\", \"non_responsibilities\": [[\"Render pipeline\", \"render-architect\"], [\"Generic input actions\", \"input-system\"]], \"provides\": [], \"consumes\": [\"C-PAL\", \"C-RSCENE\", \"C-INPUT\", \"C-FRAME\"], \"expertise\": [\"OpenXR\", \"stereo rendering\", \"motion-to-photon latency\"]}\n\n{\"id\": \"async-io-storage\", \"name\": \"Async IO & Storage\", \"tier\": \"