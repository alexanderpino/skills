{"parentUuid":"7ab833fc-81a7-4a73-b2ec-1d3d480a46b7","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a2668729790befa2f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YMSuz31MhLhJbfhXT4yRN6","type":"tool_result","content":"{\n\"_doc\": \"Critic framework. scope selectors: 'all', 'tier:<tier>', 'subtree:<skill-id>' (the skill and all descendants), or a bare skill id. Stages: G1 = framework gauntlet (this phase; every critic reviews the whole framework), G2 = SKILL.md gauntlet (per-skill, scoped), S1 = ADR review, S2 = design/contract review, S3 = implementation review, S4 = validation & release review.\",\n\"stages\": {\n\"G1\": \"Framework gauntlet: capability map, skill graph, contracts, hierarchy (whole framework)\",\n\"G2\": \"SKILL.md gauntlet: per-skill description quality, technique currency, validation criteria\",\n\"S1\": \"ADR review: evidence, alternatives, revisit conditions\",\n\"S2\": \"Design & contract review: API/contract drafts, data layouts, threading model\",\n\"S3\": \"Implementation review: code, tests, instrumentation\",\n\"S4\": \"Validation & release review: benchmarks, scalability runs, certification readiness\"\n},\n\"critics\": [\n{\n\"id\": \"K-ARCH\",\n\"name\": \"Engine Architecture Critic\",\n\"mandate\": \"Architectural completeness and subsystem boundaries: ownership overlaps, missing contracts, wrong layering, contracts that leak internals, hierarchy that does not match coupling.\",\n\"checks\": [\n\"every capability has exactly one owner and the owner is the right expertise\",\n\"non-responsibilities point to the real owner\",\n\"contracts are minimal, stable and layered\",\n\"no hidden cyclic build dependencies\",\n\"leads have real territory, not just coordination\"\n],\n\"scope\": [\n\"all\",\n\"tier:orchestrator\",\n\"research-evidence\",\n\"subtree:api-lifecycle-migration\",\n\"subtree:world-architect\",\n\"developer-experience-docs\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\"\n]\n},\n{\n\"id\": \"K-RENDER\",\n\"name\": \"Rendering Critic\",\n\"mandate\": \"Graphics architecture and currency of rendering techniques; GPU-driven, bindless, explicit-API assumptions; scalability from 2D mobile to path tracing.\",\n\"checks\": [\n\"no draw-call-centric or DX11-era assumptions\",\n\"render graph owns sync and aliasing\",\n\"technique maturity labels are honest\",\n\"scale-down path exists for each feature\"\n],\n\"scope\": [\n\"subtree:render-architect\",\n\"render-validation\",\n\"gpu-performance\",\n\"terrain\",\n\"vegetation-foliage\",\n\"water-ocean\",\n\"atmosphere-weather\",\n\"deformation-skinning\",\n\"xr-runtime\",\n\"ml-inference-runtime\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\",\n\"S3\",\n\"S4\"\n]\n},\n{\n\"id\": \"K-SYSTEMS\",\n\"name\": \"Systems Critic\",\n\"mandate\": \"Concurrency, memory, scheduling, IO and low-level architecture.\",\n\"checks\": [\n\"no single-thread-first assumptions\",\n\"explicit ownership and lifetimes\",\n\"synchronization minimized and justified\",\n\"async IO end to end\",\n\"heterogeneous cores and NUMA considered\"\n],\n\"scope\": [\n\"subtree:core-runtime-architect\",\n\"subtree:resource-streaming-architect\",\n\"observability-telemetry\",\n\"crash-diagnostics\",\n\"determinism-replay\",\n\"hot-reload-iteration\",\n\"rhi-core\",\n\"gpu-memory-resources\",\n\"render-graph-scheduling\",\n\"audio-architect\",\n\"network-transport\",\n\"ml-inference-runtime\",\n\"subtree:world-architect\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\",\n\"S3\"\n]\n},\n{\n\"id\": \"K-SIM\",\n\"name\": \"Physics & Simulation Critic\",\n\"mandate\": \"Simulation domains: physics, destruction, fluids, cloth, crowds, large-scale simulation, determinism of simulation.\",\n\"checks\": [\n\"stepping and sync with frame phases are explicit\",\n\"determinism levels are declared\",\n\"simulation LOD exists for large scales\",\n\"build-vs-integrate evidence\"\n],\n\"scope\": [\n\"subtree:physics-architect\",\n\"crowd-simulation\",\n\"ik-procedural-animation\",\n\"prediction-rollback\",\n\"determinism-replay\",\n\"procedural-generation\",\n\"water-ocean\",\n\"vfx-particles\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\",\n\"S3\",\n\"S4\"\n]\n},\n{\n\"id\": \"K-NET\",\n\"name\": \"Networking Critic\",\n\"mandate\": \"Online and multiplayer architecture: models, replication, prediction, servers, security, online-service boundaries.\",\n\"checks\": [\n\"netcode model matches game type\",\n\"authority and trust explicit\",\n\"bandwidth and scale budgets\",\n\"version compatibility\",\n\"service boundaries clear\"\n],\n\"scope\": [\n\"subtree:network-architect\",\n\"anti-cheat-integrity\",\n\"platform-online-services\",\n\"destruction-fracture\",\n\"persistence-save\",\n\"packaging-release-patching\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\",\n\"S3\",\n\"S4\"\n]\n},\n{\n\"id\": \"K-TOOLS\",\n\"name\": \"Tools & Editor Critic\",\n\"mandate\": \"Production tooling and content workflows: editor, pipeline, collaboration, iteration speed.\",\n\"checks\": [\n\"tooling as thorough as runtime\",\n\"undo/transactions universal\",\n\"large teams can collaborate without lock contention\",\n\"iteration time measured\",\n\"pipeline deterministic and cached\"\n],\n\"scope\": [\n\"subtree:editor-architect\",\n\"subtree:content-pipeline-architect\",\n\"hot-reload-iteration\",\n\"developer-experience-docs\",\n\"ui-architect\",\n\"terrain\",\n\"procedural-generation\",\n\"cinematics-sequencer\",\n\"scripting-runtime\",\n\"world-data-model\",\n\"subtree:build-release-architect\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\",\n\"S3\",\n\"S4\"\n]\n},\n{\n\"id\": \"K-PLATFORM\",\n\"name\": \"Platform Critic\",\n\"mandate\": \"Hardware, operating systems, consoles, graphics APIs, packaging and platform requirements.\",\n\"checks\": [\n\"PAL is the only platform-specific layer\",\n\"console, mobile and web constraints represented\",\n\"certification requirements traced\",\n\"packaging and patching per platform\"\n],\n\"scope\": [\n\"subtree:platform-architect\",\n\"rhi-core\",\n\"subtree:build-release-architect\",\n\"certification-compliance\",\n\"async-io-storage\",\n\"crash-diagnostics\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\",\n\"S4\"\n]\n},\n{\n\"id\": \"K-PERF\",\n\"name\": \"Performance Critic\",\n\"mandate\": \"Scalability bottlenecks: serialization points, excess synchronization, cache inefficiency, GPU stalls, bandwidth, poor asymptotics.\",\n\"checks\": [\n\"budgets exist for each subsystem\",\n\"benchmarks include realistic workloads\",\n\"no hidden global sync points\",\n\"asymptotics stated for world-scale data\"\n],\n\"scope\": [\n\"all\",\n\"subtree:performance-architect\",\n\"subtree:world-architect\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S2\",\n\"S3\",\n\"S4\"\n]\n},\n{\n\"id\": \"K-PROD\",\n\"name\": \"Production Critic\",\n\"mandate\": \"Could a real team ship games with this: workflows, content scale, team scale, schedules, live operations.\",\n\"checks\": [\n\"content creators are first-class\",\n\"features have an owner through ship\",\n\"live-ops and patching covered\",\n\"scale-down keeps small teams productive\"\n],\n\"scope\": [\n\"all\",\n\"tier:orchestrator\",\n\"developer-experience-docs\",\n\"subtree:build-release-architect\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S4\"\n]\n},\n{\n\"id\": \"K-FUTURE\",\n\"name\": \"Future-Technology Critic\",\n\"mandate\": \"Does the architecture block likely next-5-year technologies: neural rendering, work graphs, cluster RT, ML animation, new storage and memory, new platforms.\",\n\"checks\": [\n\"extension points exist for emerging techniques\",\n\"maturity labels allow promotion\",\n\"no hard-coding of today's API limits\"\n],\n\"scope\": [\n\"all\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\"\n]\n},\n{\n\"id\": \"K-COMPLETE\",\n\"name\": \"Completeness Critic\",\n\"mandate\": \"Exactly one responsibility: find engine capabilities or engineering disciplines that are missing.\",\n\"checks\": [\n\"compare against shipped engines' feature sets\",\n\"compare against platform requirements\",\n\"compare against production pipelines end to end\"\n],\n\"scope\": [\n\"all\"\n],\n\"stages\": [\n\"G1\",\n\"G2\"\n]\n},\n{\n\"id\": \"K-LEGACY\",\n\"name\": \"Anti-Legacy Critic\",\n\"mandate\": \"Find accidental legacy architecture: central sequential update loops, deep inheritance, global state, hot-path virtual dispatch, CPU-driven rendering, coarse locks, global renderer sync, frame-tied lifetimes, universal scene graphs, synchronous IO/loading, single-thread-first design, OpenGL/DX11 assumptions, monoliths. A flagged pattern needs justification, not removal.\",\n\"checks\": [\n\"each flagged pattern either absent or justified by an ADR\"\n],\n\"scope\": [\n\"all\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\",\n\"S3\"\n]\n},\n{\n\"id\": \"K-GAMEPLAY\",\n\"name\": \"Game Systems & Content Critic\",\n\"mandate\": \"Animation, audio, AI, gameplay framework, UI, text, localization and accessibility: whether game teams get what they need.\",\n\"checks\": [\n\"designers and animators have authoring paths\",\n\"accessibility and localization built in, not bolted on\",\n\"gameplay extension points\"\n],\n\"scope\": [\n\"subtree:animation-architect\",\n\"subtree:audio-architect\",\n\"subtree:gameplay-architect\",\n\"subtree:ui-architect\",\n\"accessibility\",\n\"input-system\",\n\"input-devices-haptics\",\n\"character-vehicle-physics\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S1\",\n\"S2\",\n\"S4\"\n]\n},\n{\n\"id\": \"K-QUALITY\",\n\"name\": \"Quality & Security Critic\",\n\"mandate\": \"Testing, validation, robustness and security: can an independent critic objectively determine correctness.\",\n\"checks\": [\n\"each skill has objective validation\",\n\"untrusted inputs fuzzed\",\n\"determinism and concurrency tested\",\n\"security boundaries explicit\"\n],\n\"scope\": [\n\"all\",\n\"subtree:test-architect\",\n\"subtree:security-engineering\",\n\"subtree:api-lifecycle-migration\"\n],\n\"stages\": [\n\"G1\",\n\"G2\",\n\"S3\",\n\"S4\"\n]\n}\n]\n}","is_error":false}]},"uuid":"e4aada50-4531-4709-86a9-0dd07fcf698a","timestamp":"2026-09-29T15:47:12.803Z","sourceToolAssistantUUID":"7ab833fc-81a7-4a73-b2ec-1d3d480a46b7","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
