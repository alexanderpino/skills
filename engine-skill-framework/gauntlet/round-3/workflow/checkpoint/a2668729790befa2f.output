{"parentUuid":"dffc854d-6c86-42a0-92b1-5520b33e6e1a","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a2668729790befa2f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YWTqMgGrR3Roiugt75AokA","type":"tool_result","content":"{\n\"id\": \"engine-architect\",\n\"name\": \"Game Engine Chief Architect\",\n\"tier\": \"orchestrator\",\n\"parent\": null,\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Owns the engine's overall architecture: requirements and configuration profiles, layering and module boundaries, the contract registry, global conventions, build/integrate/buy decisions and cross-domain arbitration. Final authority on the boundaries between skills.\",\n\"non_responsibilities\": [\n[\n\"Running the ADR, fitness-function and anti-legacy process\",\n\"architecture-governance\"\n],\n[\n\"Scheduling work across agents and the ownership ledger\",\n\"program-orchestration\"\n],\n[\n\"Architecture inside a domain (e.g. shading-path choice)\",\n\"render-architect\"\n]\n],\n\"provides\": [\n\"C-ARCH\"\n],\n\"consumes\": [],\n\"expertise\": [\n\"engine architecture\",\n\"requirements engineering\",\n\"trade-off analysis\",\n\"architecture views\"\n]\n}\n\n{\n\"id\": \"program-orchestration\",\n\"name\": \"Engine Program Orchestration\",\n\"tier\": \"orchestrator\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Turns architecture into coordinated multi-agent work: decomposes milestones into tasks by skill territory, keeps the ownership ledger and territory locks, sequences integration through vertical slices, routes contract change requests, and schedules critic gates.\",\n\"non_responsibilities\": [\n[\n\"Deciding architecture\",\n\"engine-architect\"\n],\n[\n\"CI mechanics\",\n\"ci-cd-automation\"\n],\n[\n\"Release versioning\",\n\"build-release-architect\"\n]\n],\n\"provides\": [\n\"C-ORCH\"\n],\n\"consumes\": [],\n\"expertise\": [\n\"multi-agent coordination\",\n\"work breakdown\",\n\"integration planning\",\n\"critical-path analysis\"\n]\n}\n\n{\n\"id\": \"research-evidence\",\n\"name\": \"Research & Evidence\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Research discipline for every major decision: finds and grades authoritative evidence (production talks, platform docs, peer-reviewed work, reproducible benchmarks), classifies techniques as established / emerging / experimental / speculative, and runs spikes where literature is thin.\",\n\"non_responsibilities\": [\n[\n\"Making the decision (the owning skill does, via an ADR)\",\n\"architecture-governance\"\n],\n[\n\"Benchmark infrastructure\",\n\"perf-benchmarking\"\n]\n],\n\"provides\": [\n\"C-EVID\"\n],\n\"consumes\": [],\n\"expertise\": [\n\"literature review\",\n\"SIGGRAPH/GDC/HPG corpus\",\n\"source provenance\",\n\"experimental design\"\n]\n}\n\n{\n\"id\": \"test-architect\",\n\"name\": \"Test Architect\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Test strategy and architecture: per-subsystem test pyramid, frameworks, the test definition of done every skill must meet, contract tests, test content, coverage and mutation policy, flakiness policy.\",\n\"non_responsibilities\": [\n[\n\"Running pipelines\",\n\"ci-cd-automation\"\n],\n[\n\"Performance regression\",\n\"perf-benchmarking\"\n],\n[\n\"Rendering image validation\",\n\"render-validation\"\n]\n],\n\"provides\": [\n\"C-TEST\"\n],\n\"consumes\": [],\n\"expertise\": [\n\"test strategy\",\n\"contract testing\",\n\"mutation testing\",\n\"test determinism\"\n]\n}\n\n{\n\"id\": \"functional-automation-soak\",\n\"name\": \"Functional Automation & Soak\",\n\"tier\": \"expert\",\n\"parent\": \"test-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Game-level automation: scripted and bot playthroughs, smoke/boot tests, soak and stability runs (memory growth, leaks), hardware/OS compatibility matrix, network harnesses and server load tests.\",\n\"non_responsibilities\": [\n[\n\"Unit test frameworks\",\n\"test-architect\"\n],\n[\n\"Device-farm infrastructure\",\n\"ci-cd-automation\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-GAME?\",\n\"C-INPUT?\",\n\"C-NET?\"\n],\n\"expertise\": [\n\"game automation\",\n\"bots\",\n\"long-run stability analysis\"\n]\n}\n\n{\n\"id\": \"certification-compliance\",\n\"name\": \"Certification & Compliance\",\n\"tier\": \"expert\",\n\"parent\": \"test-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Tracks and pre-validates external requirements: platform certification (TRC/XR/Lotcheck class), age ratings, privacy law, accessibility law (CVAA, EAA), third-party licenses and SBOM, photosensitivity testing.\",\n\"non_responsibilities\": [\n[\n\"Implementing platform features\",\n\"platform-architect\"\n],\n[\n\"Implementing accessibility features\",\n\"accessibility\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-A11Y?\",\n\"C-SVC\"\n],\n\"expertise\": [\n\"platform requirements\",\n\"privacy law\",\n\"accessibility law\",\n\"license compliance\"\n]\n}\n\n{\n\"id\": \"observability-telemetry\",\n\"name\": \"Observability & Telemetry\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": true,\n\"purpose\": \"Instrumentation substrate: structured logging, trace zones (CPU, GPU, IO, memory), counters and metrics, profiler integrations, in-game stats, development and live telemetry with privacy consent; zero cost when compiled out.\",\n\"non_responsibilities\": [\n[\n\"Crash capture\",\n\"crash-diagnostics\"\n],\n[\n\"Debug drawing and consoles\",\n\"visual-debugging-tools\"\n],\n[\n\"Perf budgets\",\n\"performance-architect\"\n]\n],\n\"provides\": [\n\"C-INSTR\"\n],\n\"consumes\": [\n\"C-PAL\"\n],\n\"expertise\": [\n\"low-overhead tracing\",\n\"Tracy/Perfetto formats\",\n\"telemetry pipelines\"\n]\n}\n\n{\n\"id\": \"api-lifecycle-migration\",\n\"name\": \"API Lifecycle & Engine Migration\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Public API surface, semantic versioning and deprecation, ABI policy, engine-upgrade tooling (codemods, data upgraders) and LTS policy, so projects can move across engine versions.\",\n\"non_responsibilities\": [\n[\n\"Data schema mechanisms\",\n\"serialization-schema\"\n],\n[\n\"Plugin loading\",\n\"plugin-system\"\n]\n],\n\"provides\": [\n\"C-API\"\n],\n\"consumes\": [\n\"C-SER\",\n\"C-REFL\"\n],\n\"expertise\": [\n\"API design\",\n\"semver\",\n\"clang tooling codemods\"\n]\n}\n\n{\n\"id\": \"developer-experience-docs\",\n\"name\": \"Developer Experience & Documentation\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Documentation and developer experience: API reference, architecture docs, the sample-project ladder (2D \\u2192 open-world online) that doubles as integration tests, templates, onboarding, doc testing, error-message standards, DX metrics.\",\n\"non_responsibilities\": [\n[\n\"ADR records\",\n\"architecture-governance\"\n],\n[\n\"Iteration-time tooling\",\n\"hot-reload-iteration\"\n]\n],\n\"provides\": [],\n\"consumes\": [],\n\"expertise\": [\n\"technical writing\",\n\"docs-as-code\",\n\"sample design\",\n\"DX metrics\"\n]\n}\n\n{\n\"id\": \"platform-online-services\",\n\"name\": \"Platform & Online Services\",\n\"tier\": \"expert\",\n\"parent\": \"platform-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": true,\n\"purpose\": \"Abstraction over first-party platform services and third-party online backends: identity and sign-in, achievements and presence, entitlements and store, cloud saves, matchmaking/lobby/session boundaries, remote config, moderation boundaries, media capture, crossplay identity.\",\n\"non_responsibilities\": [\n[\n\"Game-server hosting\",\n\"dedicated-server\"\n],\n[\n\"Save-game content\",\n\"persistence-save\"\n],\n[\n\"Backend implementation (outside engine scope)\",\n\"engine-architect\"\n]\n],\n\"provides\": [\n\"C-SVC\"\n],\n\"consumes\": [\n\"C-PAL\",\n\"C-TASK\"\n],\n\"expertise\": [\n\"platform SDKs\",\n\"online service APIs\",\n\"auth tokens\"\n]\n}\n\n{\n\"id\": \"gameplay-architect\",\n\"name\": \"Gameplay Framework Architect\",\n\"tier\": \"lead\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": true,\n\"purpose\": \"Gameplay framework: rules, players and possession, extension points and game-module structure, game flow and transitions, local players.\",\n\"non_responsibilities\": [\n[\n\"Abilities/tags/camera toolkit\",\n\"gameplay-systems-toolkit\"\n],\n[\n\"Scripting VM\",\n\"scripting-runtime\"\n],\n[\n\"Game-specific code (the game team)\",\n\"engine-architect\"\n]\n],\n\"provides\": [\n\"C-GAME\"\n],\n\"consumes\": [\n\"C-ECS\",\n\"C-INPUT?\",\n\"C-PHYS\",\n\"C-ANIM\",\n\"C-AUDIO?\",\n\"C-NET?\",\n\"C-WORLD\",\n\"C-SAVE\"\n],\n\"expertise\": [\n\"gameplay frameworks\",\n\"game architecture\"\n]\n}\n\n{\n\"id\": \"editor-architect\",\n\"name\": \"Editor Architect\",\n\"tier\": \"lead\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"client\"\n],\n\"runtime\": false,\n\"purpose\": \"Editor architecture: process model (in- vs out-of-process runtime), editor/runtime data separation, transactions and undo/redo, selection, extension API and tool scripting, play-in-editor isolation, remote live editing, headless editor, large-project performance.\",\n\"non_responsibilities\": [\n[\n\"Panels and inspectors\",\n\"editor-ui-framework\"\n],\n[\n\"World viewport tools\",\n\"world-editor-viewport\"\n],\n[\n\"Source control\",\n\"collaboration-version-control\"\n]\n],\n\"provides\": [\n\"C-EDCMD\"\n],\n\"consumes\": [\n\"C-REFL\",\n\"C-SER\",\n\"C-ASSET\",\n\"C-WORLD\",\n\"C-PLUGIN\",\n\"C-UI?\"\n],\n\"expertise\": [\n\"editor architecture\",\n\"command pattern\",\n\"tool UX\"\n]\n}\n\n{\n\"id\": \"collaboration-version-control\",\n\"name\": \"Collaboration & Version Control\",\n\"tier\": \"expert\",\n\"parent\": \"editor-architect\",\n\"profiles\": [\n\"client\"\n],\n\"runtime\": false,\n\"purpose\": \"Source-control integration, locking and checkout, multi-user concurrent editing, merge tooling for scene and asset data, content review, large-binary storage strategy.\",\n\"non_responsibilities\": [\n[\n\"Branching model\",\n\"build-release-architect\"\n],\n[\n\"File-per-object layout\",\n\"world-data-model\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-EDCMD\",\n\"C-SER\",\n\"C-ASSET\"\n],\n\"expertise\": [\n\"Perforce\",\n\"Git LFS\",\n\"CRDT/OT for editing\"\n]\n}\n\n{\n\"id\": \"build-release-architect\",\n\"name\": \"Build & Release Architect\",\n\"tier\": \"lead\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Build and release architecture: branching and merge model, engine release management and versioning, orchestration of the code \\u2192 content \\u2192 package pipeline.\",\n\"non_responsibilities\": [\n[\n\"Build system implementation\",\n\"build-system-toolchains\"\n],\n[\n\"CI pipelines\",\n\"ci-cd-automation\"\n],\n[\n\"Packaging\",\n\"packaging-release-patching\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-BUILD\",\n\"C-PKG\",\n\"C-COOK\"\n],\n\"expertise\": [\n\"release engineering\",\n\"branching strategies\"\n]\n}\n\n{\n\"id\": \"packaging-release-patching\",\n\"name\": \"Packaging, Patching & Release\",\n\"tier\": \"expert\",\n\"parent\": \"build-release-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": false,\n\"purpose\": \"Platform packaging and signing, store-submission artifacts, delta/chunk patching, DLC, install-on-demand, client/server/content version compatibility, CDN boundary, release rollback.\",\n\"non_responsibilities\": [\n[\n\"Package runtime format\",\n\"package-formats-vfs\"\n],\n[\n\"Certification tracking\",\n\"certification-compliance\"\n]\n],\n\"provides\": [\n\"C-PKG\"\n],\n\"consumes\": [\n\"C-VFS\",\n\"C-BUILD\",\n\"C-SVC\",\n\"C-COOK\"\n],\n\"expertise\": [\n\"platform packaging\",\n\"binary diffing\",\n\"content delivery\"\n]\n}","is_error":false}]},"uuid":"689b4281-40b8-40a5-a5aa-992b7dae98c6","timestamp":"2026-09-29T15:47:09.454Z","sourceToolAssistantUUID":"dffc854d-6c86-42a0-92b1-5520b33e6e1a","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
