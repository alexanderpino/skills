{"parentUuid":"3b28eb34-1912-49f1-9495-f64bd23aa53a","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a74910df2cdb4f460","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0116W1L7pGWLmwrVJYTqa2Qx","type":"tool_result","content":"{\n  \"_doc\": \"Architectural contracts. Skills depend on contracts, never directly on another skill's internals. layer: 0 platform, 1 foundation, 2 engine services, 3 subsystems, 4 game framework, 5 tools; 'P' = process contract (not code). 'requires' = build-level interface dependencies; must be acyclic and point to the same or a lower layer. 'universal': 'runtime' = implicitly consumed by every runtime skill; 'all' = implicitly consumed by every skill.\",\n  \"contracts\": [\n    {\"id\": \"C-PAL\", \"layer\": 0, \"owner\": \"platform-architect\", \"name\": \"Platform abstraction layer\", \"summary\": \"OS services, CPU/GPU capability discovery, windowing, lifecycle events. No platform #ifdefs above this line.\", \"requires\": []},\n    {\"id\": \"C-ERR\", \"layer\": 1, \"owner\": \"core-runtime-architect\", \"name\": \"Error & failure model\", \"summary\": \"Result types, assertion tiers, fatal vs recoverable, degradation rules.\", \"requires\": [\"C-PAL\"], \"universal\": \"runtime\"},\n    {\"id\": \"C-MOD\", \"layer\": 1, \"owner\": \"core-runtime-architect\", \"name\": \"Module & lifecycle\", \"summary\": \"Module descriptors, init dependency graph, service registration, shutdown order.\", \"requires\": [\"C-PAL\", \"C-ERR\"]},\n    {\"id\": \"C-CFG\", \"layer\": 1, \"owner\": \"core-runtime-architect\", \"name\": \"Configuration & cvars\", \"summary\": \"Layered config sources, typed cvars, change notification, per-device overrides.\", \"requires\": [\"C-PAL\"]},\n    {\"id\": \"C-MATH\", \"layer\": 1, \"owner\": \"math-simd-numerics\", \"name\": \"Math & numeric conventions\", \"summary\": \"Vector/matrix types, precision classes, deterministic-math variants, convention enforcement.\", \"requires\": []},\n    {\"id\": \"C-MEM\", \"layer\": 1, \"owner\": \"memory-allocators\", \"name\": \"Allocation & memory accounting\", \"summary\": \"Allocator interface, tagging, budgets hooks, OOM behavior.\", \"requires\": [\"C-PAL\"], \"universal\": \"runtime\"},\n    {\"id\": \"C-TYPES\", \"layer\": 1, \"owner\": \"containers-core-types\", \"name\": \"Core types & containers\", \"summary\": \"Container, string, hash and ownership types used across the engine.\", \"requires\": [\"C-MEM\"]},\n    {\"id\": \"C-SYNC\", \"layer\": 1, \"owner\": \"concurrency-primitives\", \"name\": \"Concurrency primitives & thread-safety annotations\", \"summary\": \"Atomics, locks, lock-free queues, reclamation, annotation conventions.\", \"requires\": [\"C-PAL\"]},\n    {\"id\": \"C-TASK\", \"layer\": 1, \"owner\": \"job-system-task-graph\", \"name\": \"Task graph & job API\", \"summary\": \"Task creation, dependencies, priorities, blocking rules, completion integration.\", \"requires\": [\"C-SYNC\", \"C-MEM\"]},\n    {\"id\": \"C-INSTR\", \"layer\": 1, \"owner\": \"observability-telemetry\", \"name\": \"Instrumentation\", \"summary\": \"Log/trace/metric API; zero cost when compiled out; trace format.\", \"requires\": [\"C-PAL\"], \"universal\": \"runtime\"},\n    {\"id\": \"C-CRASH\", \"layer\": 1, \"owner\": \"crash-diagnostics\", \"name\": \"Crash & diagnostic hooks\", \"summary\": \"Crash context annotations, breadcrumbs, watchdog registration.\", \"requires\": [\"C-PAL\", \"C-INSTR\"], \"universal\": \"runtime\"},\n    {\"id\": \"C-DET\", \"layer\": 1, \"owner\": \"determinism-replay\", \"name\": \"Determinism\", \"summary\": \"Determinism levels, FP rules, ordered execution rules, state-hash hooks.\", \"requires\": [\"C-MATH\"]},\n    {\"id\": \"C-BUDGET\", \"layer\": 1, \"owner\": \"performance-architect\", \"name\": \"Budgets & scalability profiles\", \"summary\": \"Per-subsystem budgets per tier, device profiles, scalability hooks, perf gate thresholds.\", \"requires\": [\"C-CFG\"], \"universal\": \"runtime\"},\n    {\"id\": \"C-PLUGIN\", \"layer\": 1, \"owner\": \"plugin-system\", \"name\": \"Plugin descriptor & loading\", \"summary\": \"Plugin manifest, dependency resolution, load phases, ABI tags.\", \"requires\": [\"C-MOD\"]},\n    {\"id\": \"C-FRAME\", \"layer\": 2, \"owner\": \"frame-orchestration\", \"name\": \"Frame, tick phases & time\", \"summary\": \"Phase list, sync points, time domains, fixed-step, pipelining depth.\", \"requires\": [\"C-TASK\"]},\n    {\"id\": \"C-ID\", \"layer\": 2, \"owner\": \"entity-object-model\", \"name\": \"Identity & references\", \"summary\": \"Entity IDs, GUIDs, reference kinds, lifetime rules, events.\", \"requires\": [\"C-TYPES\"]},\n    {\"id\": \"C-ECS\", \"layer\": 2, \"owner\": \"ecs-runtime\", \"name\": \"ECS\", \"summary\": \"Components, queries, systems, access declarations, command buffers.\", \"requires\": [\"C-ID\", \"C-TASK\", \"C-FRAME\"]},\n    {\"id\": \"C-REFL\", \"layer\": 2, \"owner\": \"reflection-metadata\", \"name\": \"Reflection & type metadata\", \"summary\": \"Type registry, properties, attributes, dynamic invocation.\", \"requires\": [\"C-TYPES\"]},\n    {\"id\": \"C-SER\", \"layer\": 2, \"owner\": \"serialization-schema\", \"name\": \"Serialization & schema evolution\", \"summary\": \"Formats, versioning, upgraders, canonical form, untrusted-input rules.\", \"requires\": [\"C-REFL\"]},\n    {\"id\": \"C-IO\", \"layer\": 2, \"owner\": \"async-io-storage\", \"name\": \"Async IO\", \"summary\": \"IO requests, priorities, deadlines, completions, decompression targets.\", \"requires\": [\"C-PAL\", \"C-TASK\"]},\n    {\"id\": \"C-VFS\", \"layer\": 2, \"owner\": \"package-formats-vfs\", \"name\": \"Package & VFS mounts\", \"summary\": \"Package format, mount layering, chunk IDs, integrity.\", \"requires\": [\"C-IO\", \"C-SER\"]},\n    {\"id\": \"C-ASSET\", \"layer\": 2, \"owner\": \"content-pipeline-architect\", \"name\": \"Asset identity & references\", \"summary\": \"Asset IDs, soft/hard references, dependency declaration, registry queries.\", \"requires\": [\"C-SER\", \"C-ID\"]},\n    {\"id\": \"C-RES\", \"layer\": 2, \"owner\": \"resource-streaming-architect\", \"name\": \"Resource lifetime & streaming requests\", \"summary\": \"Handles, request priority/deadline, residency callbacks, budgets, fallbacks.\", \"requires\": [\"C-ASSET\", \"C-VFS\", \"C-MEM\"]},\n    {\"id\": \"C-RELOAD\", \"layer\": 2, \"owner\": \"hot-reload-iteration\", \"name\": \"Hot reload\", \"summary\": \"Change notifications, invalidation, state preservation hooks.\", \"requires\": [\"C-RES\", \"C-MOD\"]},\n    {\"id\": \"C-SPATIAL\", \"layer\": 2, \"owner\": \"spatial-transforms\", \"name\": \"Transforms & spatial queries\", \"summary\": \"Transform representation incl. large-world coordinates, hierarchy, generic spatial queries.\", \"requires\": [\"C-MATH\", \"C-ECS\"]},\n    {\"id\": \"C-RHI\", \"layer\": 2, \"owner\": \"rhi-core\", \"name\": \"Render hardware interface\", \"summary\": \"Devices, queues, command lists, sync, bindless, PSOs, presentation.\", \"requires\": [\"C-PAL\", \"C-MEM\", \"C-SYNC\"]},\n    {\"id\": \"C-GPUMEM\", \"layer\": 2, \"owner\": \"gpu-memory-resources\", \"name\": \"GPU resources & memory\", \"summary\": \"Resource creation, heaps, residency, upload/readback, lifetime.\", \"requires\": [\"C-RHI\"]},\n    {\"id\": \"C-ML\", \"layer\": 2, \"owner\": \"ml-inference-runtime\", \"name\": \"ML inference\", \"summary\": \"Model format, inference invocation on GPU/CPU, budgets, precision.\", \"requires\": [\"C-RHI\", \"C-TASK\"]},\n    {\"id\": \"C-WORLD\", \"layer\": 3, \"owner\": \"world-architect\", \"name\": \"World partition & streaming cells\", \"summary\": \"Cells, streaming sources, world data activation, simulation LOD signals.\", \"requires\": [\"C-SPATIAL\", \"C-RES\"]},\n    {\"id\": \"C-RG\", \"layer\": 3, \"owner\": \"render-graph-scheduling\", \"name\": \"Render graph\", \"summary\": \"Pass/resource declaration, queues, history resources, readback.\", \"requires\": [\"C-RHI\", \"C-GPUMEM\"]},\n    {\"id\": \"C-SHADER\", \"layer\": 3, \"owner\": \"shader-system\", \"name\": \"Shader interface & interop\", \"summary\": \"Shader modules, permutations, binding layouts, interop headers.\", \"requires\": [\"C-RHI\"]},\n    {\"id\": \"C-MATIF\", \"layer\": 3, \"owner\": \"material-system\", \"name\": \"Material interface\", \"summary\": \"Material parameters, shading model inputs, material domains.\", \"requires\": [\"C-SHADER\"]},\n    {\"id\": \"C-RSCENE\", \"layer\": 3, \"owner\": \"render-architect\", \"name\": \"Render scene & render features\", \"summary\": \"Render proxies, world→render sync, feature registration, views.\", \"requires\": [\"C-RG\", \"C-SPATIAL\", \"C-MATIF\"]},\n    {\"id\": \"C-TEMPORAL\", \"layer\": 3, \"owner\": \"reconstruction-upscaling\", \"name\": \"Temporal data\", \"summary\": \"Motion vectors, jitter, history validity, reactive masks, resolution scaling.\", \"requires\": [\"C-RG\"]},\n    {\"id\": \"C-RT\", \"layer\": 3, \"owner\": \"ray-tracing-infrastructure\", \"name\": \"Ray-tracing scene\", \"summary\": \"Acceleration structures, instance data, hit-group/material binding, update policy.\", \"requires\": [\"C-RSCENE\"]},\n    {\"id\": \"C-TEXT\", \"layer\": 3, \"owner\": \"text-fonts\", \"name\": \"Text layout & glyphs\", \"summary\": \"Shaped glyph runs, font fallback, glyph atlas/curve data.\", \"requires\": [\"C-TYPES\"]},\n    {\"id\": \"C-DRAW2D\", \"layer\": 3, \"owner\": \"render-2d-vector\", \"name\": \"2D draw lists\", \"summary\": \"Batched 2D/vector/text draw submission used by UI, 2D games, debug overlays.\", \"requires\": [\"C-RG\", \"C-SHADER\", \"C-TEXT\"]},\n    {\"id\": \"C-PHYS\", \"layer\": 3, \"owner\": \"physics-architect\", \"name\": \"Physics world & scene queries\", \"summary\": \"Bodies, shapes, queries, contact events, stepping phases.\", \"requires\": [\"C-SPATIAL\", \"C-ECS\"]},\n    {\"id\": \"C-ANIM\", \"layer\": 3, \"owner\": \"animation-architect\", \"name\": \"Animation pose output\", \"summary\": \"Pose buffers, root motion, animation events, physics/render hand-off.\", \"requires\": [\"C-ECS\", \"C-SPATIAL\"]},\n    {\"id\": \"C-AUDIO\", \"layer\": 3, \"owner\": \"audio-architect\", \"name\": \"Audio emitters & events\", \"summary\": \"Emitter/listener data, event triggering, parameters, busses.\", \"requires\": [\"C-ECS\", \"C-SPATIAL\"]},\n    {\"id\": \"C-INPUT\", \"layer\": 3, \"owner\": \"input-system\", \"name\": \"Input actions\", \"summary\": \"Action values, contexts, device/user association, timestamps.\", \"requires\": [\"C-PAL\", \"C-FRAME\"]},\n    {\"id\": \"C-NET\", \"layer\": 3, \"owner\": \"network-architect\", \"name\": \"Replication & authority\", \"summary\": \"Replicated state declaration, authority, prediction hooks, net ticks.\", \"requires\": [\"C-ECS\", \"C-SER\", \"C-FRAME\"]},\n    {\"id\": \"C-SVC\", \"layer\": 3, \"owner\": \"platform-online-services\", \"name\": \"Platform & online services\", \"summary\": \"Async service calls, identity tokens, entitlements, sessions.\", \"requires\": [\"C-PAL\", \"C-TASK\"]},\n    {\"id\": \"C-LOC\", \"layer\": 3, \"owner\": \"localization-i18n\", \"name\": \"Localized strings\", \"summary\": \"String IDs, formatting, locale switching.\", \"requires\": [\"C-ASSET\"]},\n    {\"id\": \"C-UI\", \"layer\": 3, \"owner\": \"ui-architect\", \"name\": \"UI widgets & binding\", \"summary\": \"Widget model, data binding, focus, layout.\", \"requires\": [\"C-REFL\", \"C-INPUT\", \"C-DRAW2D\", \"C-TEXT\", \"C-LOC\"]},\n    {\"id\": \"C-NAV\", \"layer\": 3, \"owner\": \"navigation-pathfinding\", \"name\": \"Navigation queries\", \"summary\": \"Path requests, navmesh/grid queries, dynamic obstacles.\", \"requires\": [\"C-SPATIAL\", \"C-PHYS\"]},\n    {\"id\": \"C-GAME\", \"layer\": 4, \"owner\": \"gameplay-architect\", \"name\": \"Gameplay framework extension\", \"summary\": \"Game module entry points, rules, players, extension hooks.\", \"requires\": [\"C-ECS\", \"C-PHYS\", \"C-ANIM\", \"C-WORLD\"]},\n    {\"id\": \"C-SCRIPT\", \"layer\": 4, \"owner\": \"scripting-runtime\", \"name\": \"Script bindings\", \"summary\": \"Binding generation, sandbox limits, script lifecycle.\", \"requires\": [\"C-REFL\", \"C-GAME\"]},\n    {\"id\": \"C-SAVE\", \"layer\": 4, \"owner\": \"persistence-save\", \"name\": \"Save games\", \"summary\": \"Save participation, versioned save records, async save/load.\", \"requires\": [\"C-SER\", \"C-ID\"]},\n    {\"id\": \"C-COOK\", \"layer\": 5, \"owner\": \"content-pipeline-architect\", \"name\": \"Cook-step processors\", \"summary\": \"Processor inputs, cache keys, determinism, platform variants.\", \"requires\": [\"C-ASSET\", \"C-SER\", \"C-TASK\"]},\n    {\"id\": \"C-EDCMD\", \"layer\": 5, \"owner\": \"editor-architect\", \"name\": \"Editor commands & tool extension\", \"summary\": \"Transactions, undo/redo, selection, tool registration.\", \"requires\": [\"C-REFL\", \"C-SER\"]},\n    {\"id\": \"C-GRAPH\", \"layer\": 5, \"owner\": \"graph-editor-framework\", \"name\": \"Graph authoring & compilation\", \"summary\": \"Node/pin model, validation, compilation hooks for domain graphs.\", \"requires\": [\"C-EDCMD\"]},\n    {\"id\": \"C-BUILD\", \"layer\": 5, \"owner\": \"build-system-toolchains\", \"name\": \"Build description\", \"summary\": \"Targets, configurations, toolchains, codegen steps.\", \"requires\": []},\n    {\"id\": \"C-PKG\", \"layer\": 5, \"owner\": \"packaging-release-patching\", \"name\": \"Release packages & patches\", \"summary\": \"Package manifests, patch/DLC chunks, version compatibility.\", \"requires\": [\"C-VFS\", \"C-BUILD\"]},\n\n    {\"id\": \"C-ARCH\", \"layer\": \"P\", \"owner\": \"engine-architect\", \"name\": \"Architecture, layering & profiles\", \"summary\": \"Layer rules, contract registry, configuration profiles, conventions.\", \"requires\": [], \"universal\": \"all\"},\n    {\"id\": \"C-ADR\", \"layer\": \"P\", \"owner\": \"architecture-governance\", \"name\": \"ADR & fitness functions\", \"summary\": \"ADR template incl. revisit conditions; automated architectural checks.\", \"requires\": [], \"universal\": \"all\"},\n    {\"id\": \"C-EVID\", \"layer\": \"P\", \"owner\": \"research-evidence\", \"name\": \"Evidence grading\", \"summary\": \"Source tiers, maturity classes, claim standards.\", \"requires\": [], \"universal\": \"all\"},\n    {\"id\": \"C-ORCH\", \"layer\": \"P\", \"owner\": \"program-orchestration\", \"name\": \"Agent coordination protocol\", \"summary\": \"Ownership ledger, change requests, integration order, critic gates.\", \"requires\": [], \"universal\": \"all\"},\n    {\"id\": \"C-TEST\", \"layer\": \"P\", \"owner\": \"test-architect\", \"name\": \"Test & validation definition of done\", \"summary\": \"Required test kinds per skill, determinism of tests, coverage policy.\", \"requires\": [], \"universal\": \"all\"},\n    {\"id\": \"C-API\", \"layer\": \"P\", \"owner\": \"api-lifecycle-migration\", \"name\": \"API stability & deprecation\", \"summary\": \"Public vs internal APIs, versioning, deprecation windows, upgraders.\", \"requires\": [], \"universal\": \"all\"},\n    {\"id\": \"C-TRUST\", \"layer\": \"P\", \"owner\": \"security-engineering\", \"name\": \"Trust boundaries\", \"summary\": \"Untrusted inputs list, validation obligations, sandbox rules.\", \"requires\": [], \"universal\": \"all\"},\n    {\"id\": \"C-A11Y\", \"layer\": \"P\", \"owner\": \"accessibility\", \"name\": \"Accessibility requirements\", \"summary\": \"Mapped guideline requirements per player-facing feature.\", \"requires\": []}\n  ]\n}","is_error":false}]},"uuid":"2507bab8-9125-4271-b323-b6400b9cff05","timestamp":"2026-09-29T15:48:57.210Z","sourceToolAssistantUUID":"3b28eb34-1912-49f1-9495-f64bd23aa53a","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"2507bab8-9125-4271-b323-b6400b9cff05","isSidechain":true,"agentId":"a74910df2cdb4f460","message":{"model":"claude-opus-5-5","id":"msg_011CfXzdBQCwUf8TEFHjZ2xz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DdAr4kbMte7SVojgEkmxQV","name":"Bash","input":{"command":"cd /home/user/skills/engine-skill-framework/data && cat critics.json crosscutting.json","description":"Show critics and crosscutting data"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11365,"cache_read_input_tokens":85965,"output_tokens":341,"output_tokens_details":{"thinking_tokens":133},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":11365},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":341,"cache_read_input_tokens":85965,"cache_creation_input_tokens":11365,"cache_creation":{"ephemeral_5m_input_tokens":11365,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01DdAr4kbMte7SVojgEkmxQV":{"command":"cd /home/user/skills/engine-skill-framework/data && cat critics.json crosscutting.json","description":"Show critics and crosscutting data"}},"apiBlockIndex":2,"requestId":"req_011CfXzdB38au51M7Gv3bk6c","attributionAgent":"general-purpose","type":"assistant","uuid":"3d841c68-b891-4649-b86e-3c7f4924ccb3","timestamp":"2026-09-29T15:48:57.457Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"3d841c68-b891-4649-b86e-3c7f4924ccb3","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a74910df2cdb4f460","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DdAr4kbMte7SVojgEkmxQV","type":"tool_result","content":"{\n  \"_doc\": \"Critic framework. scope selectors: 'all', 'tier:<tier>', 'subtree:<skill-id>' (the skill and all descendants), or a bare skill id. Stages: G1 = framework gauntlet (this phase; every critic reviews the whole framework), G2 = SKILL.md gauntlet (per-skill, scoped), S1 = ADR review, S2 = design/contract review, S3 = implementation review, S4 = validation & release review.\",\n  \"stages\": {\n    \"G1\": \"Framework gauntlet: capability map, skill graph, contracts, hierarchy (whole framework)\",\n    \"G2\": \"SKILL.md gauntlet: per-skill description quality, technique currency, validation criteria\",\n    \"S1\": \"ADR review: evidence, alternatives, revisit conditions\",\n    \"S2\": \"Design & contract review: API/contract drafts, data layouts, threading model\",\n    \"S3\": \"Implementation review: code, tests, instrumentation\",\n    \"S4\": \"Validation & release review: benchmarks, scalability runs, certification readiness\"\n  },\n  \"critics\": [\n    {\n      \"id\": \"K-ARCH\",\n      \"name\": \"Engine Architecture Critic\",\n      \"mandate\": \"Architectural completeness and subsystem boundaries: ownership overlaps, missing contracts, wrong layering, contracts that leak internals, hierarchy that does not match coupling.\",\n      \"checks\": [\n        \"every capability has exactly one owner and the owner is the right expertise\",\n        \"non-responsibilities point to the real owner\",\n        \"contracts are minimal, stable and layered\",\n        \"no hidden cyclic build dependencies\",\n        \"leads have real territory, not just coordination\"\n      ],\n      \"scope\": [\n        \"all\",\n        \"tier:orchestrator\",\n        \"research-evidence\",\n        \"subtree:api-lifecycle-migration\",\n        \"subtree:world-architect\",\n        \"developer-experience-docs\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\"\n      ]\n    },\n    {\n      \"id\": \"K-RENDER\",\n      \"name\": \"Rendering Critic\",\n      \"mandate\": \"Graphics architecture and currency of rendering techniques; GPU-driven, bindless, explicit-API assumptions; scalability from 2D mobile to path tracing.\",\n      \"checks\": [\n        \"no draw-call-centric or DX11-era assumptions\",\n        \"render graph owns sync and aliasing\",\n        \"technique maturity labels are honest\",\n        \"scale-down path exists for each feature\"\n      ],\n      \"scope\": [\n        \"subtree:render-architect\",\n        \"render-validation\",\n        \"gpu-performance\",\n        \"terrain\",\n        \"vegetation-foliage\",\n        \"water-ocean\",\n        \"atmosphere-weather\",\n        \"deformation-skinning\",\n        \"xr-runtime\",\n        \"ml-inference-runtime\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\",\n        \"S3\",\n        \"S4\"\n      ]\n    },\n    {\n      \"id\": \"K-SYSTEMS\",\n      \"name\": \"Systems Critic\",\n      \"mandate\": \"Concurrency, memory, scheduling, IO and low-level architecture.\",\n      \"checks\": [\n        \"no single-thread-first assumptions\",\n        \"explicit ownership and lifetimes\",\n        \"synchronization minimized and justified\",\n        \"async IO end to end\",\n        \"heterogeneous cores and NUMA considered\"\n      ],\n      \"scope\": [\n        \"subtree:core-runtime-architect\",\n        \"subtree:resource-streaming-architect\",\n        \"observability-telemetry\",\n        \"crash-diagnostics\",\n        \"determinism-replay\",\n        \"hot-reload-iteration\",\n        \"rhi-core\",\n        \"gpu-memory-resources\",\n        \"render-graph-scheduling\",\n        \"audio-architect\",\n        \"network-transport\",\n        \"ml-inference-runtime\",\n        \"subtree:world-architect\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\",\n        \"S3\"\n      ]\n    },\n    {\n      \"id\": \"K-SIM\",\n      \"name\": \"Physics & Simulation Critic\",\n      \"mandate\": \"Simulation domains: physics, destruction, fluids, cloth, crowds, large-scale simulation, determinism of simulation.\",\n      \"checks\": [\n        \"stepping and sync with frame phases are explicit\",\n        \"determinism levels are declared\",\n        \"simulation LOD exists for large scales\",\n        \"build-vs-integrate evidence\"\n      ],\n      \"scope\": [\n        \"subtree:physics-architect\",\n        \"crowd-simulation\",\n        \"ik-procedural-animation\",\n        \"prediction-rollback\",\n        \"determinism-replay\",\n        \"procedural-generation\",\n        \"water-ocean\",\n        \"vfx-particles\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\",\n        \"S3\",\n        \"S4\"\n      ]\n    },\n    {\n      \"id\": \"K-NET\",\n      \"name\": \"Networking Critic\",\n      \"mandate\": \"Online and multiplayer architecture: models, replication, prediction, servers, security, online-service boundaries.\",\n      \"checks\": [\n        \"netcode model matches game type\",\n        \"authority and trust explicit\",\n        \"bandwidth and scale budgets\",\n        \"version compatibility\",\n        \"service boundaries clear\"\n      ],\n      \"scope\": [\n        \"subtree:network-architect\",\n        \"anti-cheat-integrity\",\n        \"platform-online-services\",\n        \"destruction-fracture\",\n        \"persistence-save\",\n        \"packaging-release-patching\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\",\n        \"S3\",\n        \"S4\"\n      ]\n    },\n    {\n      \"id\": \"K-TOOLS\",\n      \"name\": \"Tools & Editor Critic\",\n      \"mandate\": \"Production tooling and content workflows: editor, pipeline, collaboration, iteration speed.\",\n      \"checks\": [\n        \"tooling as thorough as runtime\",\n        \"undo/transactions universal\",\n        \"large teams can collaborate without lock contention\",\n        \"iteration time measured\",\n        \"pipeline deterministic and cached\"\n      ],\n      \"scope\": [\n        \"subtree:editor-architect\",\n        \"subtree:content-pipeline-architect\",\n        \"hot-reload-iteration\",\n        \"developer-experience-docs\",\n        \"ui-architect\",\n        \"terrain\",\n        \"procedural-generation\",\n        \"cinematics-sequencer\",\n        \"scripting-runtime\",\n        \"world-data-model\",\n        \"subtree:build-release-architect\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\",\n        \"S3\",\n        \"S4\"\n      ]\n    },\n    {\n      \"id\": \"K-PLATFORM\",\n      \"name\": \"Platform Critic\",\n      \"mandate\": \"Hardware, operating systems, consoles, graphics APIs, packaging and platform requirements.\",\n      \"checks\": [\n        \"PAL is the only platform-specific layer\",\n        \"console, mobile and web constraints represented\",\n        \"certification requirements traced\",\n        \"packaging and patching per platform\"\n      ],\n      \"scope\": [\n        \"subtree:platform-architect\",\n        \"rhi-core\",\n        \"subtree:build-release-architect\",\n        \"certification-compliance\",\n        \"async-io-storage\",\n        \"crash-diagnostics\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\",\n        \"S4\"\n      ]\n    },\n    {\n      \"id\": \"K-PERF\",\n      \"name\": \"Performance Critic\",\n      \"mandate\": \"Scalability bottlenecks: serialization points, excess synchronization, cache inefficiency, GPU stalls, bandwidth, poor asymptotics.\",\n      \"checks\": [\n        \"budgets exist for each subsystem\",\n        \"benchmarks include realistic workloads\",\n        \"no hidden global sync points\",\n        \"asymptotics stated for world-scale data\"\n      ],\n      \"scope\": [\n        \"all\",\n        \"subtree:performance-architect\",\n        \"subtree:world-architect\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S2\",\n        \"S3\",\n        \"S4\"\n      ]\n    },\n    {\n      \"id\": \"K-PROD\",\n      \"name\": \"Production Critic\",\n      \"mandate\": \"Could a real team ship games with this: workflows, content scale, team scale, schedules, live operations.\",\n      \"checks\": [\n        \"content creators are first-class\",\n        \"features have an owner through ship\",\n        \"live-ops and patching covered\",\n        \"scale-down keeps small teams productive\"\n      ],\n      \"scope\": [\n        \"all\",\n        \"tier:orchestrator\",\n        \"developer-experience-docs\",\n        \"subtree:build-release-architect\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S4\"\n      ]\n    },\n    {\n      \"id\": \"K-FUTURE\",\n      \"name\": \"Future-Technology Critic\",\n      \"mandate\": \"Does the architecture block likely next-5-year technologies: neural rendering, work graphs, cluster RT, ML animation, new storage and memory, new platforms.\",\n      \"checks\": [\n        \"extension points exist for emerging techniques\",\n        \"maturity labels allow promotion\",\n        \"no hard-coding of today's API limits\"\n      ],\n      \"scope\": [\n        \"all\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\"\n      ]\n    },\n    {\n      \"id\": \"K-COMPLETE\",\n      \"name\": \"Completeness Critic\",\n      \"mandate\": \"Exactly one responsibility: find engine capabilities or engineering disciplines that are missing.\",\n      \"checks\": [\n        \"compare against shipped engines' feature sets\",\n        \"compare against platform requirements\",\n        \"compare against production pipelines end to end\"\n      ],\n      \"scope\": [\n        \"all\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\"\n      ]\n    },\n    {\n      \"id\": \"K-LEGACY\",\n      \"name\": \"Anti-Legacy Critic\",\n      \"mandate\": \"Find accidental legacy architecture: central sequential update loops, deep inheritance, global state, hot-path virtual dispatch, CPU-driven rendering, coarse locks, global renderer sync, frame-tied lifetimes, universal scene graphs, synchronous IO/loading, single-thread-first design, OpenGL/DX11 assumptions, monoliths. A flagged pattern needs justification, not removal.\",\n      \"checks\": [\n        \"each flagged pattern either absent or justified by an ADR\"\n      ],\n      \"scope\": [\n        \"all\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\",\n        \"S3\"\n      ]\n    },\n    {\n      \"id\": \"K-GAMEPLAY\",\n      \"name\": \"Game Systems & Content Critic\",\n      \"mandate\": \"Animation, audio, AI, gameplay framework, UI, text, localization and accessibility: whether game teams get what they need.\",\n      \"checks\": [\n        \"designers and animators have authoring paths\",\n        \"accessibility and localization built in, not bolted on\",\n        \"gameplay extension points\"\n      ],\n      \"scope\": [\n        \"subtree:animation-architect\",\n        \"subtree:audio-architect\",\n        \"subtree:gameplay-architect\",\n        \"subtree:ui-architect\",\n        \"accessibility\",\n        \"input-system\",\n        \"input-devices-haptics\",\n        \"character-vehicle-physics\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S1\",\n        \"S2\",\n        \"S4\"\n      ]\n    },\n    {\n      \"id\": \"K-QUALITY\",\n      \"name\": \"Quality & Security Critic\",\n      \"mandate\": \"Testing, validation, robustness and security: can an independent critic objectively determine correctness.\",\n      \"checks\": [\n        \"each skill has objective validation\",\n        \"untrusted inputs fuzzed\",\n        \"determinism and concurrency tested\",\n        \"security boundaries explicit\"\n      ],\n      \"scope\": [\n        \"all\",\n        \"subtree:test-architect\",\n        \"subtree:security-engineering\",\n        \"subtree:api-lifecycle-migration\"\n      ],\n      \"stages\": [\n        \"G1\",\n        \"G2\",\n        \"S3\",\n        \"S4\"\n      ]\n    }\n  ]\n}{\n  \"_doc\": \"Every cross-cutting requirement from the brief has one owning skill that defines the obligation and reviews every other skill against it. 'obligation' is what each skill's SKILL.md must address in phase 2.\",\n  \"concerns\": [\n    {\"concern\": \"performance\", \"owner\": \"performance-architect\", \"obligation\": \"Declare budgets per tier, hot paths, and the benchmark that proves them.\"},\n    {\"concern\": \"memory usage\", \"owner\": \"memory-allocators\", \"obligation\": \"Declare allocation strategy, memory tags, peak/steady budgets and OOM behavior.\"},\n    {\"concern\": \"cache behavior\", \"owner\": \"cpu-performance\", \"obligation\": \"Declare data layouts of hot data and access patterns; justify pointer chasing.\"},\n    {\"concern\": \"concurrency\", \"owner\": \"concurrency-primitives\", \"obligation\": \"Declare threading model, shared state, synchronization and task-graph placement.\"},\n    {\"concern\": \"latency\", \"owner\": \"frame-orchestration\", \"obligation\": \"Declare frame phase placement and latency contribution.\"},\n    {\"concern\": \"determinism\", \"owner\": \"determinism-replay\", \"obligation\": \"Declare the determinism level provided and how it is tested.\"},\n    {\"concern\": \"observability\", \"owner\": \"observability-telemetry\", \"obligation\": \"Declare trace zones, counters and logs; zero cost when compiled out.\"},\n    {\"concern\": \"debugging\", \"owner\": \"visual-debugging-tools\", \"obligation\": \"Declare debug visualizations, inspectors and console commands.\"},\n    {\"concern\": \"testing\", \"owner\": \"test-architect\", \"obligation\": \"Meet the test definition of done (unit, contract, integration, fuzz where untrusted).\"},\n    {\"concern\": \"scalability\", \"owner\": \"performance-architect\", \"obligation\": \"Declare behavior from the smallest to the largest configuration and the scaling knobs.\"},\n    {\"concern\": \"security\", \"owner\": \"security-engineering\", \"obligation\": \"Declare untrusted inputs and validation; follow the trust-boundary contract.\"},\n    {\"concern\": \"platform portability\", \"owner\": \"platform-architect\", \"obligation\": \"No platform code above the PAL; declare capability-tier behavior.\"},\n    {\"concern\": \"maintainability\", \"owner\": \"architecture-governance\", \"obligation\": \"Contracts documented, ADRs recorded, fitness functions pass.\"},\n    {\"concern\": \"tooling\", \"owner\": \"editor-architect\", \"obligation\": \"Declare authoring path, inspectors and editor integration for every user-facing feature.\"},\n    {\"concern\": \"failure recovery\", \"owner\": \"core-runtime-architect\", \"obligation\": \"Follow the error model; declare degradation and recovery behavior.\"},\n    {\"concern\": \"hot reload\", \"owner\": \"hot-reload-iteration\", \"obligation\": \"Declare what reloads live and how state is preserved.\"},\n    {\"concern\": \"data migration\", \"owner\": \"serialization-schema\", \"obligation\": \"Version every persisted format and ship upgraders.\"},\n    {\"concern\": \"backwards compatibility\", \"owner\": \"api-lifecycle-migration\", \"obligation\": \"Classify APIs public/internal and follow deprecation policy.\"},\n    {\"concern\": \"developer usability\", \"owner\": \"developer-experience-docs\", \"obligation\": \"Ship docs, a sample, and actionable error messages.\"},\n    {\"concern\": \"accessibility\", \"owner\": \"accessibility\", \"obligation\": \"Map player-facing features to accessibility requirements.\"},\n    {\"concern\": \"evidence\", \"owner\": \"research-evidence\", \"obligation\": \"Every major decision cites graded evidence and a maturity class.\"}\n  ]\n}","is_error":false}]},"uuid":"4cae8526-7e26-46ff-9b25-4664b4540781","timestamp":"2026-09-29T15:48:57.529Z","sourceToolAssistantUUID":"3d841c68-b891-4649-b86e-3c7f4924ccb3","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
