"strand rendering\",\n\"digital humans\"\n]\n}\n{\n\"id\": \"render-2d-vector\",\n\"name\": \"2D, Vector & UI Rendering\",\n\"tier\": \"expert\",\n\"parent\": \"render-architect\",\n\"profiles\": [\n\"client\"\n],\n\"runtime\": true,\n\"purpose\": \"2D draw backend shared by 2D games, UI and debug overlays: sprites, tilemaps, 2D lighting, vector paths, UI batching/clipping/SDF, HDR compositing, pixel-perfect modes.\",\n\"non_responsibilities\": [\n[\n\"Widget model\",\n\"ui-architect\"\n],\n[\n\"Glyph shaping\",\n\"text-fonts\"\n]\n],\n\"provides\": [\n\"C-DRAW2D\"\n],\n\"consumes\": [\n\"C-RG\",\n\"C-SHADER\",\n\"C-TEXT\"\n],\n\"expertise\": [\n\"2D batching\",\n\"vector rasterization\",\n\"SDF rendering\"\n]\n}\n{\n\"id\": \"vfx-particles\",\n\"name\": \"Particles & VFX\",\n\"tier\": \"expert\",\n\"parent\": \"render-architect\",\n\"profiles\": [\n\"client\"\n],\n\"runtime\": true,\n\"purpose\": \"GPU particle simulation, VFX graph runtime, ribbons/beams/mesh particles, particle collision, VFX budgets and significance.\",\n\"non_responsibilities\": [\n[\n\"Physically based fluids\",\n\"fluid-simulation\"\n],\n[\n\"Translucency sorting\",\n\"translucency-decals\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-RSCENE\",\n\"C-RG\",\n\"C-GRAPH?\",\n\"C-PHYS?\"\n],\n\"expertise\": [\n\"GPU particles\",\n\"VFX authoring\",\n\"Niagara/VFX Graph-class systems\"\n]\n}\n{\n\"id\": \"deformation-skinning\",\n\"name\": \"Skinning & Deformation\",\n\"tier\": \"expert\",\n\"parent\": \"animation-architect\",\n\"profiles\": [\n\"mobile3d\",\n\"std3d\"\n],\n\"runtime\": true,\n\"purpose\": \"GPU skinning (linear, dual quaternion), morph targets, ML deformers, deformed-geometry acceleration-structure updates, deformation motion vectors.\",\n\"non_responsibilities\": [\n[\n\"Cloth\",\n\"cloth-deformables\"\n],\n[\n\"Facial solvers\",\n\"facial-animation\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-ANIM\",\n\"C-RSCENE\",\n\"C-RG\",\n\"C-TEMPORAL\",\n\"C-RT?\",\n\"C-ML?\"\n],\n\"expertise\": [\n\"compute skinning\",\n\"blendshapes\",\n\"ML deformers\"\n]\n}\n{\n\"id\": \"text-fonts\",\n\"name\": \"Text & Fonts\",\n\"tier\": \"expert\",\n\"parent\": \"ui-architect\",\n\"profiles\": [\n\"client\"\n],\n\"runtime\": true,\n\"purpose\": \"Font loading and fallback, glyph rasterization, shaping, bidi and line breaking, rich text and emoji, text input and IME.\",\n\"non_responsibilities\": [\n[\n\"String content\",\n\"localization-i18n\"\n],\n[\n\"2D draw submission\",\n\"render-2d-vector\"\n]\n],\n\"provides\": [\n\"C-TEXT\"\n],\n\"consumes\": [\n\"C-TYPES\",\n\"C-ASSET\"\n],\n\"expertise\": [\n\"HarfBuzz\",\n\"Unicode (UAX #9, #14, #29)\",\n\"SDF/MSDF\"\n]\n}\n{\n\"id\": \"visual-debugging-tools\",\n\"name\": \"Visual Debugging Tools\",\n\"tier\": \"expert\",\n\"parent\": \"editor-architect\",\n\"profiles\": [\n\"all\"\n],\n\"runtime\": true,\n\"purpose\": \"Debug draw API, in-game console and cheats, runtime entity inspector and gameplay debugger, visual logger and rewind, debug menus and overlays.\",\n\"non_responsibilities\": [\n[\n\"Logging and traces\",\n\"observability-telemetry\"\n],\n[\n\"Render buffer visualization\",\n\"render-architect\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-INSTR\",\n\"C-ECS\",\n\"C-DRAW2D?\",\n\"C-RSCENE?\",\n\"C-DET?\"\n],\n\"expertise\": [\n\"debug tooling\",\n\"visual logging\"\n]\n}","is_error":false}]},"uuid":"7d5ae1bc-51ca-4cc7-a2de-4c767692fa4b","timestamp":"2026-09-29T15:44:49.541Z","sourceToolAssistantUUID":"cfcda828-b9d4-4af9-a310-ebf61872c76b","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
