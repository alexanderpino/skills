.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"6c620c48-c764-400b-8d24-27b138df37c6","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a65819c69c5860f4b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tar6bFezzTHggNaPTpNp4e","type":"tool_result","content":"{\n  \"_doc\": \"Skill graph. tier: orchestrator | cross-cutting | lead | expert. consumes: contract IDs, a trailing '?' marks an optional dependency (feature degrades or is absent without it). profiles: 'all', 'client' (every configuration without the server base), or explicit profile tokens. runtime=true means the skill ships engine runtime code and implicitly consumes the 'runtime' universal contracts.\",\n  \"profiles\": {\n    \"base\": {\n      \"min2d\": \"Small 2D / 2.5D indie game\",\n      \"mobile3d\": \"Mobile / portable 3D game\",\n      \"std3d\": \"Modern 3D game on PC / console\",\n      \"server\": \"Headless dedicated game server\"\n    },\n    \"addons\": {\n      \"openworld\": \"Large streamed worlds\",\n      \"online\": \"Networked multiplayer\",\n      \"aaa\": \"High-end AAA feature set\",\n      \"xr\": \"VR / MR\",\n      \"ugc\": \"Mods & user-generated content\"\n    }\n  },\n  \"configurations\": {\n    \"indie-2d\": [\"min2d\"],\n    \"indie-2d-online-moddable\": [\"min2d\", \"online\", \"ugc\"],\n    \"mobile-3d\": [\"mobile3d\"],\n    \"standard-3d\": [\"std3d\"],\n    \"open-world\": [\"std3d\", \"openworld\"],\n    \"online-3d\": [\"std3d\", \"online\"],\n    \"aaa-open-world-online\": [\"std3d\", \"openworld\", \"online\", \"aaa\", \"ugc\"],\n    \"dedicated-server\": [\"server\", \"online\"],\n    \"xr-3d\": [\"std3d\", \"xr\"]\n  },\n  \"skills\": [\n    {\"id\": \"engine-architect\", \"name\": \"Game Engine Chief Architect\", \"tier\": \"orchestrator\", \"parent\": null, \"profiles\": [\"all\"], \"runtime\": false,\n     \"purpose\": \"Owns the engine's overall architecture: requirements and configuration profiles, layering and module boundaries, the contract registry, global conventions, build/integrate/buy decisions and cross-domain arbitration. Final authority on the boundaries between skills.\",\n     \"non_responsibilities\": [[\"Running the ADR, fitness-function and anti-legacy process\", \"architecture-governance\"], [\"Scheduling work across agents and the ownership ledger\", \"program-orchestration\"], [\"Architecture inside a domain (e.g. shading-path choice)\", \"render-architect\"]],\n     \"provides\": [\"C-ARCH\"], \"consumes\": [], \"expertise\": [\"engine architecture\", \"requirements engineering\", \"trade-off analysis\", \"architecture views\"]},\n    {\"id\": \"architecture-governance\", \"name\": \"Architecture Governance\", \"tier\": \"orchestrator\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": false,\n     \"purpose\": \"Runs architecture as an evidence-backed, governed process: ADR lifecycle with revisit conditions, technology radar with maturity tiers and promotion criteria, automated fitness functions (layering, dependency direction, contract conformance), anti-legacy review, coding standard.\",\n     \"non_responsibilities\": [[\"Making the architecture decisions themselves\", \"engine-architect\"], [\"Grading sources and running spikes\", \"research-evidence\"], [\"Test definition of done\", \"test-architect\"]],\n     \"provides\": [\"C-ADR\"], \"consumes\": [], \"expertise\": [\"ADRs\", \"fitness functions\", \"static dependency analysis\", \"technology radar\"]},\n    {\"id\": \"program-orchestration\"\ndict_keys(['_doc', 'profiles', 'configurations', 'skills'])","is_error":false}]},"uuid":"e4d253e7-5b0c-492e-a4c2-114c16919b6b","timestamp":"2026-09-29T15:45:55.587Z","sourceToolAssistantUUID":"6c620c48-c764-400b-8d24-27b138df37c6","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
