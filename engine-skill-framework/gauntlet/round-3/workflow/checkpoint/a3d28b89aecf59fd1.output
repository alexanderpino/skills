{"parentUuid":"d39f82a3-4311-483f-a3f7-1d54d2457f6e","isSidechain":true,"agentId":"a3d28b89aecf59fd1","message":{"model":"claude-opus-5-5","id":"msg_011CfXzVthvDiQVPZbLWkg8f","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014t52V5Vr89ALgTboxakhkR","name":"Bash","input":{"command":"cd /home/user/skills/engine-skill-framework/scripts && python3 -c \"\nfrom model import Model\nm=Model()\nfor s in m.skill_order:\n  sk=m.skill(s)\n  pl=[m.contract(c)['layer'] for c in sk['provides'] if m.contract(c)['layer']!='P']\n  if not pl: continue\n  lo=min(pl)\n  up=[(c,m.contract(c)['layer']) for c,opt in m.deps(s) if m.contract(c)['layer']!='P' and m.contract(c)['layer']>lo]\n  if up: print(s,'provides min layer',lo,'consumes higher',up)\n\"","description":"Find skills consuming higher-layer contracts than they provide"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12131,"cache_read_input_tokens":126246,"output_tokens":882,"output_tokens_details":{"thinking_tokens":574},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":12131},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":882,"cache_read_input_tokens":126246,"cache_creation_input_tokens":12131,"cache_creation":{"ephemeral_5m_input_tokens":12131,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_014t52V5Vr89ALgTboxakhkR":{"command":"cd /home/user/skills/engine-skill-framework/scripts && python3 -c \"\nfrom model import Model\nm=Model()\nfor s in m.skill_order:\n  sk=m.skill(s)\n  pl=[m.contract(c)['layer'] for c in sk['provides'] if m.contract(c)['layer']!='P']\n  if not pl: continue\n  lo=min(pl)\n  up=[(c,m.contract(c)['layer']) for c,opt in m.deps(s) if m.contract(c)['layer']!='P' and m.contract(c)['layer']>lo]\n  if up: print(s,'provides min layer',lo,'consumes higher',up)\n\"","description":"Find skills consuming higher-layer contracts than they provide"}},"apiBlockIndex":1,"requestId":"req_011CfXzVtUmeemjSdRwoCnLM","attributionAgent":"general-purpose","type":"assistant","uuid":"679121ff-d284-43d3-af59-d1997cca751d","timestamp":"2026-09-29T15:47:23.843Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"679121ff-d284-43d3-af59-d1997cca751d","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a3d28b89aecf59fd1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014t52V5Vr89ALgTboxakhkR","type":"tool_result","content":"determinism-replay provides min layer 1 consumes higher [('C-SER', 2)]\nml-inference-runtime provides min layer 2 consumes higher [('C-RG', 3)]\nshader-system provides min layer 3 consumes higher [('C-COOK', 5)]\nmaterial-system provides min layer 3 consumes higher [('C-GRAPH', 5)]\nlocalization-i18n provides min layer 3 consumes higher [('C-COOK', 5)]","is_error":false}]},"uuid":"e102fe53-3f0c-48aa-8335-0ab9af0085c5","timestamp":"2026-09-29T15:47:23.918Z","sourceToolAssistantUUID":"679121ff-d284-43d3-af59-d1997cca751d","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"e102fe53-3f0c-48aa-8335-0ab9af0085c5","isSidechain":true,"agentId":"a3d28b89aecf59fd1","attachment":{"type":"total_tokens_reminder","text":"<total_tokens>14860739 tokens left</total_tokens>"},"type":"attachment","uuid":"a9c0bf3d-9b8c-45d5-8cc9-e7f2efda14e8","timestamp":"2026-09-29T15:47:23.921Z","rendered":[{"content":"<system-reminder>\n<total_tokens>14860739 tokens left</total_tokens>\n</system-reminder>"}],"userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"a9c0bf3d-9b8c-45d5-8cc9-e7f2efda14e8","isSidechain":true,"agentId":"a3d28b89aecf59fd1","message":{"model":"claude-opus-5-5","id":"msg_011CfXzWX5vmeDhiQWUk3GN4","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1068,"cache_read_input_tokens":138377,"cache_creation":{"ephemeral_5m_input_tokens":1068,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":0,"requestId":"req_011CfXzWWmLGmie5auqA1RGw","attributionAgent":"general-purpose","type":"assistant","uuid":"76709328-423a-4f40-84ee-927fc7931ec8","timestamp":"2026-09-29T15:47:50.781Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"76709328-423a-4f40-84ee-927fc7931ec8","isSidechain":true,"agentId":"a3d28b89aecf59fd1","message":{"model":"claude-opus-5-5","id":"msg_011CfXzWX5vmeDhiQWUk3GN4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KzxRJCkfbHSxtz46z8R8LN","name":"Write","input":{"file_path":"/home/user/skills/engine-skill-framework/gauntlet/round-1/K-ARCH.md","content":"# K-ARCH · Engine Architecture Critic · Round 1\n\nScope: architectural completeness and subsystem boundaries. Findings are ordered most severe first. The structural checker (`check.py`) passes with 0 errors. Every finding below is something it cannot see. Where a finding cites a configuration closure, it was computed with `scripts/model.py`, using the same membership and closure rules as `check.py`.\n\n### K-ARCH-1 · blocker · scale-down\n- Target: terrain, water-ocean, vegetation-foliage, destruction-fracture, fluid-simulation, facial-animation, ml-inference-runtime; configurations `dedicated-server`, `aaa-open-world-online`; WLD.PART.server\n- Finding: The server side of the flagship configuration cannot be built. The only server configuration is `[server, online]`, which contains no open-world skill. The configurations `[server, online, openworld]` and `[server, online, openworld, aaa]` are **not closed**. For the first, closure fails on terrain→C-RSCENE/C-MATIF, vegetation-foliage→C-RSCENE and water-ocean→C-RSCENE/C-RG. The aaa variant adds failures for destruction-fracture→C-RSCENE, fluid-simulation→C-RG, facial-animation→C-AUDIO, ml-inference-runtime→C-RHI/C-RG and others. The cause is the \"end-to-end feature ownership\" pattern (principles §4) combined with *required* render contracts. The skills that own authoritative simulation data (heightfields for collision and navmesh, water height and flow for buoyancy, fracture state for replication) can only exist alongside a renderer. WLD.PART.server (\"server-side world streaming\") therefore has nothing to stream on the server.\n- Evidence: Authoritative open-world servers need terrain collision, water queries and destruction state without a GPU. UE dedicated servers strip rendering but keep Landscape collision and Chaos destruction. MMO and survival servers work the same way. C-ML requires C-RHI, which also makes CPU inference for server-side AI (GAM.AI.learned) impossible.\n- Proposed change: (a) Add a contract `C-ENV` (layer 3, owner world-architect): environment data and queries covering height, surface type, water height and velocity, and deformation deltas. It requires C-WORLD and C-SPATIAL. terrain, water-ocean and vegetation-foliage implement it, and collision-detection, navigation-pathfinding, character-vehicle-physics and spatial-audio consume it. (b) Mark C-RSCENE, C-MATIF and C-RG as optional (`?`) in terrain, water-ocean, vegetation-foliage, destruction-fracture and fluid-simulation, and require each SKILL.md to define a headless mode. (c) Make C-ML require `C-RHI?` so that inference has a CPU-only path. (d) Add the configurations `open-world-server` = [server, online, openworld] and `aaa-server` = [server, online, openworld, aaa], so that `check.py` proves them closed.\n\n### K-ARCH-2 · blocker · missing-contract\n- Target: gpu-driven-pipeline, virtualized-geometry-lod, texture-streaming-vt, direct-lighting-shadows, global-illumination, render-architect (C-RSCENE)\n- Finding: 18 render experts sit under one lead, and 12 of them provide **no contract**. Yet their data is consumed across features:\n  - The GPU scene, instance buffers and HZB/culling results (gpu-driven-pipeline) are needed by VSM (direct-lighting-shadows), RT instance management (ray-tracing-infrastructure), GI surface caches and vegetation.\n  - Cluster/LOD selection (virtualized-geometry-lod) is needed by RND.RT.lod, RND.RT.cluster-blas, VSM page rendering and deforming LOD.\n  - The VT page table and feedback (texture-streaming-vt) are needed by terrain (\"Virtual texturing core → texture-streaming-vt\") and material-system.\n  - The light grid and shadow sampling (direct-lighting-shadows) are needed by translucency-decals, atmosphere (volumetric fog), water and VFX.\n  - GI/radiance-cache sampling is needed by translucency, water, VFX and hair.\n\n  The only channel for all of this is C-RSCENE, which the lead owns. Either agents reach into each other's internals, or C-RSCENE becomes an unbounded grab bag that every render agent edits. There is also an overlap. RND.ARCH.scene-sync (\"render scene representation\", owned by render-architect) and RND.GEO.gpu-scene (\"GPU scene & instance data\", owned by gpu-driven-pipeline) describe the same data structure in a GPU-driven renderer.\n- Evidence: UE5's GPUScene, Nanite and VSM interplay is a set of explicit interfaces (VSM renders through Nanite's cluster culling, and Lumen consumes mesh SDF and surface cache data). Frostbite and Decima GPU-driven talks (Wihlidal, GDC 2016; Haar/Aaltonen, SIGGRAPH 2015) treat instance data and culling output as shared producer/consumer interfaces.\n- Proposed change: Add layer-3 contracts:\n  - `C-GPUSCENE`, owned by gpu-driven-pipeline: instance data layout, culling output and HZB. Move RND.ARCH.scene-sync's GPU half into it. render-architect keeps only the CPU proxy registry and the sync protocol.\n  - `C-GEOLOD`, owned by virtualized-geometry-lod: cluster/LOD selection and page residency for raster, shadow and RT consumers.\n  - `C-VT`, owned by texture-streaming-vt: page tables, feedback and VT allocation for terrain and materials.\n  - `C-LIGHTS`, owned by direct-lighting-shadows: light lists, clustered grid and shadow sampling.\n  - `C-GISAMPLE`, owned by global-illumination: an irradiance/radiance query interface for forward, translucent and volumetric consumers.\n\n  Update the consumers' `consumes` lists to match.\n\n### K-ARCH-3 · major · wrong-boundary\n- Target: C-SPATIAL, C-PHYS, C-ANIM, C-AUDIO, C-NET, C-GAME (requires C-ECS); render-architect, audio-architect, world-architect, network-architect (consume C-ECS)\n- Finding: ECS is a hard build-level prerequisite of the transform contract and of every subsystem contract. This contradicts the stated default in §6: a \"hybrid object model; not ECS for everything\", with CORE.OBJ.hybrid owned by entity-object-model. It also contradicts the replaceability claim (\"C-PHYS can be served by an integrated middleware\"), because the contract itself is shaped by ECS component access. Contracts that declare \"components, queries, command buffers\" as a dependency leak the object-model internals into physics, audio and network APIs. As specified, an agent implementing C-SPATIAL or C-PHYS will write ECS systems by default. That is the dogmatic-ECS failure the brief forbids, arrived at by the dependency graph rather than by an ADR.\n- Evidence: Jolt, PhysX and Havok own their body storage and are bridged to ECS by adapter systems (Unity Physics/Havok in DOTS, UE Mass↔Chaos). Wwise and FMOD are object/emitter-ID based. Replication in UE Iris is keyed by NetRefHandle and is not tied to one object model.\n- Proposed change: Change `requires` as follows:\n  - C-SPATIAL → [C-MATH, C-ID]\n  - C-PHYS → [C-SPATIAL, C-FRAME, C-ID]\n  - C-ANIM → [C-SPATIAL, C-ID]\n  - C-AUDIO → [C-SPATIAL, C-ID]\n  - C-NET → [C-ID, C-SER, C-FRAME]\n  - C-GAME → [C-ID, C-FRAME, C-WORLD]\n\n  Make C-ECS optional (`C-ECS?`) in render-architect, audio-architect, physics-architect, animation-architect, network-architect, world-architect and spatial-transforms. Add a capability `CORE.ECS.bridges` (\"ECS↔subsystem adapter systems and sync points\") owned by ecs-runtime, with the subsystem leads as contributors. entity-object-model's hybrid policy then decides *per configuration* whether ECS is the host.\n\n### K-ARCH-4 · major · missing-contract\n- Target: prediction-rollback (NET.PRED.rollback, NET.PRED.lagcomp), physics-architect (C-PHYS), animation-architect (C-ANIM), ecs-runtime, determinism-replay (C-DET)\n- Finding: Rollback and resimulation need every participating subsystem to snapshot, restore and re-step N frames in a single frame. Lag compensation also needs historical collision state. No contract carries this obligation. C-PHYS is \"bodies, shapes, queries, contact events, stepping phases\", C-DET is \"state-hash hooks\", and C-SAVE is save-game granularity. prediction-rollback cannot reach this capability without modifying the physics, animation and ECS internals.\n- Evidence: GGPO-class rollback requires save/load/advance callbacks per subsystem. UE's Network Prediction plugin and Chaos resim cache, Photon Quantum and Overwatch's ECS rollback (Ford, GDC 2017) all make snapshot and restore an explicit subsystem interface. Box2D v3 and Jolt state recorders exist for this reason.\n- Proposed change: Add a contract `C-SNAPSHOT` (layer 2, owner determinism-replay): frame-state snapshot, restore, resimulate, history ring and cost declaration. It requires C-FRAME and C-SER. physics-architect, animation-architect, ecs-runtime and gameplay-architect implement it. prediction-rollback and replication (NET.REP.replays) consume it. Add the capability `XC.DET.snapshot` with owner determinism-replay.\n\n### K-ARCH-5 · major · dependency-error\n- Target: shader-system, localization-i18n (consume C-COOK layer 5), material-system (consumes C-GRAPH layer 5), texture-streaming-vt, virtualized-geometry-lod, content-pipeline-architect (runtime=true), shader-system (requires C-RELOAD); configuration `dedicated-server`\n- Finding: Layering is checked only on contract→contract `requires` edges. A skill's *consumption* is never checked against the layer it provides. Runtime providers at layer 3 therefore hard-depend on layer-5 tool contracts (shader-system→C-COOK, localization-i18n→C-COOK, material-system→C-GRAPH). determinism-replay provides layer 1 but consumes C-SER at layer 2, and ml-inference-runtime provides layer 2 but consumes C-RG at layer 3. The \"format owner vs pipeline host\" pattern makes one skill span runtime and tool code, but the data has no notion of which module side a dependency belongs to. The effect is visible in configurations. The `dedicated-server` configuration contains asset-import-interchange (FBX/USD importers) and asset-cook-processors, and shader-system requires C-RELOAD (hot reload) with no `?`, so shipping builds must include it.\n- Evidence: UE separates Runtime, Editor and Developer module types, and the shipping target refuses Developer/Editor modules. Frostbite and Decima keep their pipeline builders in separate tool binaries. A fitness function (ARCH.GOV.fitness) cannot enforce what the data does not express.\n- Proposed change: Add `consumes_tool: [...]` to the skill schema, alongside `consumes`, for dependencies used only by the cook or editor module. Move C-COOK, C-GRAPH and C-EDCMD into that list for every runtime skill. Add a `check.py` rule: every required runtime consumption must be at a layer ≤ the lowest layer the skill provides, or be listed as an explicit, justified exception. Give content-pipeline, importer and cook skills a `tooling` profile token that runtime-only closures (server, shipping) exclude. Make C-RELOAD optional in shader-system.\n\n### K-ARCH-6 · major · overlap\n- Target: RES.MGMT.streaming (resource-streaming-architect), RND.MEM.residency and RND.MEM.budget (gpu-memory-resources), RND.TEX.mip-streaming (texture-streaming-vt), RND.LOD.streaming (virtualized-geometry-lod), AUD.DSP.streaming (audio-dsp-mixing), WLD.PART.sources (world-architect), C-RES, C-GPUMEM\n- Finding: At least five skills own \"streaming budgets, priority and eviction\", and nothing arbitrates between them. C-RES requires only C-MEM (CPU). C-GPUMEM has its own residency and budget, and neither contract references the other. On UMA consoles and mobile (CORE.MEM.uma, PLAT.CON.os-memory), texture mips, cluster pages, audio banks and world cells all compete for one physical pool. Under memory pressure, each streamer will evict by its own policy and they will fight each other, because no skill owns a single cross-pool priority space.\n- Evidence: UE5 exposes separate texture/Nanite/VSM pools and needs manual pool tuning, which is a known production pain point. Spider-Man and Insomniac GDC talks, and Decima streaming (Guerrilla, GDC 2017/2018), describe a central priority system across asset types on fixed-memory consoles.\n- Proposed change: Add the capability `RES.MGMT.arbitration` (\"cross-pool residency arbitration: a single priority/deadline space across CPU, GPU and UMA, pressure signalling\") with owner resource-streaming-architect and contributors gpu-memory-resources and performance-architect. Extend C-RES with \"pool registration, pressure callbacks and priority submission\". The texture, cluster and audio streamers become *clients* that submit priorities and honour evictions. gpu-memory-resources exposes residency pressure to C-RES through a phase-mediated signal. RND.MEM.budget then becomes enforcement only.\n\n### K-ARCH-7 · major · other\n- Target: engine-architect (28 direct children), render-architect (18 children), ARCH.STRUCT.arbitration, C-ORCH\n- Finding: The arbitration topology does not scale. engine-architect is the parent and the \"final authority on boundaries\" for 11 cross-cutting skills, 14 leads, ml-inference-runtime and the two other orchestrators. render-architect alone arbitrates 18 experts and also owns C-RSCENE, which every render and environment agent needs to change. With about 120 concurrent agents, every cross-domain dispute and every C-RSCENE change is serialized through two skills. The GPU-platform experts (rhi-core, gpu-memory-resources, render-graph-scheduling, shader-system, ray-tracing-infrastructure) have different expertise and a different change rate from the feature experts, yet they share one lead.\n- Evidence: Production render teams are structured as \"render core/RHI\" plus \"render features\" (the UE RHI and RenderCore modules vs the Renderer and feature teams; Frostbite's \"FrameGraph\" platform group vs the lighting and feature groups). The principles' own split rule is \"different literatures or change at different rates.\"\n- Proposed change: Add a lead `gpu-platform-architect` under engine-architect. Move rhi-core, gpu-memory-resources, render-graph-scheduling, shader-system, ray-tracing-infrastructure and ml-inference-runtime under it, and move RND.ARCH.threading to it. render-architect keeps the pipeline, the features and C-RSCENE. Add an explicit `ARCH.ORG.escalation` capability to program-orchestration: an arbitration SLA and delegated arbitration, where a dispute inside one lead's subtree is settled by that lead and only a cross-lead dispute reaches engine-architect.\n\n### K-ARCH-8 · major · wrong-owner\n- Target: accessibility (UI.A11Y.vision, UI.A11Y.text-scale, UI.A11Y.subtitles, UI.A11Y.screen-reader), C-A11Y (layer P), runtime cycle accessibility↔input-system↔ui-architect\n- Finding: accessibility is runtime=true and owns runtime features, but provides only a *process* contract (C-A11Y, layer P). No runtime consumer can bind to its screen-reader/TTS bridge or to its subtitle service. It also owns implementations that belong to other skills' expertise:\n  - Colorblind filters are a post-process pass, but post-color-hdr is only a contributor.\n  - Text scaling is a layout-engine property of ui-architect.\n  - Subtitle presentation is a UI widget, and its timing data comes from audio-content-runtime.\n\n  This is the \"policy vs implementation\" pattern (§4), applied inconsistently. It also causes the only runtime cycle the checker reports: accessibility requires C-UI and C-INPUT, while input-system requires C-A11Y.\n- Evidence: Xbox Accessibility Guidelines and Apple/Android accessibility APIs are exposed as an *accessibility tree* exported by the UI framework, and a screen reader consumes that tree (UE Slate accessibility, Unity 2023 accessibility hierarchy). Colorblind simulation and correction ship as tonemap-stage passes.\n- Proposed change: accessibility keeps UI.A11Y.requirements, UI.A11Y.validation, UI.A11Y.assists (policy) and UI.A11Y.screen-reader (platform bridge). Add a runtime contract `C-A11YRT` (layer 3, owner accessibility): announcements, accessibility-tree ingestion and TTS/STT. It requires C-PAL and C-TEXT and does **not** require C-UI. ui-architect exports the tree into it. Move UI.A11Y.vision to post-color-hdr, UI.A11Y.text-scale to ui-architect, and subtitle presentation to ui-architect, with caption data remaining in audio-content-runtime (AUD.CONTENT.dialogue). In input-system, change `C-A11Y` to a process obligation only. The cycle disappears.\n\n### K-ARCH-9 · major · overlap\n- Target: XC.DET.replay (determinism-replay), INP.ACT.recording (input-system), NET.REP.replays (replication), ED.DEBUG.visual-log (visual-debugging-tools), ANM.GRAPH.debug \"rewind\" (animation-graphs), QA.FUNC.automation\n- Finding: Five skills own some form of record/replay/rewind, and the wording hides the overlap: \"input & state record/replay\", \"input recording & replay\", \"replay recording from the replication stream\", \"visual logger & rewind\", \"graph debugging & rewind\". There is no shared container format, timeline or versioning owner, so the result will be three or more replay formats with separate build-compatibility rules. XC.DET.compat already claims \"replay compatibility across builds\" for only one of them.\n- Evidence: UE has separate DemoNetDriver replays, Rewind Debugger and Visual Logger, and has spent years unifying their timelines (the Chaos Visual Debugger and Rewind Debugger integration). Killcams and spectating in shipped titles reuse the network replay, not a separate one.\n- Proposed change: determinism-replay owns a new capability `XC.DET.replay-format` (\"replay container, timeline, stream registration and versioning\") and provides a new contract `C-REPLAY` (layer 2). input-system, replication, visual-debugging-tools and animation-graphs become *stream producers* that register streams through C-REPLAY. Rename INP.ACT.recording to \"Input stream capture for C-REPLAY\" and NET.REP.replays to \"Replication stream capture for C-REPLAY\".\n\n### K-ARCH-10 · major · overlap\n- Target: CORE.FRAME.latency (frame-orchestration), RND.RHI.present (rhi-core), RND.RECON.framegen and RND.RECON.dynres (reconstruction-upscaling), PLAT.XR.reprojection (xr-runtime), PLAT.PAL.cloud-streaming, C-FRAME, C-RHI\n- Finding: Four skills own parts of the *present timeline* and no contract states its semantics:\n  - pacing and latency markers (frame-orchestration);\n  - swapchain, present modes and VRR (rhi-core);\n  - frame generation, which changes present cadence, latency and pacing (reconstruction-upscaling);\n  - XR reprojection and predicted display time (xr-runtime).\n\n  C-FRAME lists \"pipelining depth\", and C-RHI lists \"presentation\". Frame generation, Reflex/Anti-Lag 2, VRR and XR compositor timing must agree on a single model of which frame is presented when, and on its input sample time.\n- Evidence: DLSS Frame Generation requires Reflex integration and changes the pacing API. FSR 3 frame-gen ships its own swapchain proxy that replaces the engine's present. OpenXR xrWaitFrame/xrBeginFrame dictate frame timing. These are well-known integration conflicts when each piece is owned separately.\n- Proposed change: Add a contract `C-PRESENT` (layer 2, owner frame-orchestration): the present timeline, display-time prediction, latency markers, interposed presenters (frame gen, XR compositor, cloud encoder) and pacing policy. It requires C-FRAME and C-RHI. rhi-core, reconstruction-upscaling, xr-runtime and platform-architect (cloud) implement presenter hooks through it. Mark RND.RECON.framegen with frame-orchestration as a contributor.\n\n### K-ARCH-11 · major · missing-contract\n- Target: GAM.SYS.camera (gameplay-systems-toolkit), ANM.CINE.cameras (cinematics-sequencer), ED.WORLD.viewport (world-editor-viewport), GAM.SYS.photo, PLAT.XR (head pose), RND.POST.camera, C-RSCENE \"views\", WLD.PART.sources, AUD listener\n- Finding: The authoritative view has no owner. At least six skills produce a camera or view: gameplay, cinematic, editor, photo mode, XR head pose and split-screen. At least five consume it: renderer views, the audio listener, world streaming sources, LOD and significance, and large-world-coordinate camera-relative rebasing. No capability owns \"which view is active, blending between view sources, and view-dependent signals.\" The gameplay camera sits in a gameplay toolkit at layer 4, but editor and XR must drive views without gameplay.\n- Evidence: UE splits this into PlayerCameraManager, ViewTarget and SceneView, with the camera manager arbitrating sources. Many engines hit camera-relative precision bugs precisely where the view origin and the LWC rebase are owned separately.\n- Proposed change: Add a capability `WLD.SPACE.views` (\"view registry and arbitration: active views, view origin for LWC rebasing, listener and streaming-source derivation\") owned by spatial-transforms. Add a contract `C-VIEW` (layer 2) that requires C-SPATIAL. gameplay-systems-toolkit, cinematics-sequencer, world-editor-viewport and xr-runtime become view *sources*. render-architect (C-RSCENE views), audio-architect and world-architect (streaming sources) become view *sinks*.\n\n### K-ARCH-12 · major · dependency-error\n- Target: input-devices-haptics, input-system, C-INPUT, INP.DEV.haptics, AUD.CONTENT.haptics, PLAT.XR.input\n- Finding: The layering is inverted. The device layer (input-devices-haptics) *consumes* the action contract C-INPUT and provides nothing, while input-system consumes only C-PAL. That means device events reach input-system either through undeclared internals or by device code writing into the action layer. Haptics output (rumble, HD haptics, adaptive triggers) has no contract at all, although audio-content-runtime (audio-to-haptics), gameplay and accessibility must drive it.\n- Evidence: GameInput and SDL3 separate device state and events from action mapping, and haptics output is a device-level API. Unity's Input System separates devices and controls from actions for the same reason.\n- Proposed change: Add a contract `C-DEVICE` (layer 2, owner input-devices-haptics): device state and events with timestamps, user pairing, and haptics/force-feedback output. It requires C-PAL. input-system consumes C-DEVICE, and input-devices-haptics drops C-INPUT. audio-content-runtime, xr-runtime and gameplay-systems-toolkit consume `C-DEVICE?` for haptics.\n\n### K-ARCH-13 · major · wrong-boundary\n- Target: build-release-architect (BLD.CI.branching, BLD.CI.versioning, BLD.CI.orchestration); content-pipeline-architect, resource-streaming-architect, ui-architect, security-engineering, api-lifecycle-migration (parents of fewer than 3 experts)\n- Finding: build-release-architect provides **no contract** and consumes only its own children's contracts. Principles §2 forbids exactly this (\"a lead never exists only to coordinate\"). Its territory also overlaps other skills:\n  - BLD.CI.orchestration (\"code → content → package pipeline orchestration\") overlaps BLD.CI.pipelines (ci-cd-automation) and ARCH.ORG.integration (program-orchestration).\n  - BLD.CI.versioning overlaps XC.EXT.versioning and XC.EXT.lts (api-lifecycle-migration).\n\n  Separately, five parents break the stated rule \"a lead exists only where a domain has at least three experts\": content-pipeline-architect has 2, resource-streaming-architect 2, ui-architect 2, security-engineering 1 and api-lifecycle-migration 2. So the rule the hierarchy claims is not the rule it follows.\n- Proposed change: Give build-release-architect a contract `C-RELEASE` (layer P): the branch model, release trains, version identifiers, and client/server/content compatibility keys. Its consumers are packaging-release-patching, api-lifecycle-migration, collaboration-version-control and network-architect (NET.ARCH.versioning). Move BLD.CI.orchestration to ci-cd-automation. Either restate the lead rule as \"≥3 experts **or** owns a layer-defining contract\" and record the exceptions, or merge ui-architect's children rule with render-2d-vector coupling explicitly.\n\n### K-ARCH-14 · major · wrong-boundary\n- Target: ray-tracing-infrastructure (profile aaa), RND.RT.software, RND.GI.sdf, path-tracing (profile aaa), QA.RENDER.reference, global-illumination\n- Finding: The owner of RND.RT.software, the software ray-tracing fallback that exists *for* hardware without RT, is present only in the `aaa` profile. So `standard-3d` and `mobile-3d` have no software RT, and SDF tracing sits in global-illumination with RT infra as contributor. The fallback path is absent exactly where it is needed. The same applies to path-tracing, which is QA.RENDER.reference's ground-truth oracle: it is aaa-only, so the validation oracle is missing from every non-aaa 3D configuration. Hardware RT itself (RND.RT.as and others, all marked E) is profile-gated to aaa despite shipping in mainstream PC and console titles.\n- Evidence: Lumen's software path (mesh SDF plus global SDF) is the default on non-RT hardware. HW RT is baseline on PS5, Xbox Series and all current desktop GPUs. Reference path tracers are used for validation regardless of the shipping feature set (UE Path Tracer, Frostbite and Activision reference renderers).\n- Proposed change: Move RND.RT.software to global-illumination, which is profile mobile3d,std3d and already owns RND.GI.sdf. Change the ray-tracing-infrastructure profile to `std3d` (consumers already use `C-RT?`). Split path-tracing so that RND.PT.reference is owned by render-validation, or tag it `std3d` with RND.PT.realtime kept aaa-gated.\n\n### K-ARCH-15 · major · omission\n- Target: capability map (no owner exists); candidates audio-dsp-mixing, render-2d-vector, cinematics-sequencer\n- Finding: The capability map has no video playback capability: hardware and software video decode (AV1/H.264/HEVC, Bink class), A/V sync with the audio clock, video as textures for UI, world or cutscenes, and platform DRM surfaces. Every configuration from indie-2d to AAA ships intro movies, prerendered cutscenes or in-world screens. Video playback spans the IO, GPU upload, audio clock and frame pacing boundaries, so leaving it unowned invites four agents to build fragments of it.\n- Evidence: Bink 2 and platform media APIs are integrated in most shipped engines, for example UE Media Framework/Electra and Unity VideoPlayer. Console TRCs include requirements on skippable, stable-rate movie playback.\n- Proposed change: Add an area `RND.MEDIA` with capabilities `RND.MEDIA.decode` (HW/SW decode backends, M/E), `RND.MEDIA.sync` (A/V sync against the audio clock) and `RND.MEDIA.surfaces` (video textures for UI, world and cinematics). Assign the owner as a new small expert `media-playback` under render-architect, or under gpu-platform-architect if K-ARCH-7 is adopted. It consumes C-IO, C-GPUMEM, C-AUDIO and C-FRAME, and its profile is `client`.\n\n### K-ARCH-16 · major · other\n- Target: program-orchestration (ARCH.ORG.*), C-FRAME phase list, RND.ARCH.feature-contract, C-CFG cvar registry, CORE.LIFE.modules, C-RSCENE\n- Finding: The ownership ledger is territory-based. The highest-contention artefacts are *shared registration points* that every agent must edit: the frame phase list (every runtime skill adds phases), the render feature registry, module and service registration, cvar namespaces, reflection codegen inputs and shader interop headers. No capability states that these must be declarative, per-skill extension points rather than central tables. If they are not, every contract change request to C-FRAME or C-RSCENE blocks dozens of agents, and merge conflicts land on the orchestrator.\n- Evidence: Large engine codebases (UE modules and subsystems, Bevy plugins and schedules) avoid central edit points by letting each module self-register into phases and sets with ordering constraints. That is what allows parallel teams to work without lock-step edits.\n- Proposed change: Add a capability `ARCH.STRUCT.registration` (\"declarative self-registration for phases, render features, services, cvars and codegen inputs; no central tables\") owned by engine-architect, with contributors frame-orchestration and render-architect. Add a fitness function (ARCH.GOV.fitness) that rejects edits to another skill's registration file. Extend C-FRAME's summary with \"phase registration with ordering constraints (before/after/in-set)\".\n\n### K-ARCH-17 · minor · wrong-boundary\n- Target: ml-inference-runtime (parent engine-architect, profile aaa), ML.RT.scheduling, C-ML\n- Finding: The shared inference runtime is an orphan expert with no lead. It is restricted to `aaa` even though its consumers (texture-streaming-vt, reconstruction-upscaling, deformation-skinning) are in mobile3d and std3d. Engine-owned inference on mobile NPUs and consoles, such as neural upscaling or ML deformers, is therefore unavailable outside aaa. Its GPU scheduling depends on C-RG, so GPU time arbitration belongs with the GPU scheduler, not with engine-architect.\n- Proposed change: Parent ml-inference-runtime under gpu-platform-architect (see K-ARCH-7) or render-architect. Change its profiles to `mobile3d,std3d,server`. Make C-RG optional in its consumes list (see K-ARCH-1(c)).\n\n### K-ARCH-18 · minor · overlap\n- Target: CORE.OBJ.events (entity-object-model) vs GAM.SYS.messages (gameplay-systems-toolkit); UI.FW.architecture \"immediate for dev UI\" (ui-architect) vs ED.UI.imgui (editor-ui-framework)\n- Finding: There are two hidden overlaps. (a) \"Events, messaging & inter-system communication\" and \"tag-scoped gameplay message routing\" are both message buses, and neither states that one is built on the other. (b) ui-architect's architecture capability claims the immediate-mode developer UI decision, while editor-ui-framework owns the immediate-mode developer UI itself.\n- Proposed change: Rename GAM.SYS.messages to \"Gameplay-tag message channels built on C-ID events\" and add entity-object-model as a contributor. Restrict UI.FW.architecture to \"game UI architecture (retained + data binding)\". ED.UI.imgui stays with editor-ui-framework, which becomes the sole owner of developer UI.\n\n### K-ARCH-19 · minor · wrong-owner\n- Target: CORE.ECS.baking (ecs-runtime), WLD.MODEL.document (world-data-model), WLD.PART.grid (world-architect), CNT.COOK.architecture\n- Finding: No capability owns cooking a world document into runtime streaming-cell data (partition assignment, cell packaging, HLOD inputs, baked ECS chunks). Under the stated format-owner pattern it should belong to the owner of the cell format, but the only baking capability is ECS-generic and sits with ecs-runtime.\n- Proposed change: Add the capability `WLD.PART.cook` (\"world → streaming-cell cook step under C-COOK\") owned by world-architect, with contributors ecs-runtime (entity chunk baking) and world-data-model.\n\n### K-ARCH-20 · minor · other\n- Target: non_responsibilities of cpu-performance (\"Owning subsystem code → engine-architect\"), gameplay-architect (\"Game-specific code → engine-architect\"), hot-reload-iteration (\"Each system's own reload implementation → resource-streaming-architect\"), ml-inference-runtime (\"Neural feature design (texture, material, animation) → texture-streaming-vt\"), render-architect (\"Individual features → global-illumination\"), graph-editor-framework (\"Each domain's graph semantics → material-system\")\n- Finding: The schema allows a single redirect target per non-responsibility. As a result, several entries route agents to the wrong owner. Subsystem code is not engine-architect's, shader reload is not resource-streaming's, and animation ML features are not texture-streaming's. Others route to an out-of-engine party (the game team) through engine-architect. Agents use these entries to decide where to send work, so the misrouting becomes wrong change requests.\n- Proposed change: Allow `[text, [owners...]]` or a sentinel target such as `\"owning-skill\"` or `\"out-of-scope\"`, and fix the six entries listed. Add a `check.py` rule that the redirect target owns at least one capability whose name matches the text's domain, or is a declared sentinel.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1068,"cache_read_input_tokens":138377,"output_tokens":14902,"output_tokens_details":{"thinking_tokens":2513},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1068},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":14902,"cache_read_input_tokens":138377,"cache_creation_input_tokens":1068,"cache_creation":{"ephemeral_5m_input_tokens":1068,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01KzxRJCkfbHSxtz46z8R8LN":{"file_path":"/home/user/skills/engine-skill-framework/gauntlet/round-1/K-ARCH.md","content":"# K-ARCH · Engine Architecture Critic · Round 1\n\nScope: architectural completeness and subsystem boundaries. Findings are ordered most severe first. The structural checker (`check.py`) passes with 0 errors. Every finding below is something it cannot see. Where a finding cites a configuration closure, it was computed with `scripts/model.py`, using the same membership and closure rules as `check.py`.\n\n### K-ARCH-1 · blocker · scale-down\n- Target: terrain, water-ocean, vegetation-foliage, destruction-fracture, fluid-simulation, facial-animation, ml-inference-runtime; configurations `dedicated-server`, `aaa-open-world-online`; WLD.PART.server\n- Finding: The server side of the flagship configuration cannot be built. The only server configuration is `[server, online]`, which contains no open-world skill. The configurations `[server, online, openworld]` and `[server, online, openworld, aaa]` are **not closed**. For the first, closure fails on terrain→C-RSCENE/C-MATIF, vegetation-foliage→C-RSCENE and water-ocean→C-RSCENE/C-RG. The aaa variant adds failures for destruction-fracture→C-RSCENE, fluid-simulation→C-RG, facial-animation→C-AUDIO, ml-inference-runtime→C-RHI/C-RG and others. The cause is the \"end-to-end feature ownership\" pattern (principles §4) combined with *required* render contracts. The skills that own authoritative simulation data (heightfields for collision and navmesh, water height and flow for buoyancy, fracture state for replication) can only exist alongside a renderer. WLD.PART.server (\"server-side world streaming\") therefore has nothing to stream on the server.\n- Evidence: Authoritative open-world servers need terrain collision, water queries and destruction state without a GPU. UE dedicated servers strip rendering but keep Landscape collision and Chaos destruction. MMO and survival servers work the same way. C-ML requires C-RHI, which also makes CPU inference for server-side AI (GAM.AI.learned) impossible.\n- Proposed change: (a) Add a contract `C-ENV` (layer 3, owner world-architect): environment data and queries covering height, surface type, water height and velocity, and deformation deltas. It requires C-WORLD and C-SPATIAL. terrain, water-ocean and vegetation-foliage implement it, and collision-detection, navigation-pathfinding, character-vehicle-physics and spatial-audio consume it. (b) Mark C-RSCENE, C-MATIF and C-RG as optional (`?`) in terrain, water-ocean, vegetation-foliage, destruction-fracture and fluid-simulation, and require each SKILL.md to define a headless mode. (c) Make C-ML require `C-RHI?` so that inference has a CPU-only path. (d) Add the configurations `open-world-server` = [server, online, openworld] and `aaa-server` = [server, online, openworld, aaa], so that `check.py` proves them closed.\n\n### K-ARCH-2 · blocker · missing-contract\n- Target: gpu-driven-pipeline, virtualized-geometry-lod, texture-streaming-vt, direct-lighting-shadows, global-illumination, render-architect (C-RSCENE)\n- Finding: 18 render experts sit under one lead, and 12 of them provide **no contract**. Yet their data is consumed across features:\n  - The GPU scene, instance buffers and HZB/culling results (gpu-driven-pipeline) are needed by VSM (direct-lighting-shadows), RT instance management (ray-tracing-infrastructure), GI surface caches and vegetation.\n  - Cluster/LOD selection (virtualized-geometry-lod) is needed by RND.RT.lod, RND.RT.cluster-blas, VSM page rendering and deforming LOD.\n  - The VT page table and feedback (texture-streaming-vt) are needed by terrain (\"Virtual texturing core → texture-streaming-vt\") and material-system.\n  - The light grid and shadow sampling (direct-lighting-shadows) are needed by translucency-decals, atmosphere (volumetric fog), water and VFX.\n  - GI/radiance-cache sampling is needed by translucency, water, VFX and hair.\n\n  The only channel for all of this is C-RSCENE, which the lead owns. Either agents reach into each other's internals, or C-RSCENE becomes an unbounded grab bag that every render agent edits. There is also an overlap. RND.ARCH.scene-sync (\"render scene representation\", owned by render-architect) and RND.GEO.gpu-scene (\"GPU scene & instance data\", owned by gpu-driven-pipeline) describe the same data structure in a GPU-driven renderer.\n- Evidence: UE5's GPUScene, Nanite and VSM interplay is a set of explicit interfaces (VSM renders through Nanite's cluster culling, and Lumen consumes mesh SDF and surface cache data). Frostbite and Decima GPU-driven talks (Wihlidal, GDC 2016; Haar/Aaltonen, SIGGRAPH 2015) treat instance data and culling output as shared producer/consumer interfaces.\n- Proposed change: Add layer-3 contracts:\n  - `C-GPUSCENE`, owned by gpu-driven-pipeline: instance data layout, culling output and HZB. Move RND.ARCH.scene-sync's GPU half into it. render-architect keeps only the CPU proxy registry and the sync protocol.\n  - `C-GEOLOD`, owned by virtualized-geometry-lod: cluster/LOD selection and page residency for raster, shadow and RT consumers.\n  - `C-VT`, owned by texture-streaming-vt: page tables, feedback and VT allocation for terrain and materials.\n  - `C-LIGHTS`, owned by direct-lighting-shadows: light lists, clustered grid and shadow sampling.\n  - `C-GISAMPLE`, owned by global-illumination: an irradiance/radiance query interface for forward, translucent and volumetric consumers.\n\n  Update the consumers' `consumes` lists to match.\n\n### K-ARCH-3 · major · wrong-boundary\n- Target: C-SPATIAL, C-PHYS, C-ANIM, C-AUDIO, C-NET, C-GAME (requires C-ECS); render-architect, audio-architect, world-architect, network-architect (consume C-ECS)\n- Finding: ECS is a hard build-level prerequisite of the transform contract and of every subsystem contract. This contradicts the stated default in §6: a \"hybrid object model; not ECS for everything\", with CORE.OBJ.hybrid owned by entity-object-model. It also contradicts the replaceability claim (\"C-PHYS can be served by an integrated middleware\"), because the contract itself is shaped by ECS component access. Contracts that declare \"components, queries, command buffers\" as a dependency leak the object-model internals into physics, audio and network APIs. As specified, an agent implementing C-SPATIAL or C-PHYS will write ECS systems by default. That is the dogmatic-ECS failure the brief forbids, arrived at by the dependency graph rather than by an ADR.\n- Evidence: Jolt, PhysX and Havok own their body storage and are bridged to ECS by adapter systems (Unity Physics/Havok in DOTS, UE Mass↔Chaos). Wwise and FMOD are object/emitter-ID based. Replication in UE Iris is keyed by NetRefHandle and is not tied to one object model.\n- Proposed change: Change `requires` as follows:\n  - C-SPATIAL → [C-MATH, C-ID]\n  - C-PHYS → [C-SPATIAL, C-FRAME, C-ID]\n  - C-ANIM → [C-SPATIAL, C-ID]\n  - C-AUDIO → [C-SPATIAL, C-ID]\n  - C-NET → [C-ID, C-SER, C-FRAME]\n  - C-GAME → [C-ID, C-FRAME, C-WORLD]\n\n  Make C-ECS optional (`C-ECS?`) in render-architect, audio-architect, physics-architect, animation-architect, network-architect, world-architect and spatial-transforms. Add a capability `CORE.ECS.bridges` (\"ECS↔subsystem adapter systems and sync points\") owned by ecs-runtime, with the subsystem leads as contributors. entity-object-model's hybrid policy then decides *per configuration* whether ECS is the host.\n\n### K-ARCH-4 · major · missing-contract\n- Target: prediction-rollback (NET.PRED.rollback, NET.PRED.lagcomp), physics-architect (C-PHYS), animation-architect (C-ANIM), ecs-runtime, determinism-replay (C-DET)\n- Finding: Rollback and resimulation need every participating subsystem to snapshot, restore and re-step N frames in a single frame. Lag compensation also needs historical collision state. No contract carries this obligation. C-PHYS is \"bodies, shapes, queries, contact events, stepping phases\", C-DET is \"state-hash hooks\", and C-SAVE is save-game granularity. prediction-rollback cannot reach this capability without modifying the physics, animation and ECS internals.\n- Evidence: GGPO-class rollback requires save/load/advance callbacks per subsystem. UE's Network Prediction plugin and Chaos resim cache, Photon Quantum and Overwatch's ECS rollback (Ford, GDC 2017) all make snapshot and restore an explicit subsystem interface. Box2D v3 and Jolt state recorders exist for this reason.\n- Proposed change: Add a contract `C-SNAPSHOT` (layer 2, owner determinism-replay): frame-state snapshot, restore, resimulate, history ring and cost declaration. It requires C-FRAME and C-SER. physics-architect, animation-architect, ecs-runtime and gameplay-architect implement it. prediction-rollback and replication (NET.REP.replays) consume it. Add the capability `XC.DET.snapshot` with owner determinism-replay.\n\n### K-ARCH-5 · major · dependency-error\n- Target: shader-system, localization-i18n (consume C-COOK layer 5), material-system (consumes C-GRAPH layer 5), texture-streaming-vt, virtualized-geometry-lod, content-pipeline-architect (runtime=true), shader-system (requires C-RELOAD); configuration `dedicated-server`\n- Finding: Layering is checked only on contract→contract `requires` edges. A skill's *consumption* is never checked against the layer it provides. Runtime providers at layer 3 therefore hard-depend on layer-5 tool contracts (shader-system→C-COOK, localization-i18n→C-COOK, material-system→C-GRAPH). determinism-replay provides layer 1 but consumes C-SER at layer 2, and ml-inference-runtime provides layer 2 but consumes C-RG at layer 3. The \"format owner vs pipeline host\" pattern makes one skill span runtime and tool code, but the data has no notion of which module side a dependency belongs to. The effect is visible in configurations. The `dedicated-server` configuration contains asset-import-interchange (FBX/USD importers) and asset-cook-processors, and shader-system requires C-RELOAD (hot reload) with no `?`, so shipping builds must include it.\n- Evidence: UE separates Runtime, Editor and Developer module types, and the shipping target refuses Developer/Editor modules. Frostbite and Decima keep their pipeline builders in separate tool binaries. A fitness function (ARCH.GOV.fitness) cannot enforce what the data does not express.\n- Proposed change: Add `consumes_tool: [...]` to the skill schema, alongside `consumes`, for dependencies used only by the cook or editor module. Move C-COOK, C-GRAPH and C-EDCMD into that list for every runtime skill. Add a `check.py` rule: every required runtime consumption must be at a layer ≤ the lowest layer the skill provides, or be listed as an explicit, justified exception. Give content-pipeline, importer and cook skills a `tooling` profile token that runtime-only closures (server, shipping) exclude. Make C-RELOAD optional in shader-system.\n\n### K-ARCH-6 · major · overlap\n- Target: RES.MGMT.streaming (resource-streaming-architect), RND.MEM.residency and RND.MEM.budget (gpu-memory-resources), RND.TEX.mip-streaming (texture-streaming-vt), RND.LOD.streaming (virtualized-geometry-lod), AUD.DSP.streaming (audio-dsp-mixing), WLD.PART.sources (world-architect), C-RES, C-GPUMEM\n- Finding: At least five skills own \"streaming budgets, priority and eviction\", and nothing arbitrates between them. C-RES requires only C-MEM (CPU). C-GPUMEM has its own residency and budget, and neither contract references the other. On UMA consoles and mobile (CORE.MEM.uma, PLAT.CON.os-memory), texture mips, cluster pages, audio banks and world cells all compete for one physical pool. Under memory pressure, each streamer will evict by its own policy and they will fight each other, because no skill owns a single cross-pool priority space.\n- Evidence: UE5 exposes separate texture/Nanite/VSM pools and needs manual pool tuning, which is a known production pain point. Spider-Man and Insomniac GDC talks, and Decima streaming (Guerrilla, GDC 2017/2018), describe a central priority system across asset types on fixed-memory consoles.\n- Proposed change: Add the capability `RES.MGMT.arbitration` (\"cross-pool residency arbitration: a single priority/deadline space across CPU, GPU and UMA, pressure signalling\") with owner resource-streaming-architect and contributors gpu-memory-resources and performance-architect. Extend C-RES with \"pool registration, pressure callbacks and priority submission\". The texture, cluster and audio streamers become *clients* that submit priorities and honour evictions. gpu-memory-resources exposes residency pressure to C-RES through a phase-mediated signal. RND.MEM.budget then becomes enforcement only.\n\n### K-ARCH-7 · major · other\n- Target: engine-architect (28 direct children), render-architect (18 children), ARCH.STRUCT.arbitration, C-ORCH\n- Finding: The arbitration topology does not scale. engine-architect is the parent and the \"final authority on boundaries\" for 11 cross-cutting skills, 14 leads, ml-inference-runtime and the two other orchestrators. render-architect alone arbitrates 18 experts and also owns C-RSCENE, which every render and environment agent needs to change. With about 120 concurrent agents, every cross-domain dispute and every C-RSCENE change is serialized through two skills. The GPU-platform experts (rhi-core, gpu-memory-resources, render-graph-scheduling, shader-system, ray-tracing-infrastructure) have different expertise and a different change rate from the feature experts, yet they share one lead.\n- Evidence: Production render teams are structured as \"render core/RHI\" plus \"render features\" (the UE RHI and RenderCore modules vs the Renderer and feature teams; Frostbite's \"FrameGraph\" platform group vs the lighting and feature groups). The principles' own split rule is \"different literatures or change at different rates.\"\n- Proposed change: Add a lead `gpu-platform-architect` under engine-architect. Move rhi-core, gpu-memory-resources, render-graph-scheduling, shader-system, ray-tracing-infrastructure and ml-inference-runtime under it, and move RND.ARCH.threading to it. render-architect keeps the pipeline, the features and C-RSCENE. Add an explicit `ARCH.ORG.escalation` capability to program-orchestration: an arbitration SLA and delegated arbitration, where a dispute inside one lead's subtree is settled by that lead and only a cross-lead dispute reaches engine-architect.\n\n### K-ARCH-8 · major · wrong-owner\n- Target: accessibility (UI.A11Y.vision, UI.A11Y.text-scale, UI.A11Y.subtitles, UI.A11Y.screen-reader), C-A11Y (layer P), runtime cycle accessibility↔input-system↔ui-architect\n- Finding: accessibility is runtime=true and owns runtime features, but provides only a *process* contract (C-A11Y, layer P). No runtime consumer can bind to its screen-reader/TTS bridge or to its subtitle service. It also owns implementations that belong to other skills' expertise:\n  - Colorblind filters are a post-process pass, but post-color-hdr is only a contributor.\n  - Text scaling is a layout-engine property of ui-architect.\n  - Subtitle presentation is a UI widget, and its timing data comes from audio-content-runtime.\n\n  This is the \"policy vs implementation\" pattern (§4), applied inconsistently. It also causes the only runtime cycle the checker reports: accessibility requires C-UI and C-INPUT, while input-system requires C-A11Y.\n- Evidence: Xbox Accessibility Guidelines and Apple/Android accessibility APIs are exposed as an *accessibility tree* exported by the UI framework, and a screen reader consumes that tree (UE Slate accessibility, Unity 2023 accessibility hierarchy). Colorblind simulation and correction ship as tonemap-stage passes.\n- Proposed change: accessibility keeps UI.A11Y.requirements, UI.A11Y.validation, UI.A11Y.assists (policy) and UI.A11Y.screen-reader (platform bridge). Add a runtime contract `C-A11YRT` (layer 3, owner accessibility): announcements, accessibility-tree ingestion and TTS/STT. It requires C-PAL and C-TEXT and does **not** require C-UI. ui-architect exports the tree into it. Move UI.A11Y.vision to post-color-hdr, UI.A11Y.text-scale to ui-architect, and subtitle presentation to ui-architect, with caption data remaining in audio-content-runtime (AUD.CONTENT.dialogue). In input-system, change `C-A11Y` to a process obligation only. The cycle disappears.\n\n### K-ARCH-9 · major · overlap\n- Target: XC.DET.replay (determinism-replay), INP.ACT.recording (input-system), NET.REP.replays (replication), ED.DEBUG.visual-log (visual-debugging-tools), ANM.GRAPH.debug \"rewind\" (animation-graphs), QA.FUNC.automation\n- Finding: Five skills own some form of record/replay/rewind, and the wording hides the overlap: \"input & state record/replay\", \"input recording & replay\", \"replay recording from the replication stream\", \"visual logger & rewind\", \"graph debugging & rewind\". There is no shared container format, timeline or versioning owner, so the result will be three or more replay formats with separate build-compatibility rules. XC.DET.compat already claims \"replay compatibility across builds\" for only one of them.\n- Evidence: UE has separate DemoNetDriver replays, Rewind Debugger and Visual Logger, and has spent years unifying their timelines (the Chaos Visual Debugger and Rewind Debugger integration). Killcams and spectating in shipped titles reuse the network replay, not a separate one.\n- Proposed change: determinism-replay owns a new capability `XC.DET.replay-format` (\"replay container, timeline, stream registration and versioning\") and provides a new contract `C-REPLAY` (layer 2). input-system, replication, visual-debugging-tools and animation-graphs become *stream producers* that register streams through C-REPLAY. Rename INP.ACT.recording to \"Input stream capture for C-REPLAY\" and NET.REP.replays to \"Replication stream capture for C-REPLAY\".\n\n### K-ARCH-10 · major · overlap\n- Target: CORE.FRAME.latency (frame-orchestration), RND.RHI.present (rhi-core), RND.RECON.framegen and RND.RECON.dynres (reconstruction-upscaling), PLAT.XR.reprojection (xr-runtime), PLAT.PAL.cloud-streaming, C-FRAME, C-RHI\n- Finding: Four skills own parts of the *present timeline* and no contract states its semantics:\n  - pacing and latency markers (frame-orchestration);\n  - swapchain, present modes and VRR (rhi-core);\n  - frame generation, which changes present cadence, latency and pacing (reconstruction-upscaling);\n  - XR reprojection and predicted display time (xr-runtime).\n\n  C-FRAME lists \"pipelining depth\", and C-RHI lists \"presentation\". Frame generation, Reflex/Anti-Lag 2, VRR and XR compositor timing must agree on a single model of which frame is presented when, and on its input sample time.\n- Evidence: DLSS Frame Generation requires Reflex integration and changes the pacing API. FSR 3 frame-gen ships its own swapchain proxy that replaces the engine's present. OpenXR xrWaitFrame/xrBeginFrame dictate frame timing. These are well-known integration conflicts when each piece is owned separately.\n- Proposed change: Add a contract `C-PRESENT` (layer 2, owner frame-orchestration): the present timeline, display-time prediction, latency markers, interposed presenters (frame gen, XR compositor, cloud encoder) and pacing policy. It requires C-FRAME and C-RHI. rhi-core, reconstruction-upscaling, xr-runtime and platform-architect (cloud) implement presenter hooks through it. Mark RND.RECON.framegen with frame-orchestration as a contributor.\n\n### K-ARCH-11 · major · missing-contract\n- Target: GAM.SYS.camera (gameplay-systems-toolkit), ANM.CINE.cameras (cinematics-sequencer), ED.WORLD.viewport (world-editor-viewport), GAM.SYS.photo, PLAT.XR (head pose), RND.POST.camera, C-RSCENE \"views\", WLD.PART.sources, AUD listener\n- Finding: The authoritative view has no owner. At least six skills produce a camera or view: gameplay, cinematic, editor, photo mode, XR head pose and split-screen. At least five consume it: renderer views, the audio listener, world streaming sources, LOD and significance, and large-world-coordinate camera-relative rebasing. No capability owns \"which view is active, blending between view sources, and view-dependent signals.\" The gameplay camera sits in a gameplay toolkit at layer 4, but editor and XR must drive views without gameplay.\n- Evidence: UE splits this into PlayerCameraManager, ViewTarget and SceneView, with the camera manager arbitrating sources. Many engines hit camera-relative precision bugs precisely where the view origin and the LWC rebase are owned separately.\n- Proposed change: Add a capability `WLD.SPACE.views` (\"view registry and arbitration: active views, view origin for LWC rebasing, listener and streaming-source derivation\") owned by spatial-transforms. Add a contract `C-VIEW` (layer 2) that requires C-SPATIAL. gameplay-systems-toolkit, cinematics-sequencer, world-editor-viewport and xr-runtime become view *sources*. render-architect (C-RSCENE views), audio-architect and world-architect (streaming sources) become view *sinks*.\n\n### K-ARCH-12 · major · dependency-error\n- Target: input-devices-haptics, input-system, C-INPUT, INP.DEV.haptics, AUD.CONTENT.haptics, PLAT.XR.input\n- Finding: The layering is inverted. The device layer (input-devices-haptics) *consumes* the action contract C-INPUT and provides nothing, while input-system consumes only C-PAL. That means device events reach input-system either through undeclared internals or by device code writing into the action layer. Haptics output (rumble, HD haptics, adaptive triggers) has no contract at all, although audio-content-runtime (audio-to-haptics), gameplay and accessibility must drive it.\n- Evidence: GameInput and SDL3 separate device state and events from action mapping, and haptics output is a device-level API. Unity's Input System separates devices and controls from actions for the same reason.\n- Proposed change: Add a contract `C-DEVICE` (layer 2, owner input-devices-haptics): device state and events with timestamps, user pairing, and haptics/force-feedback output. It requires C-PAL. input-system consumes C-DEVICE, and input-devices-haptics drops C-INPUT. audio-content-runtime, xr-runtime and gameplay-systems-toolkit consume `C-DEVICE?` for haptics.\n\n### K-ARCH-13 · major · wrong-boundary\n- Target: build-release-architect (BLD.CI.branching, BLD.CI.versioning, BLD.CI.orchestration); content-pipeline-architect, resource-streaming-architect, ui-architect, security-engineering, api-lifecycle-migration (parents of fewer than 3 experts)\n- Finding: build-release-architect provides **no contract** and consumes only its own children's contracts. Principles §2 forbids exactly this (\"a lead never exists only to coordinate\"). Its territory also overlaps other skills:\n  - BLD.CI.orchestration (\"code → content → package pipeline orchestration\") overlaps BLD.CI.pipelines (ci-cd-automation) and ARCH.ORG.integration (program-orchestration).\n  - BLD.CI.versioning overlaps XC.EXT.versioning and XC.EXT.lts (api-lifecycle-migration).\n\n  Separately, five parents break the stated rule \"a lead exists only where a domain has at least three experts\": content-pipeline-architect has 2, resource-streaming-architect 2, ui-architect 2, security-engineering 1 and api-lifecycle-migration 2. So the rule the hierarchy claims is not the rule it follows.\n- Proposed change: Give build-release-architect a contract `C-RELEASE` (layer P): the branch model, release trains, version identifiers, and client/server/content compatibility keys. Its consumers are packaging-release-patching, api-lifecycle-migration, collaboration-version-control and network-architect (NET.ARCH.versioning). Move BLD.CI.orchestration to ci-cd-automation. Either restate the lead rule as \"≥3 experts **or** owns a layer-defining contract\" and record the exceptions, or merge ui-architect's children rule with render-2d-vector coupling explicitly.\n\n### K-ARCH-14 · major · wrong-boundary\n- Target: ray-tracing-infrastructure (profile aaa), RND.RT.software, RND.GI.sdf, path-tracing (profile aaa), QA.RENDER.reference, global-illumination\n- Finding: The owner of RND.RT.software, the software ray-tracing fallback that exists *for* hardware without RT, is present only in the `aaa` profile. So `standard-3d` and `mobile-3d` have no software RT, and SDF tracing sits in global-illumination with RT infra as contributor. The fallback path is absent exactly where it is needed. The same applies to path-tracing, which is QA.RENDER.reference's ground-truth oracle: it is aaa-only, so the validation oracle is missing from every non-aaa 3D configuration. Hardware RT itself (RND.RT.as and others, all marked E) is profile-gated to aaa despite shipping in mainstream PC and console titles.\n- Evidence: Lumen's software path (mesh SDF plus global SDF) is the default on non-RT hardware. HW RT is baseline on PS5, Xbox Series and all current desktop GPUs. Reference path tracers are used for validation regardless of the shipping feature set (UE Path Tracer, Frostbite and Activision reference renderers).\n- Proposed change: Move RND.RT.software to global-illumination, which is profile mobile3d,std3d and already owns RND.GI.sdf. Change the ray-tracing-infrastructure profile to `std3d` (consumers already use `C-RT?`). Split path-tracing so that RND.PT.reference is owned by render-validation, or tag it `std3d` with RND.PT.realtime kept aaa-gated.\n\n### K-ARCH-15 · major · omission\n- Target: capability map (no owner exists); candidates audio-dsp-mixing, render-2d-vector, cinematics-sequencer\n- Finding: The capability map has no video playback capability: hardware and software video decode (AV1/H.264/HEVC, Bink class), A/V sync with the audio clock, video as textures for UI, world or cutscenes, and platform DRM surfaces. Every configuration from indie-2d to AAA ships intro movies, prerendered cutscenes or in-world screens. Video playback spans the IO, GPU upload, audio clock and frame pacing boundaries, so leaving it unowned invites four agents to build fragments of it.\n- Evidence: Bink 2 and platform media APIs are integrated in most shipped engines, for example UE Media Framework/Electra and Unity VideoPlayer. Console TRCs include requirements on skippable, stable-rate movie playback.\n- Proposed change: Add an area `RND.MEDIA` with capabilities `RND.MEDIA.decode` (HW/SW decode backends, M/E), `RND.MEDIA.sync` (A/V sync against the audio clock) and `RND.MEDIA.surfaces` (video textures for UI, world and cinematics). Assign the owner as a new small expert `media-playback` under render-architect, or under gpu-platform-architect if K-ARCH-7 is adopted. It consumes C-IO, C-GPUMEM, C-AUDIO and C-FRAME, and its profile is `client`.\n\n### K-ARCH-16 · major · other\n- Target: program-orchestration (ARCH.ORG.*), C-FRAME phase list, RND.ARCH.feature-contract, C-CFG cvar registry, CORE.LIFE.modules, C-RSCENE\n- Finding: The ownership ledger is territory-based. The highest-contention artefacts are *shared registration points* that every agent must edit: the frame phase list (every runtime skill adds phases), the render feature registry, module and service registration, cvar namespaces, reflection codegen inputs and shader interop headers. No capability states that these must be declarative, per-skill extension points rather than central tables. If they are not, every contract change request to C-FRAME or C-RSCENE blocks dozens of agents, and merge conflicts land on the orchestrator.\n- Evidence: Large engine codebases (UE modules and subsystems, Bevy plugins and schedules) avoid central edit points by letting each module self-register into phases and sets with ordering constraints. That is what allows parallel teams to work without lock-step edits.\n- Proposed change: Add a capability `ARCH.STRUCT.registration` (\"declarative self-registration for phases, render features, services, cvars and codegen inputs; no central tables\") owned by engine-architect, with contributors frame-orchestration and render-architect. Add a fitness function (ARCH.GOV.fitness) that rejects edits to another skill's registration file. Extend C-FRAME's summary with \"phase registration with ordering constraints (before/after/in-set)\".\n\n### K-ARCH-17 · minor · wrong-boundary\n- Target: ml-inference-runtime (parent engine-architect, profile aaa), ML.RT.scheduling, C-ML\n- Finding: The shared inference runtime is an orphan expert with no lead. It is restricted to `aaa` even though its consumers (texture-streaming-vt, reconstruction-upscaling, deformation-skinning) are in mobile3d and std3d. Engine-owned inference on mobile NPUs and consoles, such as neural upscaling or ML deformers, is therefore unavailable outside aaa. Its GPU scheduling depends on C-RG, so GPU time arbitration belongs with the GPU scheduler, not with engine-architect.\n- Proposed change: Parent ml-inference-runtime under gpu-platform-architect (see K-ARCH-7) or render-architect. Change its profiles to `mobile3d,std3d,server`. Make C-RG optional in its consumes list (see K-ARCH-1(c)).\n\n### K-ARCH-18 · minor · overlap\n- Target: CORE.OBJ.events (entity-object-model) vs GAM.SYS.messages (gameplay-systems-toolkit); UI.FW.architecture \"immediate for dev UI\" (ui-architect) vs ED.UI.imgui (editor-ui-framework)\n- Finding: There are two hidden overlaps. (a) \"Events, messaging & inter-system communication\" and \"tag-scoped gameplay message routing\" are both message buses, and neither states that one is built on the other. (b) ui-architect's architecture capability claims the immediate-mode developer UI decision, while editor-ui-framework owns the immediate-mode developer UI itself.\n- Proposed change: Rename GAM.SYS.messages to \"Gameplay-tag message channels built on C-ID events\" and add entity-object-model as a contributor. Restrict UI.FW.architecture to \"game UI architecture (retained + data binding)\". ED.UI.imgui stays with editor-ui-framework, which becomes the sole owner of developer UI.\n\n### K-ARCH-19 · minor · wrong-owner\n- Target: CORE.ECS.baking (ecs-runtime), WLD.MODEL.document (world-data-model), WLD.PART.grid (world-architect), CNT.COOK.architecture\n- Finding: No capability owns cooking a world document into runtime streaming-cell data (partition assignment, cell packaging, HLOD inputs, baked ECS chunks). Under the stated format-owner pattern it should belong to the owner of the cell format, but the only baking capability is ECS-generic and sits with ecs-runtime.\n- Proposed change: Add the capability `WLD.PART.cook` (\"world → streaming-cell cook step under C-COOK\") owned by world-architect, with contributors ecs-runtime (entity chunk baking) and world-data-model.\n\n### K-ARCH-20 · minor · other\n- Target: non_responsibilities of cpu-performance (\"Owning subsystem code → engine-architect\"), gameplay-architect (\"Game-specific code → engine-architect\"), hot-reload-iteration (\"Each system's own reload implementation → resource-streaming-architect\"), ml-inference-runtime (\"Neural feature design (texture, material, animation) → texture-streaming-vt\"), render-architect (\"Individual features → global-illumination\"), graph-editor-framework (\"Each domain's graph semantics → material-system\")\n- Finding: The schema allows a single redirect target per non-responsibility. As a result, several entries route agents to the wrong owner. Subsystem code is not engine-architect's, shader reload is not resource-streaming's, and animation ML features are not texture-streaming's. Others route to an out-of-engine party (the game team) through engine-architect. Agents use these entries to decide where to send work, so the misrouting becomes wrong change requests.\n- Proposed change: Allow `[text, [owners...]]` or a sentinel target such as `\"owning-skill\"` or `\"out-of-scope\"`, and fix the six entries listed. Add a `check.py` rule that the redirect target owns at least one capability whose name matches the text's domain, or is a declared sentinel.\n"}},"apiBlockIndex":1,"requestId":"req_011CfXzWWmLGmie5auqA1RGw","attributionAgent":"general-purpose","type":"assistant","uuid":"9c61e3d2-4d35-4b27-8ba8-d7a6b0bfb700","timestamp":"2026-09-29T15:49:43.155Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
