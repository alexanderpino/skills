{"parentUuid":"9252642e-3991-458f-a951-bce53981d7b4","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a60bceee52b1fb0ee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q7Hg7VnMMxoWW1xR8y5TuW","type":"tool_result","content":"{\"id\": \"performance-architect\", \"name\": \"Performance Architect\", \"tier\": \"cross-cutting\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Owns performance as a discipline: the hypothesis → instrumentation → measurement → optimization → regression-test loop, budgets per subsystem and hardware tier, the scalability / device-profile framework, and performance gates.\", \"non_responsibilities\": [[\"Optimizing a subsystem's code (its owner does, with review)\", \"cpu-performance\"], [\"Instrumentation API\", \"observability-telemetry\"], [\"Benchmark harness\", \"perf-benchmarking\"]], \"provides\": [\"C-BUDGET\"], \"consumes\": [\"C-INSTR\", \"C-CFG\"], \"expertise\": [\"performance methodology\", \"budgeting\", \"scalability design\"]}\n\n{\"id\": \"perf-benchmarking\", \"name\": \"Benchmarking & Performance Regression\", \"tier\": \"expert\", \"parent\": \"performance-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Benchmark harnesses (micro and representative-workload scenes), automated capture, statistical analysis (variance, significance), regression detection and bisection, dashboards.\", \"non_responsibilities\": [[\"Setting budgets\", \"performance-architect\"], [\"CI infrastructure\", \"ci-cd-automation\"]], \"provides\": [], \"consumes\": [\"C-INSTR\", \"C-BUDGET\"], \"expertise\": [\"benchmark statistics\", \"workload design\", \"change-point detection\"]}\n\n{\"id\": \"cpu-performance\", \"name\": \"CPU Performance Engineering\", \"tier\": \"expert\", \"parent\": \"performance-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"CPU microarchitecture-level optimization and review: cache and memory-access patterns, vectorization audits, contention and false sharing, hybrid-core and power-aware tuning, PGO/LTO.\", \"non_responsibilities\": [[\"Owning subsystem code\", \"engine-architect\"], [\"Math library\", \"math-simd-numerics\"], [\"Scheduler design\", \"job-system-task-graph\"]], \"provides\": [], \"consumes\": [\"C-INSTR\", \"C-BUDGET\", \"C-TASK\"], \"expertise\": [\"x86-64 and ARM microarchitecture\", \"VTune/uProf/Superluminal\", \"SIMD\", \"compiler optimization\"]}\n\n{\"id\": \"gpu-performance\", \"name\": \"GPU Performance Engineering\", \"tier\": \"expert\", \"parent\": \"performance-architect\", \"profiles\": [\"client\"], \"runtime\": false, \"purpose\": \"GPU performance analysis and review: occupancy, bandwidth, cache behavior, barrier and async-compute overlap, vendor tools across PC, console and mobile, GPU power.\", \"non_responsibilities\": [[\"Render graph scheduling design\", \"render-graph-scheduling\"], [\"Shader authoring for features\", \"render-architect\"]], \"provides\": [], \"consumes\": [\"C-INSTR\", \"C-BUDGET\", \"C-RG\", \"C-RHI\"], \"expertise\": [\"GPU architecture (RDNA, Ada/Blackwell, Xe, Apple, Mali/Adreno)\", \"PIX/RGP/Nsight\", \"shader optimization\"]}\n\n{\"id\": \"loading-streaming-performance\", \"name\": \"Loading & Hitch Performance\", \"tier\": \"expert\", \"parent\": \"performance-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"End-to-end load time, startup time and hitch elimination (PSO compilation, streaming stalls, GC pauses, synchronous waits), IO throughput analysis.\", \"non_responsibilities\": [[\"IO backend implementation\", \"async-io-storage\"], [\"PSO cache implementation\", \"rhi-core\"], [\"Streaming policy\", \"resource-streaming-architect\"]], \"provides\": [], \"consumes\": [\"C-INSTR\", \"C-BUDGET\", \"C-IO\", \"C-RES\"], \"expertise\": [\"IO profiling\", \"frame-time distribution analysis\", \"shader compilation stutter\"]}\n\n{\"id\": \"test-architect\", \"name\": \"Test Architect\", \"tier\": \"cross-cutting\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Test strategy and architecture: per-subsystem test pyramid, frameworks, the test definition of done every skill must meet, contract tests, test content, coverage and mutation policy, flakiness policy.\", \"non_responsibilities\": [[\"Running pipelines\", \"ci-cd-automation\"], [\"Performance regression\", \"perf-benchmarking\"], [\"Rendering image validation\", \"render-validation\"]], \"provides\": [\"C-TEST\"], \"consumes\": [], \"expertise\": [\"test strategy\", \"contract testing\", \"mutation testing\", \"test determinism\"]}\n\n{\"id\": \"functional-automation-soak\", \"name\": \"Functional Automation & Soak\", \"tier\": \"expert\", \"parent\": \"test-architect\", \"profiles\": [\"all\"], \"runtime\": false, \"purpose\": \"Game-level automation: scripted and bot playthroughs, smoke/boot tests, soak and stability runs (memory growth, leaks), hardware/OS compatibility matrix, network harnesses and server load tests.\", \"non_responsibilities\": [[\"Unit test frameworks\", \"test-architect\"], [\"Device-farm infrastructure\", \"ci-cd-automation\"]], \"provides\": [], \"consumes\": [\"C-GAME?\", \"C-INPUT?\", \"C-NET?\"], \"expertise\": [\"game automation\", \"bots\", \"long-run stability analysis\"]}\n\n{\"id\": \"observability-telemetry\", \"name\": \"Observability & Telemetry\", \"tier\": \"cross-cutting\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Instrumentation substrate: structured logging, trace zones (CPU, GPU, IO, memory), counters and metrics, profiler integrations, in-game stats, development and live telemetry with privacy consent; zero cost when compiled out.\", \"non_responsibilities\": [[\"Crash capture\", \"crash-diagnostics\"], [\"Debug drawing and consoles\", \"visual-debugging-tools\"], [\"Perf budgets\", \"performance-architect\"]], \"provides\": [\"C-INSTR\"], \"consumes\": [\"C-PAL\"], \"expertise\": [\"low-overhead tracing\", \"Tracy/Perfetto formats\", \"telemetry pipelines\"]}\n\n{\"id\": \"memory-allocators\", \"name\": \"Memory & Allocators\", \"tier\": \"expert\", \"parent\": \"core-runtime-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Memory management: virtual memory, allocator families, thread-local and NUMA-aware allocation, tagging and attribution, budget enforcement mechanisms, fragmentation control, memory debugging, OOM policy, UMA accounting.\", \"non_responsibilities\": [[\"GPU heaps\", \"gpu-memory-resources\"], [\"Budget numbers\", \"performance-architect\"]], \"provides\": [\"C-MEM\"], \"consumes\": [\"C-PAL\"], \"expertise\": [\"allocator design\", \"virtual memory\", \"TLSF\", \"memory profiling\"]}\n\n{\"id\": \"job-system-task-graph\", \"name\": \"Job System & Task Graph\", \"tier\": \"expert\", \"parent\": \"core-runtime-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Task-parallel execution: work-stealing scheduler, dependency task graphs, fibers and C++20 coroutines, priorities and QoS, heterogeneous-core and NUMA placement, IO/GPU completion integration, parallel algorithms, blocking policy.\", \"non_responsibilities\": [[\"Frame phase layout\", \"frame-orchestration\"], [\"IO backends\", \"async-io-storage\"]], \"provides\": [\"C-TASK\"], \"consumes\": [\"C-SYNC\", \"C-PAL\"], \"expertise\": [\"work stealing\", \"fibers\", \"coroutines\", \"hybrid CPU scheduling\"]}\n\n{\"id\": \"frame-orchestration\", \"name\": \"Frame Orchestration & Time\", \"tier\": \"expert\", \"parent\": \"core-runtime-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"The engine loop expressed as a task graph: frame pipelining across simulation, render and GPU, tick phases and sync points, fixed-step simulation with interpolation, time domains, latency and pacing control.\", \"non_responsibilities\": [[\"System ordering inside a phase\", \"ecs-runtime\"], [\"Swapchain presentation\", \"rhi-core\"]], \"provides\": [\"C-FRAME\"], \"consumes\": [\"C-TASK\", \"C-CFG\"], \"expertise\": [\"frame pipelining\", \"latency analysis\", \"fixed timestep\"]}\n\n{\"id\": \"entity-object-model\", \"name\": \"Object Model & Identity\", \"tier\": \"expert\", \"parent\": \"core-runtime-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Object-model strategy and identity: generational entity IDs, stable GUIDs, hard/soft/weak references, the hybrid-model policy stating which data lives in ECS vs services vs asset objects vs UI, events and messaging.\", \"non_responsibilities\": [[\"ECS storage and queries\", \"ecs-runtime\"], [\"Asset references\", \"content-pipeline-architect\"], [\"Network IDs\", \"replication\"]], \"provides\": [\"C-ID\"], \"consumes\": [\"C-TYPES\", \"C-SYNC\"], \"expertise\": [\"object models\", \"handle systems\", \"lifetime design\"]}\n\n{\"id\": \"ecs-runtime\", \"name\": \"ECS Runtime\", \"tier\": \"expert\", \"parent\": \"core-runtime-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"ECS: storage (archetype chunks or sparse sets, chosen by ADR), queries, change detection, structural changes and command buffers, system scheduling with access-conflict analysis, relationships, singletons, authoring → runtime baking, debugging.\", \"non_responsibilities\": [[\"World partition\", \"world-architect\"], [\"Transform propagation\", \"spatial-transforms\"], [\"Object-model policy\", \"entity-object-model\"]], \"provides\": [\"C-ECS\"], \"consumes\": [\"C-ID\", \"C-TASK\", \"C-FRAME\", \"C-REFL?\"], \"expertise\": [\"ECS architectures\", \"data-oriented design\", \"parallel scheduling\"]}\n\n{\"id\": \"content-pipeline-architect\", \"name\": \"Content Pipeline Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Asset identity and the content pipeline: asset registry and dependency graph, deterministic incremental per-platform cooking, the cook-step contract, derived-data cache and content-addressed store, distributed cooking, content validation.\", \"non_responsibilities\": [[\"Format-specific builders (shaders, animation, clusters…)\", \"shader-system\"], [\"Runtime loading\", \"resource-streaming-architect\"], [\"Import formats\", \"asset-import-interchange\"]], \"provides\": [\"C-ASSET\", \"C-COOK\"], \"consumes\": [\"C-SER\", \"C-TASK\", \"C-REFL\"], \"expertise\": [\"build systems for data\", \"content-addressed storage\", \"incremental computation\"]}\n\n{\"id\": \"resource-streaming-architect\", \"name\": \"Resource & Streaming Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Runtime resource model: handles and explicit lifetime, load requests with priority and deadline, dependency-aware loading, the streaming manager (budgets, eviction, prediction), fallbacks, no-stall loading.\", \"non_responsibilities\": [[\"IO backends\", \"async-io-storage\"], [\"Package format\", \"package-formats-vfs\"], [\"Texture-specific streaming\", \"texture-streaming-vt\"]], \"provides\": [\"C-RES\"], \"consumes\": [\"C-ASSET\", \"C-VFS\", \"C-IO\", \"C-TASK\"], \"expertise\": [\"streaming systems\", \"cache eviction\", \"async loading\"]}\n\n{\"id\": \"world-architect\", \"name\": \"World Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"World representation strategy (data-oriented, no universal scene graph), partitioning and streaming cells, streaming sources, HLOD strategy, simulation LOD and significance, large-world coordinate policy, level transitions, server-side world streaming.\", \"non_responsibilities\": [[\"World document format\", \"world-data-model\"], [\"Transform math\", \"spatial-transforms\"], [\"HLOD mesh generation\", \"virtualized-geometry-lod\"]], \"provides\": [\"C-WORLD\"], \"consumes\": [\"C-SPATIAL\", \"C-RES\", \"C-ECS\"], \"expertise\": [\"open-world streaming\", \"spatial partitioning\", \"significance systems\"]}\n\n{\"id\": \"world-data-model\", \"name\": \"World Data Model\", \"tier\": \"expert\", \"parent\": \"world-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"World and level documents, prefabs with nested overrides and variants, data layers, one-file-per-object layout for collaboration, level instances.\", \"non_responsibilities\": [[\"Serialization mechanics\", \"serialization-schema\"], [\"Source-control workflows\", \"collaboration-version-control\"]], \"provides\": [], \"consumes\": [\"C-WORLD\", \"C-SER\", \"C-ASSET\", \"C-ID\"], \"expertise\": [\"prefab systems\", \"override resolution\", \"mergeable data design\"]}\n\n{\"id\": \"spatial-transforms\", \"name\": \"Transforms & Spatial Queries\", \"tier\": \"expert\", \"parent\": \"world-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Transform representation and parallel hierarchy propagation, attachments, large-world coordinates implementation, generic spatial index and query service for non-physics consumers, spatial hashing.\", \"non_responsibilities\": [[\"Physics broadphase\", \"collision-detection\"], [\"GPU culling\", \"gpu-driven-pipeline\"]], \"provides\": [\"C-SPATIAL\"], \"consumes\": [\"C-MATH\", \"C-ECS\", \"C-TASK\"], \"expertise\": [\"transform hierarchies\", \"BVH/grids\", \"precision management\"]}\n\n{\"id\": \"vegetation-foliage\", \"name\": \"Vegetation & Foliage\", \"tier\": \"expert\", \"parent\": \"world-architect\", \"profiles\": [\"openworld\"], \"runtime\": true, \"purpose\": \"Vegetation instancing and rendering, procedural placement rules, wind and interaction, vegetation-specific LOD.\", \"non_responsibilities\": [[\"Generic PCG framework\", \"procedural-generation\"], [\"Impostor generation\", \"virtualized-geometry-lod\"]], \"provides\": [], \"consumes\": [\"C-WORLD\", \"C-RSCENE\", \"C-RES\", \"C-PHYS?\"], \"expertise\": [\"foliage rendering\", \"wind animation\", \"instancing\"]}\n\n{\"id\": \"render-architect\", \"name\": \"Render Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"client\"], \"runtime\": true, \"purpose\": \"Rendering architecture: pipeline organization, shading-path choice (forward+, deferred, visibility buffer), render-feature contract, render scene and world→render sync, scalability tiers from 2D mobile to path-traced, multi-view, debug modes, render threading.\", \"non_responsibilities\": [[\"API backends\", \"rhi-core\"], [\"Pass scheduling\", \"render-graph-scheduling\"], [\"Individual features (GI, shadows…)\", \"global-illumination\"]], \"provides\": [\"C-RSCENE\"], \"consumes\": [\"C-RG\", \"C-SPATIAL\", \"C-MATIF\", \"C-FRAME\", \"C-ECS\"], \"expertise\": [\"real-time rendering architecture\", \"GPU-driven pipelines\", \"scalability\"]}\n\n{\"id\": \"gpu-memory-resources\", \"name\": \"GPU Memory & Resources\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"client\"], \"runtime\": true, \"purpose\": \"GPU heaps and suballocation, residency and overcommit, upload/readback rings, sparse/reserved resources, GPU memory budgeting and defragmentation, lifetimes decoupled from frame boundaries.\", \"non_responsibilities\": [[\"Transient aliasing plans\", \"render-graph-scheduling\"], [\"Texture streaming policy\", \"texture-streaming-vt\"]], \"provides\": [\"C-GPUMEM\"], \"consumes\": [\"C-RHI\"], \"expertise\": [\"D3D12MA/VMA-class allocators\", \"residency\", \"sparse resources\"]}\n\n{\"id\": \"gpu-driven-pipeline\", \"name\": \"GPU-Driven Geometry Pipeline\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"mobile3d\", \"std3d\"], \"runtime\": true, \"purpose\": \"GPU scene and instance data, GPU frustum and two-phase occlusion culling, indirect and device-generated commands, mesh/amplification shaders, visibility-buffer rasterization, instancing, CPU-driven fallback for low-tier GPUs.\", \"non_responsibilities\": [[\"Cluster LOD\", \"virtualized-geometry-lod\"], [\"Render-scene contract\", \"render-architect\"]], \"provides\": [], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-SHADER\", \"C-GPUMEM\"], \"expertise\": [\"GPU culling\", \"mesh shaders\", \"ExecuteIndirect\"]}\n\n{\"id\": \"texture-streaming-vt\", \"name\": \"Textures & Virtual Texturing\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"mobile3d\", \"std3d\"], \"runtime\": true, \"purpose\": \"Runtime texture formats, mip streaming, sampler-feedback streaming, virtual texturing, streaming-friendly cooked layout; evaluates neural texture compression.\", \"non_responsibilities\": [[\"Texture encoding in cook\", \"asset-cook-processors\"], [\"Streaming manager\", \"resource-streaming-architect\"]], \"provides\": [], \"consumes\": [\"C-RES\", \"C-GPUMEM\", \"C-RG\", \"C-COOK\", \"C-ML?\"], \"expertise\": [\"virtual texturing\", \"sampler feedback\", \"texture compression\"]}\n\n{\"id\": \"physics-architect\", \"name\": \"Physics Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Physics architecture: build vs integrate decision, physics world representation and ECS integration, stepping and frame sync, determinism levels, physics LOD, materials, GPU offload evaluation; covers both 2D and 3D.\", \"non_responsibilities\": [[\"Collision algorithms\", \"collision-detection\"], [\"Solvers\", \"rigid-body-dynamics\"], [\"Networked physics\", \"prediction-rollback\"]], \"provides\": [\"C-PHYS\"], \"consumes\": [\"C-SPATIAL\", \"C-ECS\", \"C-FRAME\", \"C-DET\", \"C-TASK\"], \"expertise\": [\"physics engines (Jolt, PhysX, Havok, Box2D)\", \"simulation architecture\"]}\n\n{\"id\": \"animation-architect\", \"name\": \"Animation Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"runtime\": true, \"purpose\": \"Animation architecture: data model, parallel evaluation pipeline, animation/physics/gameplay sync and root-motion policy, animation LOD, budgets.\", \"non_responsibilities\": [[\"Sampling and blending\", \"animation-runtime\"], [\"Skinning\", \"deformation-skinning\"]], \"provides\": [\"C-ANIM\"], \"consumes\": [\"C-ECS\", \"C-SPATIAL\", \"C-FRAME\", \"C-TASK\", \"C-PHYS?\"], \"expertise\": [\"animation systems\", \"pose pipelines\"]}\n\n{\"id\": \"network-architect\", \"name\": \"Network Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"online\", \"server\"], \"runtime\": true, \"purpose\": \"Netcode model per game type (authoritative server, lockstep, rollback, P2P/relay), network tick and time, authority model, budgets and scale targets, protocol versioning, sharded worlds evaluation.\", \"non_responsibilities\": [[\"Transport\", \"network-transport\"], [\"Replication mechanics\", \"replication\"], [\"Matchmaking services\", \"platform-online-services\"]], \"provides\": [\"C-NET\"], \"consumes\": [\"C-ECS\", \"C-SER\", \"C-FRAME\", \"C-DET\"], \"expertise\": [\"netcode architectures\", \"distributed systems\", \"latency hiding\"]}\n\n{\"id\": \"replication\", \"name\": \"Replication & State Sync\", \"tier\": \"expert\", \"parent\": \"network-architect\", \"profiles\": [\"online\", \"server\"], \"runtime\": true, \"purpose\": \"Entity and property replication, delta compression and quantization, interest management, prioritization, RPCs, snapshot interpolation, replay recording, network ID mapping.\", \"non_responsibilities\": [[\"Prediction\", \"prediction-rollback\"], [\"Transport\", \"network-transport\"]], \"provides\": [], \"consumes\": [\"C-NET\", \"C-ECS\", \"C-SER\", \"C-ID\"], \"expertise\": [\"state synchronization\", \"bit packing\", \"interest management\"]}\n\n{\"id\": \"dedicated-server\", \"name\": \"Dedicated Servers\", \"tier\": \"expert\", \"parent\": \"network-architect\", \"profiles\": [\"online\", \"server\"], \"runtime\": true, \"purpose\": \"Headless server builds and stripping, tick cost and multi-instance density, fleet orchestration boundary, server observability, listen servers and host migration.\", \"non_responsibilities\": [[\"Fleet operation (outside engine scope)\", \"platform-online-services\"], [\"Server logging substrate\", \"observability-telemetry\"]], \"provides\": [], \"consumes\": [\"C-NET\", \"C-FRAME\", \"C-SVC\"], \"expertise\": [\"headless builds\", \"Linux containers\", \"server performance\"]}\n\n{\"id\": \"editor-architect\", \"name\": \"Editor Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"client\"], \"runtime\": false, \"purpose\": \"Editor architecture: process model (in- vs out-of-process runtime), editor/runtime data separation, transactions and undo/redo, selection, extension API and tool scripting, play-in-editor isolation, remote live editing, headless editor, large-project performance.\", \"non_responsibilities\": [[\"Panels and inspectors\", \"editor-ui-framework\"], [\"World viewport tools\", \"world-editor-viewport\"], [\"Source control\", \"collaboration-version-control\"]], \"provides\": [\"C-EDCMD\"], \"consumes\": [\"C-REFL\", \"C-SER\", \"C-ASSET\", \"C-WORLD\", \"C-PLUGIN\", \"C-UI?\"], \"expertise\": [\"editor architecture\", \"command pattern\", \"tool UX\"]}","is_error":false}]},"uuid":"62de28cd-9187-484c-8ce4-438087571942","timestamp":"2026-09-29T15:47:36.428Z","sourceToolAssistantUUID":"9252642e-3991-458f-a951-bce53981d7b4","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
