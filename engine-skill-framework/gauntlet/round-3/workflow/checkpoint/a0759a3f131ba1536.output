\": [\n  \"all\"\n ],\n \"purpose\": \"Evaluates and integrates AI-assisted authoring: generative asset tools, editor copilots, ML-assisted retopology/rigging/UV/LOD, provenance and licensing of generated content.\",\n \"non_responsibilities\": [\n  [\n   \"Runtime inference\",\n   \"ml-inference-runtime\"\n  ],\n  [\n   \"License compliance sign-off\",\n   \"certification-compliance\"\n  ]\n ],\n \"provides\": [],\n \"consumes\": [\n  \"C-EDCMD\",\n  \"C-ASSET\",\n  \"C-ML?\"\n ],\n \"expertise\": [\n  \"generative models\",\n  \"tool integration\",\n  \"content provenance\"\n ],\n \"kind\": \"tool\",\n \"targets\": [\n  \"tools\"\n ],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"tools\"\n}\n{\n \"id\": \"build-release-architect\",\n \"name\": \"Build & Release Architect\",\n \"tier\": \"lead\",\n \"parent\": \"engine-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Build and release architecture: branching and merge model, engine release management and versioning, orchestration of the code \\u2192 content \\u2192 package pipeline.\",\n \"non_responsibilities\": [\n  [\n   \"Build system implementation\",\n   \"build-system-toolchains\"\n  ],\n  [\n   \"CI pipelines\",\n   \"ci-cd-automation\"\n  ],\n  [\n   \"Packaging\",\n   \"packaging-release-patching\"\n  ]\n ],\n \"provides\": [\n  \"C-RELEASE\"\n ],\n \"consumes\": [\n  \"C-BUILD\",\n  \"C-PKG\"\n ],\n \"expertise\": [\n  \"release engineering\",\n  \"branching strategies\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"tool_consumes\": [\n  \"C-COOK\"\n ],\n \"implements\": [],\n \"workstream\": \"release\"\n}\n{\n \"id\": \"ci-cd-automation\",\n \"name\": \"CI/CD & Automation\",\n \"tier\": \"expert\",\n \"parent\": \"build-release-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"CI pipelines, build farm and artifact storage, pre-submit and merge gating, symbol servers, device-farm orchestration, developer CLI and automation.\",\n \"non_responsibili