ged pipeline with deadlines', 'justification_owner': 'async-io-storage'}\n{'id': 'L17', 'pattern': 'Page-fault-driven streaming', 'detection': 'mmap reads on latency-critical workers', 'default_stance': 'Explicit IO requests; mmap only prefetched/tool-side', 'justification_owner': 'async-io-storage'}\n{'id': 'L18', 'pattern': 'Level-as-a-file loading', 'detection': 'whole level loaded before play', 'default_stance': 'Cell streaming with budgeted activation', 'justification_owner': 'world-architect'}\n{'id': 'L19', 'pattern': 'Immediate synchronous observer callbacks across subsystems', 'detection': \"callbacks invoked on the producer's thread mid-update\", 'default_stance': 'Deferred batched events at declared consumption points', 'justification_owner': 'entity-object-model'}\n{'id': 'L20', 'pattern': 'Stringly-typed reflection on runtime paths', 'detection': 'name lookups per frame', 'default_stance': 'Static reflection & resolved IDs; strings at tool/script boundaries', 'justification_owner': 'reflection-metadata'}\n{'id': 'L21', 'pattern': 'Tracing-GC-managed engine objects', 'detection': 'engine objects reachable via GC', 'default_stance': 'Explicit ownership + generational handles; weak script refs', 'justification_owner': 'entity-object-model'}\n{'id': 'L22', 'pattern': 'Global script VM on one thread', 'detection': 'single interpreter mutating the world', 'default_stance': 'Per-worker VMs/isolates, deferred mutation', 'justification_owner': 'scripting-runtime'}\n{'id': 'L23', 'pattern': 'Editor-in-runtime monolith', 'detection': 'editor code linked into shipping builds', 'default_stance': 'Tool-side modules; tools target only', 'justification_owner': 'editor-architect'}\n{'id': 'L24', 'pattern': 'Blocking cook-before-play', 'detection': 'full cook required before running', 'default_stance': 'On-demand cooking & cook-server streaming', 'justification_owner': 'content-pipeline-architect'}\n{'id': 'L25', 'pattern': 'Single-thread-first design', 'detection': 'systems that must run serially by construction', 'default_stance': 'Parallel by default; serial exceptions enumerated', 'justification_owner': 'architecture-governance'}\n{'id': 'L26', 'pattern': 'Monolithic subsystems', 'detection': 'one module owning a whole domain', 'default_stance': 'Contracts + focused experts', 'justification_owner': 'engine-architect'}\n{'id': 'L27', 'pattern': 'ECS for everything / GPU-driven everywhere (new dogma)', 'detection': 'technique applied where access patterns do not fit', 'default_stance': 'Per-domain ADR with workload evidence', 'justification_owner': 'architecture-governance'}\nM0 indie-2d-client ['platform-architect', 'platform-desktop', 'core-runtime-architect', 'math-simd-numerics', 'memory-allocators', 'containers-core-types', 'concurrency-primitives', 'job-system-task-graph', 'observability-telemetry', 'crash-diagnostics', 'runtime-scalability', 'frame-orchestration', 'entity-object-model', 'reflection-metadata', 'serialization-schema', 'async-io-storage', 'package-formats-vfs', 'content-pipeline-architect', 'resource-streaming-architect', 'gpu-platform-architect', 'rhi-core', 'rhi-vulkan', 'gpu-memory-resources', 'render-graph-scheduling', 'shader-system', 'text-fonts', 'render-2d-vector', 'input-devices-haptics', 'input-system', 'asset-cook-processors', 'build-system-toolchains', 'ci-cd-automation']\nM1 indie-2d-client ['ecs-runtime', 'spatial-transforms', 'world-architect', 'world-data-model', 'determinism-replay', 'physics-architect', 'physics-2d', 'animation-architect', 'animation-runtime', 'animation-graphs', 'audio-architect', 'audio-dsp-mixing', 'audio-content-runtime', 'localization-i18n', 'accessibility', 'ui-architect', 'gameplay-architect', 'gameplay-systems-toolkit', 'gameplay-data', 'scripting-runtime', 'persistence-save', 'character-movement', 'render-architect', 'material-system', 'post-color-hdr', 'texture-streaming-vt', 'reconstruction-upscaling', 'vfx-particles', 'visual-debugging-tools', 'plugin-system', 'h