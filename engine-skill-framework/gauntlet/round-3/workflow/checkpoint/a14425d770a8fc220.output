s/64f15158-6a4e-5bdf-8a90-7f2bd7b05b82/scratchpad/r2/engine-skill-framework/ && python3 -c \"\nimport json\ns=json.load(open('data/skills.json'))['skills']\nfor v in s[:50]:\n  print('==',v['id'],'|',v['tier'],v['kind'],'| parent',v['parent'],'| ws',v['workstream'],'| prof',v['profiles'],'| tg',v['targets'],'| pl',v.get('platforms'))\n  print('  P:',v['purpose'])\n  print('  NR:','; '.join(str(a)+' ->'+str(b) for a,b in v['non_responsibilities']))\n  print('  prov',v['provides'],'cons',v['consumes'],'tool',v['tool_consumes'],'impl',v['implements'])\n\""}},"apiBlockIndex":1,"requestId":"req_011CfY2sM518hEfw2ACmRwqQ","attributionAgent":"general-purpose","type":"assistant","uuid":"b94ec1a6-1a1c-4b18-b628-8bec45157db6","timestamp":"2026-09-29T16:18:24.758Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
{"parentUuid":"b94ec1a6-1a1c-4b18-b628-8bec45157db6","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a14425d770a8fc220","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NkYfMhoDvBxJZZK8G8NDLh","type":"tool_result","content":"== engine-architect | orchestrator process | parent None | ws governance | prof ['all'] | tg [] | pl None\n  P: Owns the engine's overall architecture: requirements and configuration profiles, layering and module boundaries, the contract registry, global conventions, build/integrate/buy decisions and cross-domain arbitration. Final authority on the boundaries between skills.\n  NR: Running the ADR, fitness-function and anti-legacy process ->architecture-governance; Scheduling work across agents and the ownership ledger ->program-orchestration; Architecture inside a domain (e.g. shading-path choice) ->render-architect\n  prov ['C-ARCH'] cons [] tool [] impl []\n== architecture-governance | orchestrator process | parent engine-architect | ws governance | prof ['all'] | tg [] | pl None\n  P: Runs architecture as an evidence-backed, governed process: ADR lifecycle with revisit conditions, technology radar with maturity tiers and promotion criteria, automated fitness functions (layering, dependency direction, contract conformance), anti-legacy review, coding standard.\n  NR: Making the architecture decisions themselves ->engine-architect; Grading sources and running spikes ->research-evidence; Test definition of done ->test-architect\n  prov ['C-ADR'] cons [] tool [] impl []\n== program-orchestration | orchestrator process | parent engine-architect | ws governance | prof ['all'] | tg [] | pl None\n  P: Turns architecture into coordinated multi-agent work: decomposes milestones into tasks by skill territory, keeps the ownership ledger and territory locks, sequences integration through vertical slices, routes contract change requests, and schedules critic gates.\n  NR: Deciding architecture ->engine-architect; CI mechanics ->ci-cd-automation; Release versioning ->build-release-architect\n  prov ['C-ORCH'] cons ['C-PROD'] tool [] impl []\n== research-evidence | cross-cutting process | parent engine-architect | ws governance | prof ['all'] | tg [] | pl None\n  P: Research discipline for every major decision: finds and grades authoritative evidence (production talks, platform docs, peer-reviewed work, reproducible benchmarks), classifies techniques as established / emerging / experimental / speculative, and runs spikes where literature is thin.\n  NR: Making the decision (the owning skill does, via an ADR) ->architecture-governance; Benchmark infrastructure ->perf-benchmarking\n  prov ['C-EVID'] cons [] tool [] impl []\n== performance-architect | cross-cutting process | parent engine-architect | ws performance | prof ['all'] | tg [] | pl None\n  P: Owns performance as a discipline: the hypothesis → instrumentation → measurement → optimization → regression-test loop, budgets per subsystem and hardware tier, the scalability / device-profile framework, and performance gates.\n  NR: Optimizing subsystem code (via C-PERF findings) ->owning-skill; Instrumentation API ->observability-telemetry; Benchmark harness ->perf-benchmarking; Runtime scalability machinery ->runtime-scalability\n  prov ['C-BUDGET', 'C-PERF'] cons [] tool [] impl []\n== perf-benchmarking | expert process | parent performance-architect | ws performance | prof ['all'] | tg [] | pl None\n  P: Benchmark harnesses (micro and representative-workload scenes), automated capture, statistical analysis (variance, significance), regression detection and bisection, dashboards.\n  NR: Setting budgets ->performance-architect; CI infrastructure ->ci-cd-automation\n  prov ['C-BENCH'] cons ['C-INSTR', 'C-BUDGET'] tool [] impl []\n== cpu-performance | expert process | parent performance-architect | ws performance | prof ['all'] | tg [] | pl None\n  P: CPU microarchitecture-level optimization and review: cache and memory-access patterns, vectorization audits, contention and false sharing, hybrid-core and power-aware tuning, PGO/LTO.\n  NR: Owning subsystem code ->owning-skill; Math library ->math-simd-numerics; Scheduler design ->job-system-task-graph; Changing subsystem code (findings route via C-PERF) ->owning-skill\n  prov [] cons ['C-INSTR', 'C-BUDGET', 'C-TASK'] tool [] impl []\n== gpu-performance | expert process | parent performance-architect | ws performance | prof ['all'] | tg [] | pl None\n  P: GPU performance analysis and review: occupancy, bandwidth, cache behavior, barrier and async-compute overlap, vendor tools across PC, console and mobile, GPU power.\n  NR: Render graph scheduling design ->render-graph-scheduling; Shader authoring for features ->render-architect\n  prov [] cons ['C-INSTR', 'C-BUDGET', 'C-RG', 'C-RHI'] tool [] impl []\n== loading-streaming-performance | expert process | parent performance-architect | ws performance | prof ['all'] | tg [] | pl None\n  P: End-to-end load time, startup time and hitch elimination (PSO compilation, streaming stalls, GC pauses, synchronous waits), IO throughput analysis.\n  NR: IO backend implementation ->async-io-storage; PSO cache implementation ->rhi-core; Streaming policy ->resource-streaming-architect\n  prov [] cons ['C-INSTR', 'C-BUDGET', 'C-IO', 'C-RES'] tool [] impl []\n== test-architect | cross-cutting process | parent engine-architect | ws quality | prof ['all'] | tg [] | pl None\n  P: Test strategy and architecture: per-subsystem test pyramid, frameworks, the test definition of done every skill must meet, contract tests, test content, coverage and mutation policy, flakiness policy.\n  NR: Running pipelines ->ci-cd-automation; Performance regression ->perf-benchmarking; Rendering image validation ->render-validation\n  prov ['C-TEST'] cons [] tool [] impl []\n== render-validation | expert process | parent test-architect | ws quality | prof ['all'] | tg [] | pl None\n  P: Rendering correctness validation: golden-image tests with perceptual metrics, tolerances per GPU/driver, comparisons against the reference path tracer, graphics API validation in CI.\n  NR: Fixing rendering features ->render-architect; Material furnace tests (defines them; this skill runs them) ->material-system\n  prov [] cons ['C-RG', 'C-RHI', 'C-RSCENE', 'C-RT?'] tool [] impl []\n== functional-automation-soak | expert process | parent test-architect | ws quality | prof ['all'] | tg [] | pl None\n  P: Game-level automation: scripted and bot playthroughs, smoke/boot tests, soak and stability runs (memory growth, leaks), hardware/OS compatibility matrix, network harnesses and server load tests.\n  NR: Unit test frameworks ->test-architect; Device-farm infrastructure ->ci-cd-automation\n  prov [] cons ['C-GAME?', 'C-INPUT?', 'C-NET?'] tool [] impl []\n== robustness-fuzzing | expert process | parent test-architect | ws quality | prof ['all'] | tg [] | pl None\n  P: Robustness engineering: fuzzing every untrusted-input parser (assets, packets, saves, scripts, mods), sanitizer build policy, fault injection (IO errors, OOM, device lost), concurrency stress and schedule perturbation.\n  NR: Threat model ->security-engineering; Fixing parsers ->serialization-schema\n  prov [] cons ['C-SER', 'C-IO'] tool [] impl []\n== certification-compliance | expert process | parent test-architect | ws quality | prof ['all'] | tg [] | pl None\n  P: Tracks and pre-validates external requirements: platform certification (TRC/XR/Lotcheck class), age ratings, privacy law, accessibility law (CVAA, EAA), third-party licenses and SBOM, photosensitivity testing.\n  NR: Implementing platform features ->platform-architect; Implementing accessibility features ->accessibility\n  prov ['C-CERT'] cons ['C-A11Y?', 'C-SVC'] tool [] impl []\n== security-engineering | cross-cutting process | parent engine-architect | ws quality | prof ['all'] | tg [] | pl None\n  P: Threat modeling and trust boundaries for every untrusted input, secure-coding and memory-safety policy, supply-chain security, secrets, anti-tamper boundary, privacy engineering, mod/UGC sandbox policy.\n  NR: Cheat detection ->anti-cheat-integrity; Fuzzing campaigns ->robustness-fuzzing; Transport encryption implementation ->network-transport\n  prov ['C-TRUST'] cons [] tool [] impl []\n== anti-cheat-integrity | expert runtime | parent security-engineering | ws online | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Cheat resistance for online games: server-authoritative validation patterns (movement, hits, economy), rate limiting, anomaly signals, integration boundary for client anti-cheat middleware.\n  NR: Replication design ->replication; Transport encryption ->network-transport\n  prov [] cons ['C-NET?', 'C-PREDICT?', 'C-PHYS?', 'C-GAME?', 'C-SVC?', 'C-LIVE?'] tool [] impl []\n== observability-telemetry | cross-cutting runtime | parent engine-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Instrumentation substrate: structured logging, trace zones (CPU, GPU, IO, memory), counters and metrics, profiler integrations, in-game stats, development and live telemetry with privacy consent; zero cost when compiled out.\n  NR: Crash capture ->crash-diagnostics; Debug drawing and consoles ->visual-debugging-tools; Perf budgets ->performance-architect\n  prov ['C-INSTR'] cons ['C-PAL', 'C-BASE', 'C-SYNC'] tool [] impl []\n== crash-diagnostics | cross-cutting runtime | parent engine-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Crash, hang and GPU-fault capture and reporting: minidumps, symbolication, bucketing and triage, GPU crash dumps, watchdogs, OOM reports, assert reporting.\n  NR: Emitting GPU breadcrumbs ->rhi-core; Symbol server infrastructure ->ci-cd-automation\n  prov ['C-CRASH'] cons ['C-PAL', 'C-BASE', 'C-INSTR'] tool [] impl []\n== determinism-replay | cross-cutting runtime | parent engine-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Defines determinism levels (none, same-binary, cross-platform) per subsystem and the floating-point and parallel-execution rules that achieve them; owns input/state record-replay and desync detection.\n  NR: Rollback netcode ->prediction-rollback; Deterministic math implementation ->math-simd-numerics\n  prov ['C-DET', 'C-SNAPSHOT', 'C-REPLAY'] cons ['C-MATH', 'C-TASK', 'C-SER@C-SNAPSHOT', 'C-FRAME@C-SNAPSHOT'] tool [] impl []\n== hot-reload-iteration | cross-cutting runtime | parent engine-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Owns the reload protocol (change detection, dependency invalidation, state preservation) that assets, shaders, scripts, config and C++ live coding plug into; measures edit → see latency.\n  NR: Each system's own reload implementation (via C-RELOAD) ->owning-skill; Build system ->build-system-toolchains\n  prov ['C-RELOAD'] cons ['C-RES', 'C-MOD', 'C-REFL'] tool ['C-BUILD'] impl []\n== accessibility | cross-cutting runtime | parent engine-architect | ws ui | prof ['all'] | tg ['client', 'tools'] | pl None\n  P: Maps XAG/GAG and legal requirements to engine features and owns subtitles and captions, screen-reader/TTS/STT hooks, colorblind and contrast modes, text scaling, motion and photosensitivity options, assist hooks, and their validation.\n  NR: Input remapping implementation ->input-system; UI layout engine & subtitle presentation ->ui-architect; Colorblind passes ->post-color-hdr; Legal compliance sign-off ->certification-compliance\n  prov ['C-A11Y', 'C-A11YRT'] cons ['C-TEXT', 'C-PAL', 'C-DIALOGUE?'] tool [] impl []\n== api-lifecycle-migration | cross-cutting process | parent engine-architect | ws governance | prof ['all'] | tg [] | pl None\n  P: Public API surface, semantic versioning and deprecation, ABI policy, engine-upgrade tooling (codemods, data upgraders) and LTS policy, so projects can move across engine versions.\n  NR: Data schema mechanisms ->serialization-schema; Plugin loading ->plugin-system\n  prov ['C-API'] cons ['C-SER', 'C-REFL', 'C-RELEASE'] tool [] impl []\n== plugin-system | expert runtime | parent api-lifecycle-migration | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Plugin architecture: manifests, discovery, dependency resolution, load phases, binary vs source plugins, isolation, distribution format.\n  NR: Mods & UGC ->modding-ugc; Module linking internals ->core-runtime-architect\n  prov ['C-PLUGIN'] cons ['C-MOD', 'C-BASE', 'C-API'] tool [] impl []\n== modding-ugc | expert runtime | parent api-lifecycle-migration | ws gameplay | prof ['ugc'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Mod and UGC support: mod SDK, content overrides via VFS layering, sandboxed mod scripting, UGC upload and moderation boundaries, mod compatibility across patches.\n  NR: Sandbox policy ->security-engineering; Script VM ->scripting-runtime\n  prov [] cons ['C-VFS', 'C-SCRIPT', 'C-PLUGIN', 'C-SVC'] tool [] impl []\n== developer-experience-docs | cross-cutting process | parent engine-architect | ws governance | prof ['all'] | tg [] | pl None\n  P: Documentation and developer experience: API reference, architecture docs, the sample-project ladder (2D → open-world online) that doubles as integration tests, templates, onboarding, doc testing, error-message standards, DX metrics.\n  NR: ADR records ->architecture-governance; Iteration-time tooling ->hot-reload-iteration\n  prov [] cons [] tool [] impl []\n== ml-inference-runtime | expert runtime | parent gpu-platform-architect | ws rendering | prof ['lite3d', 'std3d'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Runtime neural-network inference shared by neural rendering, animation, audio and AI: GPU (cooperative-vector / tensor) and CPU backends, model packaging and quantization, scheduling within frame budgets, determinism characteristics.\n  NR: Vendor upscalers ->reconstruction-upscaling; In-shader (fused) networks ->shader-system; Neural feature design ->owning-skill; Model training ->external:ml-training\n  prov ['C-ML', 'C-MLGPU'] cons ['C-TASK', 'C-RHI?@C-MLGPU', 'C-RG?@C-MLGPU', 'C-PAL'] tool [] impl []\n== core-runtime-architect | lead runtime | parent engine-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Core runtime architecture: layering within core, module system and engine lifecycle (parallel boot, init graph, shutdown), configuration and cvars, error-handling and failure model, language and compiler feature policy.\n  NR: Allocator design ->memory-allocators; Scheduler ->job-system-task-graph; Frame loop ->frame-orchestration\n  prov ['C-MOD', 'C-CFG', 'C-ERR', 'C-LIFETIME', 'C-IPC'] cons ['C-PAL', 'C-BASE', 'C-MEM', 'C-TYPES', 'C-SYNC', 'C-TASK', 'C-INSTR'] tool [] impl []\n== math-simd-numerics | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Math and numerics: SIMD linear algebra, geometry and intersection primitives, computational geometry, numerical robustness, mixed and double precision, deterministic math, RNG and noise, curves, quantized formats, SPMD kernels with ISA dispatch.\n  NR: Coordinate conventions decision ->engine-architect; Determinism rules ->determinism-replay\n  prov ['C-MATH'] cons ['C-PAL'] tool [] impl []\n== memory-allocators | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Memory management: virtual memory, allocator families, thread-local and NUMA-aware allocation, tagging and attribution, budget enforcement mechanisms, fragmentation control, memory debugging, OOM policy, UMA accounting.\n  NR: GPU heaps ->gpu-memory-resources; Budget numbers ->performance-architect\n  prov ['C-MEM'] cons ['C-PAL', 'C-BASE'] tool [] impl []\n== containers-core-types | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Containers and core types: cache-friendly containers (open-addressing maps, inline and SoA containers, rings), strings and UTF-8, interned names, hashing, bit utilities, algorithms, explicit-ownership and view types.\n  NR: Concurrent containers ->concurrency-primitives; Entity handles ->entity-object-model\n  prov ['C-TYPES'] cons ['C-MEM', 'C-BASE'] tool [] impl []\n== concurrency-primitives | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Memory model and atomics, synchronization primitives, lock-free and wait-free structures, safe memory reclamation, thread-safety annotations and model checking; reviewer for concurrent code engine-wide.\n  NR: Scheduling ->job-system-task-graph; Concurrency test campaigns ->robustness-fuzzing\n  prov ['C-SYNC'] cons ['C-PAL', 'C-BASE'] tool [] impl []\n== job-system-task-graph | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Task-parallel execution: work-stealing scheduler, dependency task graphs, fibers and C++20 coroutines, priorities and QoS, heterogeneous-core and NUMA placement, IO/GPU completion integration, parallel algorithms, blocking policy.\n  NR: Frame phase layout ->frame-orchestration; IO backends ->async-io-storage\n  prov ['C-TASK'] cons ['C-SYNC', 'C-PAL', 'C-BASE', 'C-MEM'] tool [] impl []\n== frame-orchestration | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: The engine loop expressed as a task graph: frame pipelining across simulation, render and GPU, tick phases and sync points, fixed-step simulation with interpolation, time domains, latency and pacing control.\n  NR: System ordering inside a phase ->ecs-runtime; Swapchain presentation ->rhi-core\n  prov ['C-FRAME', 'C-FLOW', 'C-PRESENT'] cons ['C-TASK', 'C-CFG', 'C-PAL'] tool [] impl []\n== entity-object-model | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Object-model strategy and identity: generational entity IDs, stable GUIDs, hard/soft/weak references, the hybrid-model policy stating which data lives in ECS vs services vs asset objects vs UI, events and messaging.\n  NR: ECS storage and queries ->ecs-runtime; Asset references ->content-pipeline-architect; Network IDs ->replication\n  prov ['C-ID'] cons ['C-TYPES', 'C-SYNC', 'C-LIFETIME'] tool [] impl []\n== ecs-runtime | expert runtime | parent core-runtime-architect | ws foundation | prof ['min2d', 'lite3d', 'std3d'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: ECS: storage (archetype chunks or sparse sets, chosen by ADR), queries, change detection, structural changes and command buffers, system scheduling with access-conflict analysis, relationships, singletons, authoring → runtime baking, debugging.\n  NR: World partition ->world-architect; Transform propagation ->spatial-transforms; Object-model policy ->entity-object-model\n  prov ['C-ECS'] cons ['C-ID', 'C-TASK', 'C-FRAME', 'C-REFL?', 'C-SNAPSHOT', 'C-RELOAD?'] tool [] impl []\n== reflection-metadata | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Type registry, reflection generation (codegen now, C++26 static reflection when toolchains allow), attributes, the property system, script-binding substrate, dynamic invocation.\n  NR: Serialization formats ->serialization-schema; Editor widgets ->editor-ui-framework; Script VM ->scripting-runtime\n  prov ['C-REFL'] cons ['C-TYPES'] tool [] impl []\n== serialization-schema | expert runtime | parent core-runtime-architect | ws foundation | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Binary and text formats, schema evolution and upgraders, in-place loadable layouts, canonical deterministic serialization, portability, and validation of untrusted input.\n  NR: Package containers ->package-formats-vfs; Network bit packing ->replication; Save-game semantics ->persistence-save\n  prov ['C-SER'] cons ['C-REFL', 'C-TYPES'] tool [] impl []\n== platform-architect | lead runtime | parent engine-architect | ws platform | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Platform abstraction layer and porting strategy: OS services, CPU/GPU capability discovery, windowing, process lifecycle, capability tiers, and evaluation of new targets (web, cloud streaming).\n  NR: Graphics API backends ->rhi-core; Store and online services ->platform-services; Toolchains ->build-system-toolchains\n  prov ['C-PAL', 'C-BASE'] cons [] tool [] impl []\n== platform-desktop | expert runtime | parent platform-architect | ws platform | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl ['pc']\n  P: Windows, Linux, SteamOS and macOS integration: display modes, HDR and VRR capability, DPI, OS-specific IO and scheduling behavior, handheld-PC specifics, server host OS.\n  NR: HDR signal encoding ->post-color-hdr; Swapchain ->rhi-core\n  prov [] cons ['C-PAL'] tool [] impl []\n== platform-console | expert runtime | parent platform-architect | ws platform | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl ['pc']\n  P: Console-class integration from platform-holder documentation: OS and memory model (UMA), suspend/resume, multi-user model, devkit workflows, platform requirements feeding certification.\n  NR: Certification tracking ->certification-compliance; Console graphics API backend ->rhi-core\n  prov [] cons ['C-PAL', 'C-SVC', 'C-GPUTIER'] tool [] impl ['C-RHI']\n== platform-mobile | expert runtime | parent platform-architect | ws platform | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl ['mobile', 'xr-standalone']\n  P: iOS and Android (incl. Android-based standalone XR) integration: app lifecycle, thermal/power adaptivity, tile-based GPU implications, frame pacing, storage, notifications, deep links.\n  NR: Render-graph TBDR optimizations ->render-graph-scheduling; Touch input ->input-devices-haptics\n  prov [] cons ['C-PAL'] tool [] impl []\n== platform-services | expert runtime | parent platform-architect | ws platform | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: First-party platform and store services: identity and sign-in, achievements and presence, entitlements and commerce through first-party stores, privileges and parental controls, social graph and invites, block/mute and text filtering, crossplay policy, leaderboards, cloud-save APIs, media capture, age and region policy enforcement.\n  NR: Third-party/own backend & live-ops boundaries ->online-services-liveops; Game-server hosting ->dedicated-server; Save-game content ->persistence-save; Backend implementation ->external:backend\n  prov ['C-SVC'] cons ['C-PAL', 'C-TASK', 'C-CFG'] tool [] impl []\n== input-system | expert runtime | parent platform-architect | ws platform | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Action-level input: mapping and context stacks, rebinding, buffering and latency accounting, local-multiplayer assignment, accessibility input options, UI navigation routing, per-device glyphs, recording and replay.\n  NR: Device drivers and haptics ->input-devices-haptics; UI focus logic ->ui-architect\n  prov ['C-INPUT'] cons ['C-DEVICE?', 'C-FRAME', 'C-SER', 'C-A11Y'] tool [] impl []\n== input-devices-haptics | expert runtime | parent platform-architect | ws platform | prof ['all'] | tg ['client', 'tools'] | pl None\n  P: Device layer: keyboard/mouse raw input, gamepads, touch and gestures, motion sensors, pen, hotplug and user pairing, haptics (rumble, HD haptics, adaptive triggers).\n  NR: Action mapping ->input-system; XR controllers ->xr-runtime\n  prov ['C-DEVICE'] cons ['C-PAL'] tool [] impl []\n== xr-runtime | expert runtime | parent platform-architect | ws platform | prof ['xr'] | tg ['client', 'tools'] | pl None\n  P: XR integration: OpenXR, stereo/multiview rendering hooks, foveation, reprojection and latency, XR input and hand tracking, comfort and safety requirements.\n  NR: Render pipeline ->render-architect; Generic input actions ->input-system\n  prov ['C-XRVIEW'] cons ['C-PAL', 'C-INPUT', 'C-FRAME', 'C-PRESENT', 'C-VIEW', 'C-DEVICE', 'C-TEMPORAL?', 'C-A11Y'] tool [] impl []\n== content-pipeline-architect | lead runtime | parent engine-architect | ws content | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Asset identity and the content pipeline: asset registry and dependency graph, deterministic incremental per-platform cooking, the cook-step contract, derived-data cache and content-addressed store, distributed cooking, content validation.\n  NR: Format-specific builders (shaders, animation, clusters…) ->shader-system; Runtime loading ->resource-streaming-architect; Import formats ->asset-import-interchange\n  prov ['C-ASSET', 'C-COOK'] cons ['C-SER', 'C-TASK', 'C-REFL'] tool ['C-ML?'] impl []\n== asset-import-interchange | expert tool | parent content-pipeline-architect | ws content | prof ['all'] | tg ['tools'] | pl None\n  P: Importers and interchange: glTF, FBX, OpenUSD, texture and audio source formats, MaterialX/OpenPBR, DCC live link, reimport and source tracking, scan data.\n  NR: Cooking ->content-pipeline-architect; Material model ->material-system\n  prov [] cons ['C-ASSET', 'C-COOK'] tool [] impl []\n== asset-cook-processors | expert tool | parent content-pipeline-architect | ws content | prof ['all'] | tg ['tools'] | pl None\n  P: Generic processors: texture processing and GPU texture-compression encoding, mesh optimization, hosting of collision and other domain builders under the cook contract.\n  NR: Cluster DAG building ->virtualized-geometry-lod; Animation compression ->animation-runtime; Shader compilation ->shader-system\n  prov [] cons ['C-COOK', 'C-MATH', 'C-ML?'] tool [] impl []\n== resource-streaming-architect | lead runtime | parent engine-architect | ws content | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Runtime resource model: handles and explicit lifetime, load requests with priority and deadline, dependency-aware loading, the streaming manager (budgets, eviction, prediction), fallbacks, no-stall loading.\n  NR: IO backends ->async-io-storage; Package format ->package-formats-vfs; Texture-specific streaming ->texture-streaming-vt\n  prov ['C-RES'] cons ['C-ASSET', 'C-VFS', 'C-IO', 'C-TASK', 'C-GPUMEM?', 'C-FRAME', 'C-LIFETIME'] tool [] impl []\n== async-io-storage | expert runtime | parent resource-streaming-architect | ws content | prof ['all'] | tg ['client', 'headless-client', 'server', 'tools'] | pl None\n  P: Async IO: io_uring, IOCP, DirectStorage and console backends, IO scheduling and queue depth, GPU decompression, memory-mapped IO, file-system abstraction, error handling.\n  NR: Streaming decisions ->resource-streaming-architect; Codec choice ->package-formats-vfs\n  prov ['C-IO'] cons ['C-PAL', 'C-TASK', 'C-GPUMEM?'] tool [] impl []","is_error":false}]},"uuid":"5bea0ca3-8732-43bf-b8a5-84a1831049b4","timestamp":"2026-09-29T16:18:24.861Z","sourceToolAssistantUUID":"b94ec1a6-1a1c-4b18-b628-8bec45157db6","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
