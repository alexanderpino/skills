{"parentUuid":"b6ed4b1f-3c2c-4d0e-a8fc-b75a1275acca","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a41a60545d5759240","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ELfEF9axuuAbyrjSrDVhmE","type":"tool_result","content":"===== ml-inference-runtime\n{\"name\": \"ML Inference Runtime\", \"tier\": \"expert\", \"parent\": \"gpu-platform-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Runtime neural-network inference shared by neural rendering, animation, audio and AI: GPU (cooperative-vector / tensor) and CPU backends, model packaging and quantization, scheduling within frame budgets, determinism characteristics.\", \"non_responsibilities\": [[\"Vendor upscalers\", \"reconstruction-upscaling\"], [\"In-shader (fused) networks\", \"shader-system\"], [\"Neural feature design\", \"owning-skill\"], [\"Model training\", \"external:ml-training\"]], \"provides\": [\"C-ML\", \"C-MLGPU\"], \"consumes\": [\"C-TASK\", \"C-RHI?@C-MLGPU\", \"C-RG?@C-MLGPU\", \"C-PAL\"], \"expertise\": [\"inference engines\", \"quantization\", \"cooperative vectors\", \"ONNX\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"headless-client\", \"server\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== render-architect\n{\"name\": \"Render Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"purpose\": \"Rendering architecture: pipeline organization, shading-path choice (forward+, deferred, visibility buffer), render-feature contract, render scene and world\\u2192render sync, scalability tiers from 2D mobile to path-traced, multi-view, debug modes, render threading.\", \"non_responsibilities\": [[\"API backends\", \"gpu-platform-architect\"], [\"Pass scheduling\", \"render-graph-scheduling\"], [\"Individual features (GI, shadows\\u2026)\", \"owning-skill\"]], \"provides\": [\"C-RSCENE\"], \"consumes\": [\"C-RG\", \"C-SPATIAL\", \"C-MATIF\", \"C-FRAME\", \"C-FLOW\", \"C-VIEW\", \"C-GPUTIER\", \"C-ECS?\", \"C-XRVIEW?\", \"C-INSTANCES?\", \"C-A11Y\"], \"expertise\": [\"real-time rendering architecture\", \"GPU-driven pipelines\", \"scalability\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== rhi-core\n{\"name\": \"RHI Core\", \"tier\": \"expert\", \"parent\": \"gpu-platform-architect\", \"profiles\": [\"all\"], \"purpose\": \"Render hardware interface over D3D12, Vulkan, Metal, console APIs and WebGPU: queues and command recording, synchronization, bindless descriptors, PSOs and PSO caching, presentation, capability tiers, GPU crash breadcrumbs, driver workarounds.\", \"non_responsibilities\": [[\"GPU memory allocation\", \"gpu-memory-resources\"], [\"Barrier planning\", \"render-graph-scheduling\"], [\"Shader compilation\", \"shader-system\"], [\"Per-API backend code\", [\"rhi-d3d12\", \"rhi-vulkan\", \"rhi-metal\", \"rhi-webgpu\", \"platform-console\"]]], \"provides\": [\"C-RHI\"], \"consumes\": [\"C-PAL\", \"C-SYNC\", \"C-PRESENT\", \"C-FRAME\"], \"expertise\": [\"D3D12\", \"Vulkan\", \"Metal\", \"GPU synchronization\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== gpu-memory-resources\n{\"name\": \"GPU Memory & Resources\", \"tier\": \"expert\", \"parent\": \"gpu-platform-architect\", \"profiles\": [\"all\"], \"purpose\": \"GPU heaps and suballocation, residency and overcommit, upload/readback rings, sparse/reserved resources, GPU memory budgeting and defragmentation, lifetimes decoupled from frame boundaries.\", \"non_responsibilities\": [[\"Transient aliasing plans\", \"render-graph-scheduling\"], [\"Texture streaming policy\", \"texture-streaming-vt\"]], \"provides\": [\"C-GPUMEM\"], \"consumes\": [\"C-RHI\", \"C-GPUTIER\", \"C-LIFETIME\"], \"expertise\": [\"D3D12MA/VMA-class allocators\", \"residency\", \"sparse resources\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== render-graph-scheduling\n{\"name\": \"Render Graph & GPU Scheduling\", \"tier\": \"expert\", \"parent\": \"gpu-platform-architect\", \"profiles\": [\"all\"], \"purpose\": \"Render graph declaration and compilation, automatic barriers, transient aliasing, async compute and multi-queue scheduling, TBDR pass merging, history resources, work-graph integration, general GPU compute, readback contract.\", \"non_responsibilities\": [[\"Heap allocation\", \"gpu-memory-resources\"], [\"Feature passes\", \"render-architect\"]], \"provides\": [\"C-RG\"], \"consumes\": [\"C-RHI\", \"C-GPUMEM\", \"C-TASK\"], \"expertise\": [\"frame graphs\", \"GPU scheduling\", \"work graphs\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== shader-system\n{\"name\": \"Shader System\", \"tier\": \"expert\", \"parent\": \"gpu-platform-architect\", \"profiles\": [\"all\"], \"purpose\": \"Shading language and dialect, compilation toolchain, permutations, reflection and binding layouts, interop headers, caches and distributed compilation, hot reload, shader debugging, PSO-list gathering.\", \"non_responsibilities\": [[\"Material graphs\", \"material-system\"], [\"Runtime PSO cache\", \"rhi-core\"]], \"provides\": [\"C-SHADER\"], \"consumes\": [\"C-RHI\", \"C-GPUTIER\", \"C-ML?\", \"C-RELOAD?\"], \"expertise\": [\"HLSL\", \"Slang\", \"DXC/SPIR-V\", \"permutation management\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-COOK\"], \"implements\": [], \"workstream\": \"rendering\", \"untrusted_inputs\": [\"ugc-graphs\"]}\n===== material-system\n{\"name\": \"Material System\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"all\"], \"purpose\": \"Material model (OpenPBR-class, layered), material graph \\u2192 shader code generation, instances and parameters, quality tiers, material validation; evaluates neural materials.\", \"non_responsibilities\": [[\"BRDF research reference\", \"research-evidence\"], [\"Graph editor UI\", \"graph-editor-framework\"], [\"Shader compiler\", \"shader-system\"]], \"provides\": [\"C-MATIF\"], \"consumes\": [\"C-SHADER\", \"C-ASSET\", \"C-MLGPU?\", \"C-GPUTIER\"], \"expertise\": [\"PBR\", \"OpenPBR/MaterialX\", \"shader codegen\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-EDCMD\", \"C-EDHOST\", \"C-GRAPH\"], \"implements\": [], \"workstream\": \"rendering\"}\n===== geometry-pipeline\n{\"name\": \"Geometry Submission Pipeline\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Instance scene and geometry submission for every 3D tier: persistent instance data with batched delta updates, the CPU-culled batched/instanced path (first-class on TBDR/mobile and lite3d), and the GPU-driven path (GPU culling, indirect/mesh shaders, visibility buffer) for desktop/console tiers.\", \"non_responsibilities\": [[\"Cluster LOD\", \"virtualized-geometry-lod\"], [\"Render-scene contract\", \"render-architect\"]], \"provides\": [\"C-INSTANCES\"], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-SHADER\", \"C-GPUMEM\", \"C-GPUTIER\", \"C-GEOLOD?\", \"C-TEMPORAL?\"], \"expertise\": [\"GPU culling\", \"mesh shaders\", \"ExecuteIndirect\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== virtualized-geometry-lod\n{\"name\": \"Virtualized Geometry & LOD\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"All geometric LOD: cluster hierarchies and virtualized geometry, cluster DAG building, software micro-polygon rasterization, cluster streaming, discrete LOD, HLOD proxies and impostors, deforming-geometry LOD, displacement.\", \"non_responsibilities\": [[\"HLOD strategy\", \"world-architect\"], [\"Generic mesh optimization\", \"asset-cook-processors\"], [\"RT acceleration structures\", \"ray-tracing-infrastructure\"]], \"provides\": [\"C-GEOLOD\"], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-RES\", \"C-RT?\", \"C-INSTANCES\"], \"expertise\": [\"mesh simplification\", \"cluster LOD\", \"software rasterization\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-COOK\", \"C-EDCMD\", \"C-EDHOST\"], \"implements\": [], \"workstream\": \"rendering\"}\n===== texture-streaming-vt\n{\"name\": \"Textures & Virtual Texturing\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"all\"], \"purpose\": \"Runtime texture formats, mip streaming, sampler-feedback streaming, virtual texturing, streaming-friendly cooked layout; evaluates neural texture compression.\", \"non_responsibilities\": [[\"Texture encoding in cook\", \"asset-cook-processors\"], [\"Streaming manager\", \"resource-streaming-architect\"]], \"provides\": [\"C-VT\"], \"consumes\": [\"C-RES\", \"C-GPUMEM\", \"C-RG\", \"C-ML?\", \"C-MLGPU?\"], \"expertise\": [\"virtual texturing\", \"sampler feedback\", \"texture compression\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-COOK\"], \"implements\": [], \"workstream\": \"rendering\"}\n===== direct-lighting-shadows\n{\"name\": \"Direct Lighting & Shadows\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Light types and physical units, clustered light culling, stochastic many-light sampling, area lights, cascaded, virtual and ray-traced shadows, contact shadows, light profiles.\", \"non_responsibilities\": [[\"Indirect lighting\", \"global-illumination\"], [\"Denoisers\", \"reconstruction-upscaling\"]], \"provides\": [\"C-LIGHT\"], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-RT?\", \"C-TEMPORAL\", \"C-INSTANCES?\", \"C-GEOLOD?\"], \"expertise\": [\"many-light rendering\", \"shadow techniques\", \"ReSTIR DI\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== global-illumination\n{\"name\": \"Global Illumination & Reflections\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Indirect lighting across tiers: baked lightmaps, probe volumes, screen-space GI and AO, surface/radiance-cache hybrid GI, ReSTIR GI, reflections, sky lighting, specular occlusion, SDF scene representations.\", \"non_responsibilities\": [[\"RT infrastructure\", \"ray-tracing-infrastructure\"], [\"Atmosphere model\", \"atmosphere-weather\"]], \"provides\": [\"C-GI\"], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-RT?\", \"C-TEMPORAL\", \"C-LIGHT\", \"C-ATMOS?\", \"C-MLGPU?\"], \"expertise\": [\"real-time GI\", \"radiance caching\", \"lightmapping\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-COOK\", \"C-EDCMD\", \"C-EDHOST\"], \"implements\": [], \"workstream\": \"rendering\"}\n===== ray-tracing-infrastructure\n{\"name\": \"Ray Tracing Infrastructure\", \"tier\": \"expert\", \"parent\": \"gpu-platform-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Acceleration structure management at scale, inline vs pipeline RT, opacity micromaps, RT LOD, software RT fallback, shader execution reordering, cluster/partitioned acceleration structures.\", \"non_responsibilities\": [[\"Lighting algorithms using rays\", \"global-illumination\"], [\"Deformed-geometry updates\", \"deformation-skinning\"]], \"provides\": [\"C-RT\"], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-GPUMEM\", \"C-INSTANCES\", \"C-GPUTIER\"], \"expertise\": [\"DXR/Vulkan RT\", \"BVH construction\", \"RT performance\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== path-tracing\n{\"name\": \"Path Tracing\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Reference path tracer as ground-truth oracle for validation, real-time path tracing, offline cinematic render mode.\", \"non_responsibilities\": [[\"Movie render orchestration\", \"cinematics-sequencer\"], [\"Image comparison tests\", \"render-validation\"]], \"provides\": [], \"consumes\": [\"C-RT?\", \"C-MATIF\", \"C-RSCENE\", \"C-LIGHT\", \"C-GI?\"], \"expertise\": [\"Monte Carlo rendering\", \"ReSTIR PT\", \"spectral rendering\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== reconstruction-upscaling\n{\"name\": \"Reconstruction, Upscaling & Denoising\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"all\"], \"purpose\": \"Temporal anti-aliasing and reconstruction, temporal and ML upscalers, frame generation, dynamic resolution, the motion-vector/jitter/history contract, spatiotemporal and ML denoising, variable-rate shading.\", \"non_responsibilities\": [[\"Signal-specific sampling\", \"global-illumination\"], [\"Frame pacing\", \"frame-orchestration\"]], \"provides\": [\"C-TEMPORAL\"], \"consumes\": [\"C-RG\", \"C-FRAME\", \"C-PRESENT\", \"C-MLGPU?\"], \"expertise\": [\"TAA/TSR\", \"DLSS/FSR/XeSS SDKs\", \"denoisers\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== post-color-hdr\n{\"name\": \"Post-Processing, Color & HDR\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"all\"], \"purpose\": \"Post chain, physical camera and exposure, end-to-end color management (working space, output transforms, OCIO), HDR output and calibration, tonemapping, grading.\", \"non_responsibilities\": [[\"Display enumeration\", \"platform-desktop\"], [\"Upscaling\", \"reconstruction-upscaling\"]], \"provides\": [], \"consumes\": [\"C-RG\", \"C-RHI\", \"C-CFG\", \"C-A11Y\", \"C-PAL\"], \"expertise\": [\"color science\", \"ACES\", \"HDR10/PQ\", \"post effects\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== translucency-decals\n{\"name\": \"Translucency & Decals\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Transparency and OIT, refraction and distortion, decals, translucent lighting and volumetric integration.\", \"non_responsibilities\": [[\"Particle simulation\", \"vfx-particles\"], [\"Volumetric media\", \"atmosphere-weather\"]], \"provides\": [], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-MATIF\", \"C-LIGHT\", \"C-GI?\", \"C-ATMOS?\", \"C-TEMPORAL\"], \"expertise\": [\"OIT\", \"decal systems\", \"translucency sorting\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== character-rendering\n{\"name\": \"Character Rendering\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Skin subsurface scattering, eyes, strand-based hair and fur rendering, digital-human LOD.\", \"non_responsibilities\": [[\"Hair simulation\", \"cloth-deformables\"], [\"Skinning\", \"deformation-skinning\"]], \"provides\": [], \"consumes\": [\"C-RSCENE\", \"C-MATIF\", \"C-ANIM\", \"C-RG\", \"C-LIGHT\", \"C-GI?\"], \"expertise\": [\"SSS\", \"strand rendering\", \"digital humans\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== render-2d-vector\n{\"name\": \"2D, Vector & UI Rendering\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"all\"], \"purpose\": \"2D draw backend shared by 2D games, UI and debug overlays: sprites, tilemaps, 2D lighting, vector paths, UI batching/clipping/SDF, HDR compositing, pixel-perfect modes.\", \"non_responsibilities\": [[\"Widget model\", \"ui-architect\"], [\"Glyph shaping\", \"text-fonts\"]], \"provides\": [\"C-DRAW2D\"], \"consumes\": [\"C-RG\", \"C-SHADER\", \"C-TEXT\", \"C-TEMPORAL?\", \"C-A11Y\"], \"expertise\": [\"2D batching\", \"vector rasterization\", \"SDF rendering\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-EDCMD\", \"C-EDHOST\"], \"implements\": [], \"workstream\": \"rendering\"}\n===== vfx-particles\n{\"name\": \"Particles & VFX\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"all\"], \"purpose\": \"GPU particle simulation, VFX graph runtime, ribbons/beams/mesh particles, particle collision, VFX budgets and significance.\", \"non_responsibilities\": [[\"Physically based fluids\", \"fluid-simulation\"], [\"Translucency sorting\", \"translucency-decals\"]], \"provides\": [], \"consumes\": [\"C-RSCENE\", \"C-RG\", \"C-PHYS?\", \"C-LIGHT?\", \"C-GI?\", \"C-ATMOS?\", \"C-TEMPORAL?\", \"C-ENV?\", \"C-A11Y\"], \"expertise\": [\"GPU particles\", \"VFX authoring\", \"Niagara/VFX Graph-class systems\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-GRAPH\", \"C-EDCMD\", \"C-EDHOST\"], \"implements\": [], \"workstream\": \"rendering\"}\n===== gpu-platform-architect\n{\"name\": \"GPU Platform Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"workstream\": \"rendering\", \"purpose\": \"GPU platform architecture shared by every renderer tier: layering of RHI, GPU memory, render graph, shader system, ray-query and inference infrastructure; the GPU feature-tier model (binding, pipeline-state, queue, mesh, RT, tensor tiers) and API baselines per hardware tier; task-based parallel command recording.\", \"non_responsibilities\": [[\"Renderin