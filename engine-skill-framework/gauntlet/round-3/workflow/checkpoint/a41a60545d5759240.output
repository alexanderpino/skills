runtime\", \"targets\": [\"client\", \"headless-client\", \"server\", \"tools\"], \"tool_consumes\": [\"C-EDCMD\", \"C-EDHOST\"], \"implements\": [\"C-ENV\"], \"workstream\": \"world\"}\n===== atmosphere-weather\n{\"name\": \"Atmosphere, Volumetrics & Weather\", \"tier\": \"expert\", \"parent\": \"world-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Sky and atmospheric scattering, volumetric clouds, volumetric fog and local media, weather state and surface response, time of day.\", \"non_responsibilities\": [[\"Sky lighting capture for GI\", \"global-illumination\"], [\"Translucency compositing\", \"translucency-decals\"]], \"provides\": [\"C-ATMOS\"], \"consumes\": [\"C-RSCENE?\", \"C-RG?\", \"C-FRAME\", \"C-ENV\", \"C-LIGHT?\", \"C-TEMPORAL?\"], \"expertise\": [\"atmospheric scattering\", \"volumetric rendering\", \"weather systems\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"headless-client\", \"server\", \"tools\"], \"tool_consumes\": [\"C-EDCMD\", \"C-EDHOST\"], \"implements\": [\"C-ENV\"], \"workstream\": \"world\"}\n===== procedural-generation\n{\"name\": \"Procedural Content Generation\", \"tier\": \"expert\", \"parent\": \"world-architect\", \"profiles\": [\"openworld\"], \"purpose\": \"Deterministic graph-based PCG framework usable in editor and at stream-in, placement and scattering rules, grammar and constraint methods; evaluates ML generation.\", \"non_responsibilities\": [[\"Foliage-specific rules\", \"vegetation-foliage\"], [\"Graph editor UI\", \"graph-editor-framework\"]], \"provides\": [], \"consumes\": [\"C-WORLD\", \"C-DET\", \"C-ML?\", \"C-INSTANCES?\"], \"expertise\": [\"PCG\", \"WFC\", \"deterministic generation\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"headless-client\", \"server\", \"tools\"], \"tool_consumes\": [\"C-COOK\", \"C-EDCMD\", \"C-EDHOST\", \"C-GRAPH\"], \"implements\": [], \"workstream\": \"world\"}\n===== deformation-skinning\n{\"name\": \"Skinning & Deformation\", \"tier\": \"expert\", \"parent\": \"animation-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"GPU skinning (linear, dual quaternion), morph targets, ML deformers, deformed-geometry acceleration-structure updates, deformation motion vectors.\", \"non_responsibilities\": [[\"Cloth\", \"cloth-deformables\"], [\"Facial solvers\", \"facial-animation\"]], \"provides\": [], \"consumes\": [\"C-ANIM\", \"C-RSCENE\", \"C-RG\", \"C-TEMPORAL\", \"C-RT?\", \"C-ML?\", \"C-INSTANCES?\"], \"expertise\": [\"compute skinning\", \"blendshapes\", \"ML deformers\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"simulation\"}\n===== ui-architect\n{\"name\": \"UI Architect\", \"tier\": \"lead\", \"parent\": \"engine-architect\", \"profiles\": [\"all\"], \"purpose\": \"UI architecture (retained with data binding for game UI, immediate for developer UI), layout, styling, focus and navigation, animation, in-world UI, designer tool logic, UI performance.\", \"non_responsibilities\": [[\"UI draw backend\", \"render-2d-vector\"], [\"Text shaping\", \"text-fonts\"], [\"Editor panels\", \"editor-ui-framework\"]], \"provides\": [\"C-UI\"], \"consumes\": [\"C-REFL\", \"C-INPUT\", \"C-DRAW2D\", \"C-TEXT\", \"C-LOC\", \"C-A11YRT\", \"C-AUDIO?\", \"C-VIDEO?\", \"C-PAL\", \"C-A11Y\"], \"expertise\": [\"UI frameworks\", \"layout algorithms\", \"MVVM\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-EDCMD\", \"C-EDHOST\"], \"implements\": [], \"workstream\": \"ui\"}\n===== visual-debugging-tools\n{\"name\": \"Visual Debugging Tools\", \"tier\": \"expert\", \"parent\": \"editor-architect\", \"profiles\": [\"all\"], \"purpose\": \"Debug draw API, in-game console and cheats, runtime entity inspector and gameplay debugger, visual logger and rewind, debug menus and overlays.\", \"non_responsibilities\": [[\"Logging and traces\", \"observability-telemetry\"], [\"Render buffer visualization\", \"rend