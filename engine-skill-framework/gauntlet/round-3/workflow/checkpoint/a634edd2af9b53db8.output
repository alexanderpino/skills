D','C-CFG','C-IO','C-VFS','C-GPUMEM','C-PRESENT','C-IPC','C-SNAPSHOT','C-DET','C-SCALE','C-CRASH','C-TYPES','C-BASE']:\n  f=[e['id'] for e in m if c in e.get('contracts_frozen',[])]; d=[e['id'] for e in m if c in e.get('contracts_draft',[])]\n  print(c,'frozen',f,'draft',d)\nprint([e['id'] for e in m])\n\"","description":"Check contract freeze milestones"}},"apiBlockIndex":1,"requestId":"req_011CfY39SufmrQNXZewx3eJc","attributionAgent":"general-purpose","type":"assistant","uuid":"5f50122a-05ba-4257-9d64-fc5aa58b3303","timestamp":"2026-09-29T16:22:06.150Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
