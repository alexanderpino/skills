-iteration\"]]\n276\t   RES.MGMT.gpu-requests | Batched GPU-originated streaming requests (feedback buffers) & latency contract | resource-streaming-architect | E | [[\"render-graph-scheduling\"]]\n277\t   RES.MGMT.pipeline | Staged load pipeline, per-stage queues, staging-memory budget, batching, cancellation | resource-streaming-architect | E | [[\"async-io-storage\", \"gpu-memory-resources\"]]\n278\t # RES.IO Asynchronous IO\n279\t   RES.IO.backends | Async IO backends (io_uring, IOCP, DirectStorage, console APIs) | async-io-storage | E | \n280\t   RES.IO.scheduling | IO scheduling, prioritization, queue depth, batching | async-io-storage | E | \n281\t   RES.IO.gpu-decompress | GPU decompression (GDeflate class) | async-io-storage | E | [[\"gpu-memory-resources\"]]\n282\t   RES.IO.mmap | Memory-mapped IO restricted to prefetched/locked or tool-side use | async-io-storage | E | \n283\t   RES.IO.fs | File-system & path abstraction | async-io-storage | E | [[\"platform-architect\"]]\n284\t   RES.IO.errors | IO error handling & retries | async-io-storage | E | \n285\t   RES.IO.cpu-decompress | CPU decompression as an IO stage | async-io-storage | E | \n286\t   RES.IO.hw-decompress | Fixed-function hardware decompression units | async-io-storage | E | [[\"platform-console\", \"package-formats-vfs\"]]\n287\t   RES.IO.remote | HTTP/CDN IO backend with persistent content cache, prefetch & offline policy | async-io-storage | M | [[\"platform-services\"]]\n288\t # RES.PKG Packages & virtual file system\n289\t   RES.PKG.format | Package / container format & chunking | package-formats-vfs | E | \n290\t   RES.PKG.compression | Compression codec selection (Kraken/zstd/LZ4/GDeflate class) | package-formats-vfs | E | \n291\t   RES.PKG.vfs | VFS mounting & layering (base, patch, DLC, mods) | package-formats-vfs | E | \n292\t   RES.PKG.crypto | Content encryption & signing | package-formats-vfs | E | [[\"security-engineering\"]]\n293\t   RES.PKG.install-layout | Install chunks & p