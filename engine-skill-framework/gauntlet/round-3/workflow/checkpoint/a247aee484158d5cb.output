{"parentUuid":"c4f92b77-e96f-4661-9567-4811cedcad1d","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a247aee484158d5cb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XiRCFKijgawJEPFAFBKmEw","type":"tool_result","content":"1\tdict_keys(['_doc', 'contracts'])\n2\t<class 'list'>\n3\tC-PAL {\"id\": \"C-PAL\", \"layer\": 0, \"owner\": \"platform-architect\", \"name\": \"Platform abstraction layer\", \"summary\": \"OS services, CPU/GPU capability discovery and device database, windowing, display & safe area, lifecycle and system events (memory pressure, thermal/power, network reachability, audio endpoint, locale, OS accessibility settings, overlay/focus, storage, page size), clocks and clock-domain correlation, processes/pipes/shared memory/dev sockets, HTTP(S)/TLS client, permissions, thread creation/affinity/QoS and main-thread dispatch. Platform code lives only in the PAL or in a registered pla\n4\tC-ERR {\"id\": \"C-ERR\", \"layer\": 1, \"owner\": \"core-runtime-architect\", \"name\": \"Error & failure model\", \"summary\": \"Result types, assertion tiers, fatal vs recoverable, degradation rules.\", \"requires\": [\"C-BASE\"], \"universal\": \"runtime\", \"conformance\": true}\n5\tC-MOD {\"id\": \"C-MOD\", \"layer\": 1, \"owner\": \"core-runtime-architect\", \"name\": \"Module & lifecycle\", \"summary\": \"Module descriptors, serial bootstrap then parallel init dependency graph, service registration, shutdown order, declarative self-registration (no central tables).\", \"requires\": [\"C-ERR\", \"C-TASK\"], \"conformance\": true}\n6\tC-CFG {\"id\": \"C-CFG\", \"layer\": 1, \"owner\": \"core-runtime-architect\", \"name\": \"Configuration & cvars\", \"summary\": \"Layered config sources (defaults, platform, device profile, remote/live, user) with precedence, typed cvars read through versioned immutable snapshots latched at sync points, queued change notification.\", \"requires\": [\"C-BASE\"], \"conformance\": true}\n7\tC-MATH {\"id\": \"C-MATH\", \"layer\": 1, \"owner\": \"math-simd-numerics\", \"name\": \"Math & numeric conventions\", \"summary\": \"Vector/matrix types, precision classes, deterministic-math variants, fixed and scalable (vector-length-agnostic) SIMD kernels, convention enforcement.\", \"requires\": [], \"conformance\": true}\n8\tC-MEM {\"id\": \"C-MEM\", \"layer\": 1, \"owner\": \"memory-allocators\", \"name\": \"Allocation & memory accounting\", \"summary\": \"Allocator interface, tagging, budgets hooks, OOM behavior.\", \"requires\": [\"C-BASE\"], \"universal\": \"runtime\", \"conformance\": true}\n9\tC-TYPES {\"id\": \"C-TYPES\", \"layer\": 1, \"owner\": \"containers-core-types\", \"name\": \"Core types & containers\", \"summary\": \"Containers, strings, versioned stable hashing, general-purpose compression codecs, vetted cryptographic primitives wrapper, ownership/view types.\", \"requires\": [\"C-MEM\"], \"conformance\": true}\n10\tC-SYNC {\"id\": \"C-SYNC\", \"layer\": 1, \"owner\": \"concurrency-primitives\", \"name\": \"Concurrency primitives & thread-safety annotations\", \"summary\": \"Atomics, locks, lock-free queues, safe reclamation, thread-safety annotation conventions, OS-waitable completion tokens that IO/GPU fences plug into.\", \"requires\": [\"C-BASE\"], \"conformance\": true}\n11\tC-TASK {\"id\": \"C-TASK\", \"layer\": 1, \"owner\": \"job-system-task-graph\", \"name\": \"Task graph & job API\", \"summary\": \"Task creation, dependencies, priorities/QoS, blocking rules, completion-token integration, process-wide thread inventory with pinned/affinity lanes and middleware adapters, serial deterministic test mode and schedule-perturbation hooks, task tracing.\", \"requires\": [\"C-SYNC\", \"C-MEM\"], \"conformance\": true}\n12\tC-INSTR {\"id\": \"C-INSTR\", \"layer\": 1, \"owner\": \"observability-telemetry\", \"name\": \"Instrumentation\", \"summary\": \"Log/trace/metric API; zero cost when compiled out; trace format.\", \"requires\": [\"C-BASE\"], \"universal\": \"runtime\", \"conformance\": true}\n13\tC-CRASH {\"id\": \"C-CRASH\", \"layer\": 1, \"owner\": \"crash-diagnostics\", \"name\": \"Crash & diagnostic hooks\", \"summary\": \"Crash context annotations, breadcrumbs, watchdog registration.\", \"requires\": [\"C-BASE\", \"C-INSTR\"], \"universal\": \"runtime\", \"conformance\": true}\n14\tC-DET {\"id\": \"C-DET\", \"layer\": 1, \"owner\": \"determinism-replay\", \"name\": \"Determinism\", \"summary\": \"Determinism levels, floating-point rules, ordered-execution rules, state-hash hooks.\", \"requires\": [\"C-MATH\"], \"conformance\": true}\n15\tC-BUDGET {\"id\": \"C-BUDGET\", \"layer\": \"P\", \"owner\": \"performance-architect\", \"name\": \"Budgets & performance gates\", \"summary\": \"Budget numbers per hardware tier \\u00d7 configuration \\u00d7 refresh class, derived from the performance model; perf gate thresholds.\", \"requires\": [], \"universal\": \"all\"}\n16\tC-PLUGIN {\"id\": \"C-PLUGIN\", \"layer\": 1, \"owner\": \"plugin-system\", \"name\": \"Plugin descriptor & loading\", \"summary\": \"Plugin manifest, dependency resolution, load phases, ABI tags.\", \"requires\": [\"C-MOD\"], \"conformance\": true}\n17\tC-FRAME {\"id\": \"C-FRAME\", \"layer\": 2, \"owner\": \"frame-orchestration\", \"name\": \"Frame, tick phases & time\", \"summary\": \"Time domains and multi-rate cadences, pipelining depth, the minimal set of named global sync points, frame-wide access declarations (ECS components and registered service resources) from which ordering is derived, the canonical simulation schedule, injectable test clock.\", \"requires\": [\"C-TASK\"], \"conformance\": true}\n18\tC-ID {\"id\": \"C-ID\", \"layer\": 2, \"owner\": \"entity-object-model\", \"name\": \"Identity & references\", \"summary\": \"Entity IDs, GUIDs, reference kinds, lifetime rules, events.\", \"requires\": [\"C-TYPES\"], \"conformance\": true}\n19\tC-ECS {\"id\": \"C-ECS\", \"layer\": 2, \"owner\": \"ecs-runtime\", \"name\": \"ECS\", \"summary\": \"Components, queries, systems, access declarations, command buffers.\", \"requires\": [\"C-ID\", \"C-TASK\", \"C-FRAME\"], \"conformance\": true}\n20\tC-REFL {\"id\": \"C-REFL\", \"layer\": 2, \"owner\": \"reflection-metadata\", \"name\": \"Reflection & type metadata\", \"summary\": \"Type registry, properties, attributes, dynamic invocation.\", \"requires\": [\"C-TYPES\"], \"conformance\": true}\n21\tC-SER {\"id\": \"C-SER\", \"layer\": 2, \"owner\": \"serialization-schema\", \"name\": \"Serialization & schema evolution\", \"summary\": \"Formats, versioning, upgraders, canonical form, untrusted-input rules.\", \"requires\": [\"C-REFL\"], \"conformance\": true}\n22\tC-IO {\"id\": \"C-IO\", \"layer\": 2, \"owner\": \"async-io-storage\", \"name\": \"Async IO\", \"summary\": \"IO requests, priorities, deadlines, completions, decompression targets.\", \"requires\": [\"C-PAL\", \"C-TASK\"], \"conformance\": true}\n23\tC-VFS {\"id\": \"C-VFS\", \"layer\": 2, \"owner\": \"package-formats-vfs\", \"name\": \"Package & VFS mounts\", \"summary\": \"Package format, mount layering (base, patch, DLC, mods, remote), chunk IDs, integrity; codec per target constrained by available hardware decompressors.\", \"requires\": [\"C-IO\", \"C-SER\"], \"conformance\": true}\n24\tC-ASSET {\"id\": \"C-ASSET\", \"layer\": 2, \"owner\": \"content-pipeline-architect\", \"name\": \"Asset identity & references\", \"summary\": \"Asset IDs, soft/hard references, dependency declaration, registry queries.\", \"requires\": [\"C-SER\", \"C-ID\"], \"conformance\": true}\n25\tC-RES {\"id\": \"C-RES\", \"layer\": 2, \"owner\": \"resource-streaming-architect\", \"name\": \"Resource lifetime & streaming requests\", \"summary\": \"Resource handles and explicit lifetime; load requests with priority/deadline; the staged load pipeline (IO \\u2192 decompress \\u2192 fixup \\u2192 GPU upload \\u2192 publish) that every resource type implements; pool registration, pressure signals and shrink-by-deadline requests; residency notifications drained at a declared C-FRAME phase; fallbacks.\", \"requires\": [\"C-ASSET\", \"C-VFS\", \"C-MEM\"], \"conformance\": true}\n26\tC-RELOAD {\"id\": \"C-RELOAD\", \"layer\": 2, \"owner\": \"hot-reload-iteration\", \"name\": \"Hot reload\", \"summary\": \"Change notifications, invalidation, state preservation hooks.\", \"requires\": [\"C-RES\", \"C-MOD\"], \"conformance\": true}\n27\tC-SPATIAL {\"id\": \"C-SPATIAL\", \"layer\": 2, \"owner\": \"spatial-transforms\", \"name\": \"Transforms & spatial queries\", \"summary\": \"Transform representation incl. large-world coordinates, hierarchy, generic spatial queries, per-phase change sets (moved/attached/teleported) consumed by all spatial replicas.\", \"requires\": [\"C-MATH\", \"C-ID\"], \"conformance\": true}\n28\tC-RHI {\"id\": \"C-RHI\", \"layer\": 2, \"owner\": \"rhi-core\", \"name\": \"Render hardware interface\", \"summary\": \"Devices, queues and command recording, completion tokens, binding-model tier (bindless / descriptor-buffer / bind-group), pipeline-state-model tier (monolithic PSO / libraries / shader objects / state-object programs), GPU-generated work primitives, presentation, implicit-sync backends; the RHI consumes C-PRESENT to report present feedback.\", \"requires\": [\"C-PAL\", \"C-MEM\", \"C-SYNC\"], \"needs_implementer\": true, \"conformance\": true}\n29\tC-GPUMEM {\"id\": \"C-GPUMEM\", \"layer\": 2, \"owner\": \"gpu-memory-resources\", \"name\": \"GPU resources & memory\", \"summary\": \"Resource creation, heaps, residency, upload/readback, lifetime.\", \"requires\": [\"C-RHI\"], \"conformance\": true}\n30\tC-ML {\"id\": \"C-ML\", \"layer\": 2, \"owner\": \"ml-inference-runtime\", \"name\": \"ML inference\", \"summary\": \"Model format and packaging, CPU and NPU backends, async invocation, precision classes, budgets.\", \"requires\": [\"C-TASK\", \"C-MEM\"], \"conformance\": true}\n31\tC-WORLD {\"id\": \"C-WORLD\", \"layer\": 3, \"owner\": \"world-architect\", \"name\": \"World partition & streaming cells\", \"summary\": \"Cells, streaming sources, world data activation in budgeted, time-sliced batches with bulk registration.\", \"requires\": [\"C-SPATIAL\", \"C-RES\"], \"conformance\": true}\n32\tC-RG {\"id\": \"C-RG\", \"layer\": 3, \"owner\": \"render-graph-scheduling\", \"name\": \"Render graph\", \"summary\": \"Pass/resource declaration, queues, history resources, readback, dynamic GPU-generated work nodes; barrier output mapped or elided on implicit-sync backends.\", \"requires\": [\"C-RHI\", \"C-GPUMEM\"], \"conformance\": true}\n33\tC-SHADER {\"id\": \"C-SHADER\", \"layer\": 3, \"owner\": \"shader-system\", \"name\": \"Shader interface & interop\", \"summary\": \"Shader modules, permutations and budgets, binding layouts generated per binding tier, interop headers, neural/tensor intrinsics tier.\", \"requires\": [\"C-RHI\"], \"conformance\": true}\n34\tC-MATIF {\"id\": \"C-MATIF\", \"layer\": 3, \"owner\": \"material-system\", \"name\": \"Material interface\", \"summary\": \"Material parameters, shading model inputs, material domains.\", \"requires\": [\"C-SHADER\"], \"conformance\": true}\n35\tC-RSCENE {\"id\": \"C-RSCENE\", \"layer\": 3, \"owner\": \"render-architect\", \"name\": \"Render scene & render features\", \"summary\": \"Render features and views, render-scene data streams extracted as change-tracked deltas (no per-object proxy mirror; CPU cost O(changes)), feature registration with minimum GPU tier, non-mesh primitive kinds.\", \"requires\": [\"C-RG\", \"C-SPATIAL\", \"C-MATIF\"], \"conformance\": true}\n36\tC-TEMPORAL {\"id\": \"C-TEMPORAL\", \"layer\": 3, \"owner\": \"reconstruction-upscaling\", \"name\": \"Temporal data\", \"summary\": \"Motion vectors, jitter, history validity, reactive/transparency masks, resolution scaling; motion-vector obligations for every moving/animated surface; UI/HUD separation for frame generation; depth+motion submission for XR spacewarp.\", \"requires\": [\"C-RG\"], \"conformance\": true}\n37\tC-RT {\"id\": \"C-RT\", \"layer\": 3, \"owner\": \"ray-tracing-infrastructure\", \"name\": \"Ray queries\", \"summary\": \"Ray-query contract with hardware and software (SDF/BVH compute) backends: acceleration structures, instance data, hit/material binding, update policy.\", \"requires\": [\"C-RSCENE\"], \"conformance\": true}\n38\tC-TEXT {\"id\": \"C-TEXT\", \"layer\": 3, \"owner\": \"text-fonts\", \"name\": \"Text layout & glyphs\", \"summary\": \"Shaped glyph runs, font fallback, glyph atlas/curve data.\", \"requires\": [\"C-TYPES\"], \"conformance\": true}\n39\tC-DRAW2D {\"id\": \"C-DRAW2D\", \"layer\": 3, \"owner\": \"render-2d-vector\", \"name\": \"2D draw lists\", \"summary\": \"Batched 2D/vector/text draw submission used by UI, 2D games, debug overlays.\", \"requires\": [\"C-RG\", \"C-SHADER\", \"C-TEXT\"], \"conformance\": true}\n40\tC-PHYS {\"id\": \"C-PHYS\", \"layer\": 3, \"owner\": \"physics-architect\", \"name\": \"Physics world & scene queries\", \"summary\": \"Bodies, shapes, queries (handle-addressed, batched), contact events with budgets, stepping phases, batch add/remove O(batch), snapshot/restore/resimulate participation, collider history for rewind.\", \"requires\": [\"C-SPATIAL\", \"C-FRAME\", \"C-ID\"], \"conformance\": true}\n41\tC-ANIM {\"id\": \"C-ANIM\", \"layer\": 3, \"owner\": \"animation-architect\", \"name\": \"Animation pose output\", \"summary\": \"Pose output and control input (parameters, action/montage requests, instance lifetime), root motion, animation events, pose history for rewind, network-sync hooks, physics/render hand-off.\", \"requires\": [\"C-SPATIAL\", \"C-ID\"], \"conformance\": true}\n42\tC-AUDIO {\"id\": \"C-AUDIO\", \"layer\": 3, \"owner\": \"audio-architect\", \"name\": \"Audio emitters & events\", \"summary\": \"Emitter/listener data (multiple listeners), event triggering, parameters, busses, the sample-accurate audio clock exposed to gameplay.\", \"requires\": [\"C-SPATIAL\", \"C-ID\"], \"conformance\": true}\n43\tC-INPUT {\"id\": \"C-INPUT\", \"layer\": 3, \"owner\": \"input-system\", \"name\": \"Input actions\", \"summary\": \"Action definitions and values, tick-stamped input-command frames and their serialization (all targets incl. server); device binding contexts are client-side.\", \"requires\": [\"C-FRAME\"], \"conformance\": true}\n44\tC-NET {\"id\": \"C-NET\", \"layer\": 3, \"owner\": \"network-architect\", \"name\": \"Netcode model & authority policy\", \"summary\": \"Netcode model per game type, authority model, net tick and time policy, compatibility window and handshake policy.\", \"requires\": [\"C-FRAME\", \"C-ID\"], \"conformance\": true}\n45\tC-SVC {\"id\": \"C-SVC\", \"layer\": 3, \"owner\": \"platform-services\", \"name\": \"Platform services\", \"summary\": \"Identity tokens, entitlements & commerce, privileges, social graph, achievements, leaderboards, cloud save, region/age policy.\", \"requires\": [\"C-PAL\", \"C-TASK\"], \"conformance\": true}\n46\tC-LOC {\"id\": \"C-LOC\", \"layer\": 3, \"owner\": \"localization-i18n\", \"name\": \"Localized strings\", \"summary\": \"String IDs, formatting, locale switching.\", \"requires\": [\"C-ASSET\"], \"conformance\": true}\n47\tC-UI {\"id\": \"C-UI\", \"layer\": 3, \"owner\": \"ui-architect\", \"name\": \"UI widgets & binding\", \"summary\": \"Widget model, data binding, focus, layout.\", \"requires\": [\"C-REFL\", \"C-INPUT\", \"C-DRAW2D\", \"C-TEXT\", \"C-LOC\"], \"conformance\": true}\n48\tC-NAV {\"id\": \"C-NAV\", \"layer\": 3, \"owner\": \"navigation-pathfinding\", \"name\": \"Navigation queries\", \"summary\": \"Path requests, navmesh/grid queries, dynamic obstacles.\", \"requires\": [\"C-SPATIAL\"], \"conformance\": true}\n49\tC-GAME {\"id\": \"C-GAME\", \"layer\": 4, \"owner\": \"gameplay-architect\", \"name\": \"Gameplay framework extension\", \"summary\": \"Game module entry points, rules/session state, data-oriented control binding (input source or AI \\u2192 controlled entity), scheduled gameplay systems, extension hooks.\", \"requires\": [\"C-ID\", \"C-FRAME\"], \"conformance\": true}\n50\tC-SCRIPT {\"id\": \"C-SCRIPT\", \"layer\": 3, \"owner\": \"scripting-runtime\", \"name\": \"Script bindings\", \"summary\": \"Binding generation, sandbox limits, script lifecycle.\", \"requires\": [\"C-REFL\"], \"conformance\": true}\n51\tC-SAVE {\"id\": \"C-SAVE\", \"layer\": 3, \"owner\": \"persistence-save\", \"name\": \"Save games\", \"summary\": \"Save participation, versioned save records, async save/load.\", \"requires\": [\"C-SER\", \"C-ID\"], \"conformance\": true}\n52\tC-COOK {\"id\": \"C-COOK\", \"layer\": 5, \"owner\": \"content-pipeline-architect\", \"name\": \"Cook-step processors\", \"summary\": \"Processor inputs, cache keys, determinism class (bit-exact / tolerance / pinned-artifact), platform variants, world-scope steps, per-asset on-demand invocation, validation hooks.\", \"requires\": [\"C-ASSET\", \"C-SER\", \"C-TASK\"], \"conformance\": true}\n53\tC-EDCMD {\"id\": \"C-EDCMD\", \"layer\": 5, \"owner\": \"editor-architect\", \"name\": \"Editor commands & tool extension\", \"summary\": \"Transactions, undo/redo, selection, tool registration.\", \"requires\": [\"C-REFL\", \"C-SER\"], \"conformance\": true}\n54\tC-GRAPH {\"id\": \"C-GRAPH\", \"layer\": 5, \"owner\": \"graph-editor-framework\", \"name\": \"Graph authoring & compilation\", \"summary\": \"Node/pin model, validation, compilation hooks for domain graphs.\", \"requires\": [\"C-EDCMD\"], \"conformance\": true}\n55\tC-BUILD {\"id\": \"C-BUILD\", \"layer\": 5, \"owner\": \"build-system-toolchains\", \"name\": \"Build description\", \"summary\": \"Targets, configurations, toolchains, codegen steps.\", \"requires\": [], \"conformance\": true}\n56\tC-PKG {\"id\": \"C-PKG\", \"layer\": 5, \"owner\": \"packaging-release-patching\", \"name\": \"Release packages & patches\", \"summary\": \"Package manifests, patch/DLC chunks, version compatibility.\", \"requires\": [\"C-VFS\", \"C-BUILD\"], \"conformance\": true}\n57\tC-ARCH {\"id\": \"C-ARCH\", \"layer\": \"P\", \"owner\": \"engine-architect\", \"name\": \"Architecture, layering & profiles\", \"summary\": \"Layer rules, contract registry, configuration profiles, conventions.\", \"requires\": [], \"universal\": \"all\"}\n58\tC-ADR {\"id\": \"C-ADR\", \"layer\": \"P\", \"owner\": \"architecture-governance\", \"name\": \"ADR & fitness functions\", \"summary\": \"ADR template incl. revisit conditions; automated architectural checks.\", \"requires\": [], \"universal\": \"all\"}\n59\tC-EVID {\"id\": \"C-EVID\", \"layer\": \"P\", \"owner\": \"research-evidence\", \"name\": \"Evidence grading\", \"summary\": \"Source tiers, maturity classes, claim standards.\", \"requires\": [], \"universal\": \"all\"}\n60\tC-ORCH {\"id\": \"C-ORCH\", \"layer\": \"P\", \"owner\": \"program-orchestration\", \"name\": \"Agent coordination protocol\", \"summary\": \"Ownership ledger with access classes; write sets by module convention (src/<skill-id>/, tools/<skill-id>/; tests owned by the test-owning skill); shared-file protocol; contributor semantics (review + change request, never direct writes); change requests; integration order and milestones; human-gate tasks; failure triage; per-change provenance; critic gates with calibration and independent adjudication.\", \"requires\": [], \"universal\": \"all\"}\n61\tC-TEST {\"id\": \"C-TEST\", \"layer\": \"P\", \"owner\": \"test-architect\", \"name\": \"Test & validation definition of done\", \"summary\": \"Required test kinds per skill, test determinism, coverage & mutation thresholds, the evidence bundle an implementer hands to S3/S4 critics, oracle independence, conformance suites owned by contract owners with consumer-driven additions.\", \"requires\": [], \"universal\": \"all\"}\n62\tC-API {\"id\": \"C-API\", \"layer\": \"P\", \"owner\": \"api-lifecycle-migration\", \"name\": \"API stability & deprecation\", \"summary\": \"Public vs internal APIs, versioning, deprecation windows, upgraders.\", \"requires\": [], \"universal\": \"all\"}\n63\tC-TRUST {\"id\": \"C-TRUST\", \"layer\": \"P\", \"owner\": \"security-engineering\", \"name\": \"Trust boundaries\", \"summary\": \"Untrusted inputs list, validation obligations, sandbox rules.\", \"requires\": [], \"universal\": \"all\"}\n64\tC-A11Y {\"id\": \"C-A11Y\", \"layer\": \"P\", \"owner\": \"accessibility\", \"name\": \"Accessibility requirements\", \"summary\": \"Mapped guideline requirements per player-facing feature.\", \"requires\": []}\n65\tC-BASE {\"id\": \"C-BASE\", \"layer\": 0, \"owner\": \"platform-architect\", \"name\": \"Bootstrap base\", \"summary\": \"Raw page allocator, raw log/assert/abort sink, monotonic clock, raw thread primitives and late-bound hook tables that higher layers install (allocator, log sink, assert handler, crash annotator). Depends on nothing.\", \"requires\": [], \"conformance\": true}\n66\tC-LIFETIME {\"id\": \"C-LIFETIME\", \"layer\": 1, \"owner\": \"core-runtime-architect\", \"name\": \"Ownership & retirement\", \"summary\": \"Engine-wide ownership and cross-thread reference rules; deferred-destruction/retirement service keyed to completion tokens (task completion, frames in flight, GPU fences).\", \"requires\": [\"C-SYNC\"], \"conformance\": true}\n67\tC-IPC {\"id\": \"C-IPC\", \"layer\": 2, \"owner\": \"core-runtime-architect\", \"name\": \"Engine IPC\", \"summary\": \"Process model and IPC/RPC transport for editor\\u2194runtime, tool workers, crash handler, profiler and script debugger; dev-only port security.\", \"requires\": [\"C-PAL\", \"C-TASK\"], \"conformance\": true}\n68\tC-SCALE {\"id\": \"C-SCALE\", \"layer\": 1, \"owner\": \"runtime-scalability\", \"name\": \"Scalability & governor\", \"summary\": \"Device-profile knobs, scalability cvars, budget query/report API, actuator registration and governor control signals.\", \"requires\": [\"C-CFG\"], \"universal\": \"runtime\", \"conformance\": true}\n69\tC-FLOW {\"id\": \"C-FLOW\", \"layer\": 2, \"owner\": \"frame-orchestration\", \"name\": \"Cross-subsystem data channels\", \"summary\": \"Versioned snapshots, double/triple-buffered hand-off, mailboxes and multi-rate resampling between subsystems; producer/consumer declared per channel. The default for runtime data flow; global barriers need an ADR.\", \"requires\": [\"C-FRAME\"], \"conformance\": true}\n70\tC-PRESENT {\"id\": \"C-PRESENT\", \"layer\": 2, \"owner\": \"frame-orchestration\", \"name\": \"Present timeline\", \"summary\": \"Present timeline and display-time prediction, latency markers, interposed presenters (frame generation, XR compositor, cloud encoder), GPU-frame-complete and present-feedback sink implemented by the RHI (dependency inversion).\", \"requires\": [\"C-FRAME\"], \"conformance\": true}\n71\tC-SNAPSHOT {\"id\": \"C-SNAPSHOT\", \"layer\": 2, \"owner\": \"determinism-replay\", \"name\": \"Frame-state snapshot & resimulation\", \"summary\": \"Snapshot/restore, resimulate N ticks, history ring, per-participant cost declaration.\", \"requires\": [\"C-FRAME\", \"C-SER\"], \"conformance\": true}\n72\tC-REPLAY {\"id\": \"C-REPLAY\", \"layer\": 3, \"owner\": \"determinism-replay\", \"name\": \"Replay container & streams\", \"summary\": \"Replay container, timeline, stream registration (input, replication, visual log, animation debug, external/nondeterministic inputs) and cross-build versioning.\", \"requires\": [\"C-SNAPSHOT\", \"C-SER\"], \"conformance\": true}\n73\tC-VIEW {\"id\": \"C-VIEW\", \"layer\": 2, \"owner\": \"spatial-transforms\", \"name\": \"Views & view arbitration\", \"summary\": \"View registry: view sources (gameplay camera, cinematic, editor, photo mode, XR pose) with priority/blend stack and shake/FOV channels, per-local-player views, view origin for LWC rebasing; derived listener and streaming-source signals for sinks.\", \"requires\": [\"C-SPATIAL\"], \"conformance\": true}\n74\tC-SIGNIF {\"id\": \"C-SIGNIF\", \"layer\": 2, \"owner\": \"world-architect\", \"name\": \"Significance & simulation tiers\", \"summary\": \"Per-entity significance, simulation tier and update budget, computed once from views/players (all players on a server) and consumed by each domain's LOD policy.\", \"requires\": [\"C-VIEW\"], \"conformance\": true}\n75\tC-ENV {\"id\": \"C-ENV\", \"layer\": 3, \"owner\": \"world-architect\", \"name\": \"Environment queries\", \"summary\": \"Environment query service: ground height/surface type, water surface/volume (height, velocity, depth, body id), wind field, weather parameters, deformation deltas; implemented by terrain, water, atmosphere and voxel providers; headless-capable.\", \"requires\": [\"C-SPATIAL\"], \"conformance\": true}\n76\tC-GPUTIER {\"id\": \"C-GPUTIER\", \"layer\": 2, \"owner\": \"gpu-platform-architect\", \"name\": \"GPU feature tiers\", \"summary\": \"Named GPU feature tiers (binding model, pipeline-state model, queue topology, mesh/RT/tensor support, memory model) and the API baseline each tier maps to; render features declare the minimum tier they need.\", \"requires\": [\"C-RHI\"], \"conformance\": true}\n77\tC-INSTANCES {\"id\": \"C-INSTANCES\", \"layer\": 3, \"owner\": \"geometry-pipeline\", \"name\": \"Instance scene\", \"summary\": \"Persistent instance/primitive handles, batched add/remove/update with delta upload (cost O(changes)), instance data layout shared with the ray-tracing instance builder; served by both CPU and GPU submission paths.\", \"requires\": [\"C-RG\", \"C-GPUMEM\"], \"conformance\": true}\n78\tC-GEOLOD {\"id\": \"C-GEOLOD\", \"layer\": 3, \"owner\": \"virtualized-geometry-lod\", \"name\": \"Geometry LOD & page residency\", \"summary\": \"Cluster/LOD selection and page residency for raster, shadow and ray-tracing consumers.\", \"requires\": [\"C-RG\"], \"conformance\": true}\n79\tC-VT {\"id\": \"C-VT\", \"layer\": 3, \"owner\": \"texture-streaming-vt\", \"name\": \"Texture residency & virtual texturing\", \"summary\": \"Texture residency requests, VT page tables/feedback and allocation for terrain, materials and runtime-composited textures.\", \"requires\": [\"C-RG\", \"C-GPUMEM\"], \"conformance\": true}\n80\tC-LIGHT {\"id\": \"C-LIGHT\", \"layer\": 3, \"owner\": \"direct-lighting-shadows\", \"name\": \"Direct lighting sampling\", \"summary\": \"Light lists (clustered or stochastic), shadow lookups, light units, many-light sampling API for any shading point incl. translucency, volumes and particles.\", \"requires\": [\"C-RSCENE\"], \"conformance\": true}\n81\tC-GI {\"id\": \"C-GI\", \"layer\": 3, \"owner\": \"global-illumination\", \"name\": \"Indirect lighting sampling\", \"summary\": \"Indirect diffuse/specular sampling for any shading point (incl. translucent and volumetric), probes, sky/environment lighting.\", \"requires\": [\"C-RSCENE\"], \"conformance\": true}\n82\tC-ATMOS {\"id\": \"C-ATMOS\", \"layer\": 3, \"owner\": \"atmosphere-weather\", \"name\": \"Atmosphere & participating media\", \"summary\": \"Aerial perspective, froxel/local media volumes, cloud shadows, weather-driven global material parameters.\", \"requires\": [\"C-RSCENE\"], \"conformance\": true}\n83\tC-VIDEO {\"id\": \"C-VIDEO\", \"layer\": 3, \"owner\": \"media-playback\", \"name\": \"Video surfaces\", \"summary\": \"Video playback sessions, surfaces as textures, timing against the audio clock.\", \"requires\": [\"C-RG\"], \"conformance\": true}\n84\tC-DEVICE {\"id\": \"C-DEVICE\", \"layer\": 2, \"owner\": \"input-devices-haptics\", \"name\": \"Input devices & haptics\", \"summary\": \"Device enumeration, raw state and events with timestamps, device\\u2194platform-user pairing, haptic, trigger-effect and LED output, virtual device injection for automation.\", \"requires\": [\"C-PAL\"], \"conformance\": true}\n85\tC-NETLINK {\"id\": \"C-NETLINK\", \"layer\": 2, \"owner\": \"network-transport\", \"name\": \"Network links & sessions\", \"summary\": \"Sessions, channels, reliability/ordering classes, send budgets, link statistics, connection events; used by replication, voice, rollback input exchange and telemetry streams.\", \"requires\": [\"C-PAL\", \"C-TASK\"], \"conformance\": true}\n86\tC-REP {\"id\": \"C-REP\", \"layer\": 3, \"owner\": \"replication\", \"name\": \"Replication\", \"summary\": \"Replicated state declaration, relevancy hooks, RPCs, net IDs, batch registration, replay and spectator streams.\", \"requires\": [\"C-NETLINK\", \"C-SER\", \"C-ID\"], \"conformance\": true}\n87\tC-PREDICT {\"id\": \"C-PREDICT\", \"layer\": 3, \"owner\": \"prediction-rollback\", \"name\": \"Prediction & rollback\", \"summary\": \"Predicted/rollback-able state registration, tick-stamped input history, resimulation hooks, rewind queries, cosmetic-effect suppression during resim.\", \"requires\": [\"C-REP\", \"C-DET\", \"C-SNAPSHOT\", \"C-INPUT\"], \"conformance\": true}\n88\tC-MOVE {\"id\": \"C-MOVE\", \"layer\": 4, \"owner\": \"character-movement\", \"name\": \"Character movement\", \"summary\": \"Movement modes, move requests, resimulatable move API, root-motion hand-off.\", \"requires\": [\"C-PHYS\", \"C-GAME\"], \"conformance\": true}\n89\tC-GAMEDATA {\"id\": \"C-GAMEDATA\", \"layer\": 3, \"owner\": \"gameplay-data\", \"name\": \"Gameplay data\", \"summary\": \"Data tables, curve assets, tuning assets with overrides, live override layer.\", \"requires\": [\"C-REFL\", \"C-ASSET\"], \"conformance\": true}\n90\tC-DIALOGUE {\"id\": \"C-DIALOGUE\", \"layer\": 3, \"owner\": \"narrative-dialogue\", \"name\": \"Dialogue lines & narrative state\", \"summary\": \"Line records (speaker, text per locale, VO per locale, timing, lip-sync data), conditions, playback requests, narrative fact store.\", \"requires\": [\"C-LOC\", \"C-ID\"], \"conformance\": true}\n91\tC-AIAGENT {\"id\": \"C-AIAGENT\", \"layer\": 4, \"owner\": \"ai-behavior-perception\", \"name\": \"AI decision-provider extension point\", \"summary\": \"Optional decision providers (learned policies, LLM agents) with budget, timeout, moderation and authored fallback.\", \"requires\": [\"C-GAME\"], \"conformance\": true}\n92\tC-A11YRT {\"id\": \"C-A11YRT\", \"layer\": 3, \"owner\": \"accessibility\", \"name\": \"Accessibility runtime\", \"summary\": \"Caption/subtitle submission, screen-reader announcements and accessibility-tree ingestion, TTS/STT, accessibility settings and change events.\", \"requires\": [\"C-TEXT\"], \"conformance\": true}\n93\tC-DEVUI {\"id\": \"C-DEVUI\", \"layer\": 3, \"owner\": \"visual-debugging-tools\", \"name\": \"Developer UI\", \"summary\": \"Immediate-mode developer UI and debug menus available in development builds on every target.\", \"requires\": [\"C-DRAW2D\"], \"conformance\": true}\n94\tC-EDHOST {\"id\": \"C-EDHOST\", \"layer\": 5, \"owner\": \"editor-ui-framework\", \"name\": \"Editor host\", \"summary\": \"Asset-editor host, preview-scene registration, thumbnail providers, inspector customization, tool-mode registration, shared curve/timeline widgets.\", \"requires\": [\"C-EDCMD\"], \"conformance\": true}\n95\tC-LIVE {\"id\": \"C-LIVE\", \"layer\": 3, \"owner\": \"online-services-liveops\", \"name\": \"Online & live-ops services\", \"summary\": \"Sessions/matchmaking tickets, remote config, events/experiments, chat sessions, moderation, generative/inference service calls with quotas, trusted time, service emulation.\", \"requires\": [\"C-PAL\", \"C-TASK\"], \"conformance\": true}\n96\tC-XRVIEW {\"id\": \"C-XRVIEW\", \"layer\": 3, \"owner\": \"xr-runtime\", \"name\": \"XR views\", \"summary\": \"View poses, projections, foveation maps, compositor layers and spacewarp depth/motion submission.\", \"requires\": [\"C-VIEW\"], \"conformance\": true}\n97\tC-MLGPU {\"id\": \"C-MLGPU\", \"layer\": 3, \"owner\": \"ml-inference-runtime\", \"name\": \"GPU inference\", \"summary\": \"Inference as a render-graph pass under async-compute and budget scheduling; weights for in-shader networks.\", \"requires\": [\"C-RG\", \"C-ML\"], \"conformance\": true}\n98\tC-CERT {\"id\": \"C-CERT\", \"layer\": \"P\", \"owner\": \"certification-compliance\", \"name\": \"External requirements register\", \"summary\": \"Register of external requirements per program (console cert, Steam Deck Verified, store review, law) each mapped to an owning capability; owners must satisfy their entries.\", \"requires\": [], \"universal\": \"all\"}\n99\tC-PERF {\"id\": \"C-PERF\", \"layer\": \"P\", \"owner\": \"performance-architect\", \"name\": \"Performance findings protocol\", \"summary\": \"Finding format (hypothesis, capture, attribution, expected gain), routing as a change request to the owning skill, time-boxed territory loans recorded in the ledger.\", \"requires\": [], \"universal\": \"all\"}\n100\tC-BENCH {\"id\": \"C-BENCH\", \"layer\": \"P\", \"owner\": \"perf-benchmarking\", \"name\": \"Benchmark registration\", \"summary\": \"Benchmark registration, metric schema, C-BUDGET line reference, warm-up and variance rules, required hardware tier, replay-driven runs.\", \"requires\": [], \"universal\": \"all\"}\n101\tC-PROD {\"id\": \"C-PROD\", \"layer\": \"P\", \"owner\": \"engine-product-management\", \"name\": \"Engine roadmap & intake\", \"summary\": \"Roadmap priorities consumed by work decomposition, intake/triage SLAs, release-note obligations.\", \"requires\": []}\n102\tC-RELEASE {\"id\": \"C-RELEASE\", \"layer\": \"P\", \"owner\": \"build-release-architect\", \"name\": \"Release model\", \"summary\": \"Branch model, release trains, version identifiers, client/server/content compatibility keys, LTS and hotfix streams.\", \"requires\": []}\n103\t"}]},"uuid":"4b413499-0bba-4251-b853-64f87667f943","timestamp":"2026-09-29T16:20:37.579Z","sourceToolAssistantUUID":"c4f92b77-e96f-4661-9567-4811cedcad1d","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
