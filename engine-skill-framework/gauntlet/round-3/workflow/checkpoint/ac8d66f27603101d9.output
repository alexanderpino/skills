ch\": \"L4S low-latency congestion signalling\",\n \"class\": \"X\",\n \"capabilities\": [\n  \"NET.TRANS.l4s\"\n ],\n \"owner\": \"network-transport\",\n \"evidence\": \"RFC 9330\\u20139332\",\n \"revisit\": \"Deployed on two major access networks\",\n \"fallback\": \"Standard congestion control\"\n}\n{\n \"tech\": \"NPU inference backends in games\",\n \"class\": \"X\",\n \"owner\": \"ml-inference-runtime\",\n \"capabilities\": [\n  \"ML.RT.npu\"\n ],\n \"evidence\": \"NNAPI deprecated (Android 15); Windows ML GA 2025\",\n \"revisit\": \"Shipped title offloads a frame-relevant network to an NPU on two platforms\",\n \"fallback\": \"GPU/CPU backend\"\n}\n{\n \"tech\": \"Work graphs & mesh nodes (RND.GEO.mesh-nodes)\",\n \"class\": \"X\",\n \"capabilities\": [\n  \"RND.GEO.mesh-nodes\"\n ],\n \"owner\": \"geometry-pipeline\",\n \"evidence\": \"D3D12 Work Graphs 1.0 (2024); vendor samples; no shipped titles\",\n \"revisit\": \"Support on \\u22652 console/desktop APIs and one shipped-title postmortem\",\n \"fallback\": \"Indirect / device-generated commands\"\n}\n{\n \"tech\": \"Work graphs & mesh nodes (RND.RHI.work-graph-programs)\",\n \"class\": \"X\",\n \"capabilities\": [\n  \"RND.RHI.work-graph-programs\"\n ],\n \"owner\": \"rhi-core\",\n \"evidence\": \"D3D12 Work Graphs 1.0 (2024); vendor samples; no shipped titles\",\n \"revisit\": \"Support on \\u22652 console/desktop APIs and one shipped-title postmortem\",\n \"fallback\": \"Indirect / device-generated commands\"\n}\n{\n \"tech\": \"Gaussian splatting & radiance fields (RND.GEO.splats)\",\n \"class\": \"M\",\n \"capabilities\": [\n  \"RND.GEO.splats\"\n ],\n \"owner\": \"geometry-pipeline\",\n \"evidence\": \"Kerbl et al. 2023; 3DGRT 2024; glTF splat extension work\",\n \"revisit\": \"Standard format + relighting + shipped game use\",\n \"fallback\": \"Photogrammetry meshes\"\n}\n{\n \"tech\": \"Gaussian splatting & radiance fields (CNT.IMP.splats)\",\n \"class\": \"X\",\n \"capabilities\": [\n  \"CNT.IMP.s