{"parentUuid":"40c38647-7583-47c4-8c23-0230a4ab78d0","isSidechain":true,"promptId":"10d83fbe-32cf-4872-a1ef-e8cfbcf10d96","agentId":"ac8d66f27603101d9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014j1vCekxbyukYNvHoYWRws","type":"tool_result","content":"docs/00-design-principles.md:43:- **Tool code stays on the tool side.** Tool contracts (L5) may only be consumed from `tool_consumes`, so editor code can never enter a shipping or server build.\nscripts/check.py:33:  * tool-side capabilities and world tools reach tool contracts (C-COOK/C-EDCMD/C-EDHOST/C-EDVIEW);\nscripts/check.py:175:        for side in (\"consumes\", \"tool_consumes\"):\nscripts/check.py:186:                    E(f\"runtime skill {sid} consumes tool contract {cid} from runtime code (move to tool_consumes)\")\nscripts/check.py:381:        reach = {m.parse_dep(d)[0] for d in s[\"consumes\"] + s[\"tool_consumes\"]} | set(s[\"provides\"])\nscripts/check.py:490:    # -- tool-side territory reaches the editor/cook through tool contracts\nscripts/check.py:495:            if s_.get(\"kind\") == \"runtime\" and not s_.get(\"tool_consumes\"):\nscripts/check.py:496:                E(f\"runtime skill {c['owner']} owns tool-side capability {cid} but consumes no tool contract\")\nscripts/check.py:498:                                                         m.skill(c[\"owner\"]).get(\"tool_consumes\", [])} \\\nscripts/check.py:618:        (\"ML owner without inference path\", lambda m: m.skill(\"motion-synthesis\").__setitem__(\"consumes\", [\"C-ANIM\"]) or m.skill(\"motion-synthesis\").__setitem__(\"tool_consumes\", []), \"consumes no inference contract\"),","is_error":false}]},"uuid":"e484a72d-a58b-43be-b910-9022a2cb702a","timestamp":"2026-09-29T16:56:52.188Z","sourceToolAssistantUUID":"40c38647-7583-47c4-8c23-0230a4ab78d0","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"c