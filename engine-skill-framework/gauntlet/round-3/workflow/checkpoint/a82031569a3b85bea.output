ity\"\n}\n\n{\n\"id\": \"api-lifecycle-migration\",\n\"name\": \"API Lifecycle & Engine Migration\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Public API surface, semantic versioning and deprecation, ABI policy, engine-upgrade tooling (codemods, data upgraders) and LTS policy, so projects can move across engine versions.\",\n\"non_responsibilities\": [\n[\n\"Data schema mechanisms\",\n\"serialization-schema\"\n],\n[\n\"Plugin loading\",\n\"plugin-system\"\n]\n],\n\"provides\": [\n\"C-API\"\n],\n\"consumes\": [\n\"C-SER\",\n\"C-REFL\",\n\"C-RELEASE\"\n],\n\"expertise\": [\n\"API design\",\n\"semver\",\n\"clang tooling codemods\"\n],\n\"kind\": \"process\",\n\"targets\": [],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"governance\"\n}\n\n{\n\"id\": \"developer-experience-docs\",\n\"name\": \"Developer Experience & Documentation\",\n\"tier\": \"cross-cutting\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Documentation and developer experience: API reference, architecture docs, the sample-project ladder (2D \\u2192 open-world online) that doubles as integration tests, templates, onboarding, doc testing, error-message standards, DX metrics.\",\n\"non_responsibilities\": [\n[\n\"ADR records\",\n\"architecture-governance\"\n],\n[\n\"Iteration-time tooling\",\n\"hot-reload-iteration\"\n]\n],\n\"provides\": [],\n\"consumes\": [],\n\"expertise\": [\n\"technical writing\",\n\"docs-as-code\",\n\"sample design\",\n\"DX metrics\"\n],\n\"kind\": \"process\",\n\"targets\": [],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"governance\"\n}\n\n{\n\"id\": \"content-pipeline-architect\",\n\"name\": \"Content Pipeline Architect\",\n\"tier\": \"lead\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Asset identity and the content pipeline: asset registry and dependency graph, deterministic incremental per-platform cooking, the cook-step contract, derived-data cache and content-addressed store, distributed cooking, content validation.\",\n\"non_responsibilities\": [\n[\n\"Format-specific builders (shaders, animation, clusters\\u2026)\",\n\"shader-system\"\n],\n[\n\"Runtime loading\",\n\"resource-streaming-architect\"\n],\n[\n\"Import formats\",\n\"asset-import-interchange\"\n]\n],\n\"provides\": [\n\"C-ASSET\",\n\"C-COOK\"\n],\n\"consumes\": [\n\"C-SER\",\n\"C-TASK\",\n\"C-REFL\"\n],\n\"expertise\": [\n\"build systems for data\",\n\"content-addressed storage\",\n\"incremental computation\"\n],\n\"kind\": \"runtime\",\n\"targets\": [\n\"client\",\n\"headless-client\",\n\"server\",\n\"tools\"\n],\n\"tool_consumes\": [\n\"C-ML?\"\n],\n\"implements\": [],\n\"workstream\": \"content\"\n}\n\n{\n\"id\": \"collaboration-version-control\",\n\"name\": \"Collaboration & Version Control\",\n\"tier\": \"expert\",\n\"parent\": \"editor-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Source-control integration, locking and checkout, multi-user concurrent editing, merge tooling for scene and asset data, content review, large-binary storage strategy.\",\n\"non_responsibilities\": [\n[\n\"Branching model\",\n\"build-release-architect\"\n],\n[\n\"File-per-object layout\",\n\"world-data-model\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-EDCMD\",\n\"C-SER\",\n\"C-ASSET\",\n\"C-RELEASE\"\n],\n\"expertise\": [\n\"Perforce\",\n\"Git LFS\",\n\"CRDT/OT for editing\"\n],\n\"kind\": \"tool\",\n\"targets\": [\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"tools\"\n}\n\n{\n\"id\": \"build-release-architect\",\n\"name\": \"Build & Release Architect\",\n\"tier\": \"lead\",\n\"parent\": \"engine-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Build and release architecture: branching and merge model, engine release management and versioning, orchestration of the code \\u2192 content \\u2192 package pipeline.\",\n\"non_responsibilities\": [\n[\n\"Build system implementation\",\n\"build-system-toolchains\"\n],\n[\n\"CI pipelines\",\n\"ci-cd-automation\"\n],\n[\n\"Packaging\",\n\"packaging-release-patching\"\n]\n],\n\"provides\": [\n\"C-RELEASE\"\n],\n\"consumes\": [\n\"C-BUILD\",\n\"C-PKG\"\n],\n\"expertise\": [\n\"release engineering\",\n\"branching strategies\"\n],\n\"kind\": \"process\",\n\"targets\": [],\n\"tool_consumes\": [\n\"C-COOK\"\n],\n\"implements\": [],\n\"workstream\": \"release\"\n}\n\n{\n\"id\": \"ci-cd-automation\",\n\"name\": \"CI/CD & Automation\",\n\"tier\": \"expert\",\n\"parent\": \"build-release-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"CI pipelines, build farm and artifact storage, pre-submit and merge gating, symbol servers, device-farm orchestration, developer CLI and automation.\",\n\"non_responsibilities\": [\n[\n\"What tests exist\",\n\"test-architect\"\n],\n[\n\"Perf thresholds\",\n\"performance-architect\"\n]\n],\n\"provides\": [],\n\"consumes\": [\n\"C-BUILD\",\n\"C-COOK\"\n],\n\"expertise\": [\n\"CI systems\",\n\"build farms\",\n\"artifact management\"\n],\n\"kind\": \"tool\",\n\"targets\": [\n\"tools\"\n],\n\"tool_consumes\": [],\n\"implements\": [],\n\"workstream\": \"release\"\n}\n\n{\n\"id\": \"packaging-release-patching\",\n\"name\": \"Packaging, Patching & Release\",\n\"tier\": \"expert\",\n\"parent\": \"build-release-architect\",\n\"profiles\": [\n\"all\"\n],\n\"purpose\": \"Platform packaging and signing, store-submission artifacts, delta/chunk patching, DLC, install-on-demand, client/server/content version compatibility, CDN boundary, release rollback.\",\n\"non_responsibilities\": [\n[\n\"Package runtime format\",\n\"package-formats-vfs\"\n],\n[\n\"Certification tracking\",\n\"certification-compliance\"\n]\n],\n\"provides\": [\n\"C-PKG\"\n],\n\"consumes\": [\n\"C-VFS\",\n\"C-BUILD\",\n\"C-SVC\",\n\"C-COOK\",\n\"C-RELEASE\"\n],\n\"expertise\": [\n\"platform packaging\",\n\"binary diffing\",\n\"content delivery\"\n],\n\"kind\": \"tool\",\n\"targets\": [\n\"t