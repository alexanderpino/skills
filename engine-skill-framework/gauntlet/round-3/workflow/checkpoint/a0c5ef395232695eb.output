{"parentUuid":"69b5c2b2-a81f-446a-9f1c-58da22cc63ab","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a0c5ef395232695eb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CTia1ot7moruxbnebDJAFa","type":"tool_result","content":"<class 'list'>\n===== program-orchestration\n{\n \"id\": \"program-orchestration\",\n \"name\": \"Engine Program Orchestration\",\n \"tier\": \"orchestrator\",\n \"parent\": \"engine-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Turns architecture into coordinated multi-agent work: decomposes milestones into tasks by skill territory, keeps the ownership ledger and territory locks, sequences integration through vertical slices, routes contract change requests, and schedules critic gates.\",\n \"non_responsibilities\": [\n  [\n   \"Deciding architecture\",\n   \"engine-architect\"\n  ],\n  [\n   \"CI mechanics\",\n   \"ci-cd-automation\"\n  ],\n  [\n   \"Release versioning\",\n   \"build-release-architect\"\n  ]\n ],\n \"provides\": [\n  \"C-ORCH\"\n ],\n \"consumes\": [\n  \"C-PROD\"\n ],\n \"expertise\": [\n  \"multi-agent coordination\",\n  \"work breakdown\",\n  \"integration planning\",\n  \"critical-path analysis\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"governance\"\n}\n===== perf-benchmarking\n{\n \"id\": \"perf-benchmarking\",\n \"name\": \"Benchmarking & Performance Regression\",\n \"tier\": \"expert\",\n \"parent\": \"performance-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Benchmark harnesses (micro and representative-workload scenes), automated capture, statistical analysis (variance, significance), regression detection and bisection, dashboards.\",\n \"non_responsibilities\": [\n  [\n   \"Setting budgets\",\n   \"performance-architect\"\n  ],\n  [\n   \"CI infrastructure\",\n   \"ci-cd-automation\"\n  ]\n ],\n \"provides\": [\n  \"C-BENCH\"\n ],\n \"consumes\": [\n  \"C-INSTR\",\n  \"C-BUDGET\"\n ],\n \"expertise\": [\n  \"benchmark statistics\",\n  \"workload design\",\n  \"change-point detection\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"performance\"\n}\n===== test-architect\n{\n \"id\": \"test-architect\",\n \"name\": \"Test Architect\",\n \"tier\": \"cross-cutting\",\n \"parent\": \"engine-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Test strategy and architecture: per-subsystem test pyramid, frameworks, the test definition of done every skill must meet, contract tests, test content, coverage and mutation policy, flakiness policy.\",\n \"non_responsibilities\": [\n  [\n   \"Running pipelines\",\n   \"ci-cd-automation\"\n  ],\n  [\n   \"Performance regression\",\n   \"perf-benchmarking\"\n  ],\n  [\n   \"Rendering image validation\",\n   \"render-validation\"\n  ]\n ],\n \"provides\": [\n  \"C-TEST\"\n ],\n \"consumes\": [],\n \"expertise\": [\n  \"test strategy\",\n  \"contract testing\",\n  \"mutation testing\",\n  \"test determinism\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"quality\"\n}\n===== render-validation\n{\n \"id\": \"render-validation\",\n \"name\": \"Rendering Validation\",\n \"tier\": \"expert\",\n \"parent\": \"test-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Rendering correctness validation: golden-image tests with perceptual metrics, tolerances per GPU/driver, comparisons against the reference path tracer, graphics API validation in CI.\",\n \"non_responsibilities\": [\n  [\n   \"Fixing rendering features\",\n   \"render-architect\"\n  ],\n  [\n   \"Material furnace tests (defines them; this skill runs them)\",\n   \"material-system\"\n  ]\n ],\n \"provides\": [],\n \"consumes\": [\n  \"C-RG\",\n  \"C-RHI\",\n  \"C-RSCENE\",\n  \"C-RT?\"\n ],\n \"expertise\": [\n  \"image metrics (FLIP, SSIM)\",\n  \"GPU nondeterminism\",\n  \"reference rendering\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"quality\"\n}\n===== functional-automation-soak\n{\n \"id\": \"functional-automation-soak\",\n \"name\": \"Functional Automation & Soak\",\n \"tier\": \"expert\",\n \"parent\": \"test-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Game-level automation: scripted and bot playthroughs, smoke/boot tests, soak and stability runs (memory growth, leaks), hardware/OS compatibility matrix, network harnesses and server load tests.\",\n \"non_responsibilities\": [\n  [\n   \"Unit test frameworks\",\n   \"test-architect\"\n  ],\n  [\n   \"Device-farm infrastructure\",\n   \"ci-cd-automation\"\n  ]\n ],\n \"provides\": [],\n \"consumes\": [\n  \"C-GAME?\",\n  \"C-INPUT?\",\n  \"C-NET?\"\n ],\n \"expertise\": [\n  \"game automation\",\n  \"bots\",\n  \"long-run stability analysis\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"quality\"\n}\n===== robustness-fuzzing\n{\n \"id\": \"robustness-fuzzing\",\n \"name\": \"Robustness & Fuzzing\",\n \"tier\": \"expert\",\n \"parent\": \"test-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Robustness engineering: fuzzing every untrusted-input parser (assets, packets, saves, scripts, mods), sanitizer build policy, fault injection (IO errors, OOM, device lost), concurrency stress and schedule perturbation.\",\n \"non_responsibilities\": [\n  [\n   \"Threat model\",\n   \"security-engineering\"\n  ],\n  [\n   \"Fixing parsers\",\n   \"serialization-schema\"\n  ]\n ],\n \"provides\": [],\n \"consumes\": [\n  \"C-SER\",\n  \"C-IO\"\n ],\n \"expertise\": [\n  \"libFuzzer/AFL++\",\n  \"sanitizers\",\n  \"fault injection\",\n  \"TSan\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"quality\",\n \"fuzz_targets\": [\n  \"assets\",\n  \"packets\",\n  \"saves\",\n  \"scripts\",\n  \"mods\",\n  \"replays\",\n  \"remote-config\",\n  \"chat-text\",\n  \"fonts\",\n  \"media-decoders\",\n  \"decompressors\",\n  \"cloud-saves\",\n  \"invites-deep-links\",\n  \"ugc-graphs\",\n  \"generated-content\",\n  \"editor-plugins\",\n  \"imported-dcc-files\"\n ]\n}\n===== certification-compliance\n{\n \"id\": \"certification-compliance\",\n \"name\": \"Certification & Compliance\",\n \"tier\": \"expert\",\n \"parent\": \"test-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Tracks and pre-validates external requirements: platform certification (TRC/XR/Lotcheck class), age ratings, privacy law, accessibility law (CVAA, EAA), third-party licenses and SBOM, photosensitivity testing.\",\n \"non_responsibilities\": [\n  [\n   \"Implementing platform features\",\n   \"platform-architect\"\n  ],\n  [\n   \"Implementing accessibility features\",\n   \"accessibility\"\n  ]\n ],\n \"provides\": [\n  \"C-CERT\"\n ],\n \"consumes\": [\n  \"C-A11Y?\",\n  \"C-SVC\"\n ],\n \"expertise\": [\n  \"platform requirements\",\n  \"privacy law\",\n  \"accessibility law\",\n  \"license compliance\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"quality\"\n}\n===== determinism-replay\n{\n \"id\": \"determinism-replay\",\n \"name\": \"Determinism & Replay\",\n \"tier\": \"cross-cutting\",\n \"parent\": \"engine-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"Defines determinism levels (none, same-binary, cross-platform) per subsystem and the floating-point and parallel-execution rules that achieve them; owns input/state record-replay and desync detection.\",\n \"non_responsibilities\": [\n  [\n   \"Rollback netcode\",\n   \"prediction-rollback\"\n  ],\n  [\n   \"Deterministic math implementation\",\n   \"math-simd-numerics\"\n  ]\n ],\n \"provides\": [\n  \"C-DET\",\n  \"C-SNAPSHOT\",\n  \"C-REPLAY\"\n ],\n \"consumes\": [\n  \"C-MATH\",\n  \"C-TASK\",\n  \"C-SER@C-SNAPSHOT\",\n  \"C-FRAME@C-SNAPSHOT\"\n ],\n \"expertise\": [\n  \"IEEE-754 reproducibility\",\n  \"deterministic scheduling\",\n  \"state hashing\"\n ],\n \"kind\": \"runtime\",\n \"targets\": [\n  \"client\",\n  \"headless-client\",\n  \"server\",\n  \"tools\"\n ],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"foundation\",\n \"untrusted_inputs\": [\n  \"replays\"\n ]\n}\n===== ci-cd-automation\n{\n \"id\": \"ci-cd-automation\",\n \"name\": \"CI/CD & Automation\",\n \"tier\": \"expert\",\n \"parent\": \"build-release-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"purpose\": \"CI pipelines, build farm and artifact storage, pre-submit and merge gating, symbol servers, device-farm orchestration, developer CLI and automation.\",\n \"non_responsibilities\": [\n  [\n   \"What tests exist\",\n   \"test-architect\"\n  ],\n  [\n   \"Perf thresholds\",\n   \"performance-architect\"\n  ]\n ],\n \"provides\": [],\n \"consumes\": [\n  \"C-BUILD\",\n  \"C-COOK\"\n ],\n \"expertise\": [\n  \"CI systems\",\n  \"build farms\",\n  \"artifact management\"\n ],\n \"kind\": \"tool\",\n \"targets\": [\n  \"tools\"\n ],\n \"tool_consumes\": [],\n \"implements\": [],\n \"workstream\": \"release\"\n}\n===== reference-games\n{\n \"id\": \"reference-games\",\n \"name\": \"Reference Games\",\n \"tier\": \"expert\",\n \"parent\": \"program-orchestration\",\n \"profiles\": [\n  \"all\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"workstream\": \"governance\",\n \"purpose\": \"The reference-game ladder (one representative game per configuration) used as milestone and release gate, representative production-scale content sets, and the internal playtest and dogfood loop.\",\n \"non_responsibilities\": [\n  [\n   \"Teaching samples\",\n   \"developer-experience-docs\"\n  ],\n  [\n   \"Benchmark harness\",\n   \"perf-benchmarking\"\n  ]\n ],\n \"consumes\": [],\n \"expertise\": [\n  \"game production\",\n  \"content production\",\n  \"playtesting\"\n ],\n \"tool_consumes\": [],\n \"provides\": [],\n \"implements\": []\n}\n===== simulation-validation\n{\n \"id\": \"simulation-validation\",\n \"name\": \"Simulation & Systems Validation\",\n \"tier\": \"expert\",\n \"parent\": \"test-architect\",\n \"profiles\": [\n  \"all\"\n ],\n \"kind\": \"process\",\n \"targets\": [],\n \"workstream\": \"quality\",\n \"purpose\": \"Runs the objective validation that domain owners define for simulation-class systems: physics stability and reference suites, simulation golden traces, animation error suites, audio offline-render suites, and deterministic network simulation for prediction/replication correctness, mirroring what render-validation does for rendering.\",\n \"non_responsibilities\": [\n  [\n   \"Defining each domain's oracles\",\n   \"owning-skill\"\n  ],\n  [\n   \"Determinism matrix definition\",\n   \"determinism-replay\"\n  ]\n ],\n \"expertise\": [\n  \"simulation testing\",\n  \"deterministic simulation testing\",\n  \"numerical error metrics\"\n ],\n \"consumes\": [],\n \"tool_consumes\": [],\n \"provides\": [],\n \"implements\": []\n}","is_error":false}]},"uuid":"4c639a08-cdd5-4712-8e12-73c954efa6d6","timestamp":"2026-09-29T16:21:46.454Z","sourceToolAssistantUUID":"69b5c2b2-a81f-446a-9f1c-58da22cc63ab","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
