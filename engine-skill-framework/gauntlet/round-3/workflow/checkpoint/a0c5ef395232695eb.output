{"parentUuid":"3131ab9d-774e-4ace-8d29-6e3325129547","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a0c5ef395232695eb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011B7LmVtLgRLCitgX5T1Dq1","type":"tool_result","content":"DOMAIN ARCH Engine architecture, governance & agent organization\nDOMAIN PLAT Platform & hardware abstraction\nDOMAIN CORE Core runtime foundations\nDOMAIN RES Resources, IO, packaging & streaming\nDOMAIN CNT Asset identity & content pipeline\nDOMAIN WLD World representation, streaming & environment\nDOMAIN RND Rendering\nDOMAIN ML Machine-learning runtime\nDOMAIN PHY Physics & simulation\nDOMAIN ANM Animation\nDOMAIN AUD Audio\nDOMAIN INP Input\nDOMAIN NET Networking & multiplayer\nDOMAIN GAM Gameplay, scripting, AI & persistence\nDOMAIN UI UI, text, localization & accessibility\nDOMAIN ED Editor & content tools\nDOMAIN BLD Build, CI/CD & release\nDOMAIN QA Testing & validation\n AREA QA.STRAT Test strategy\n    ['QA.STRAT.pyramid', 'Test strategy & pyramid per subsystem', 'test-architect', 'E']  \n    ['QA.STRAT.frameworks', 'Unit & integration test frameworks', 'test-architect', 'E']  \n    ['QA.STRAT.dod', 'Test definition-of-done contract', 'test-architect', 'E']  \n    ['QA.STRAT.coverage', 'Coverage & mutation testing', 'test-architect', 'E']  \n    ['QA.STRAT.flaky', 'Flaky-test management', 'test-architect', 'E'] ['ci-cd-automation'] \n    ['QA.STRAT.content', 'Test content & test maps', 'test-architect', 'E']  \n    ['QA.STRAT.contracts', 'Contract-test framework & consumer-driven test policy', 'test-architect', 'E']  \n    ['QA.STRAT.oracles', 'Oracle taxonomy & policy (analytic, reference, metamorphic, differential, golden)', 'test-architect', 'E']  \n    ['QA.STRAT.integration', 'Cross-skill integration suites & per-configuration build/boot/test matrix', 'test-architect', 'E'] ['ci-cd-automation', 'developer-experience-docs'] \n    ['QA.STRAT.release-criteria', 'Ship/launch gate (crash-free rate, perf gates, cert pre-checks, known issues)', 'test-architect', 'E'] ['reference-games'] \n    ['QA.STRAT.contract-fakes', 'Contract-first fakes/mocks so consumers start before providers finish', 'test-architect', 'E'] ['program-orchestration'] \n AREA QA.RENDER Rendering validation\n    ['QA.RENDER.matrix', 'GPU / driver matrix testing', 'render-validation', 'E'] ['rhi-core'] \n    ['QA.RENDER.reference', 'Path-traced reference comparison', 'render-validation', 'E'] ['path-tracing'] \n    ['QA.RENDER.api-validation', 'Graphics API validation layers in CI', 'render-validation', 'E'] ['rhi-core'] \n AREA QA.FUNC Functional & stability testing\n    ['QA.FUNC.automation', 'Gameplay automation & bots', 'functional-automation-soak', 'E']  \n    ['QA.FUNC.smoke', 'Smoke & boot tests', 'functional-automation-soak', 'E']  \n    ['QA.FUNC.soak', 'Soak & stability testing (memory growth, leaks)', 'functional-automation-soak', 'E']  \n    ['QA.FUNC.compat', 'Hardware / OS compatibility matrix', 'functional-automation-soak', 'E']  \n    ['QA.FUNC.network', 'Network test harnesses', 'functional-automation-soak', 'E'] ['network-transport'] \n    ['QA.FUNC.load', 'Server load testing', 'functional-automation-soak', 'E'] ['dedicated-server'] \n    ['QA.FUNC.editor', 'Editor & tool automation, regression & soak testing', 'functional-automation-soak', 'E'] ['editor-ui-framework'] \n    ['QA.FUNC.agent-exploration', 'RL/LLM exploratory test agents', 'functional-automation-soak', 'M']  \n    ['QA.FUNC.bug-capture', 'In-game bug reporting with repro capture & tracker integration', 'functional-automation-soak', 'E'] ['crash-diagnostics', 'observability-telemetry', 'determinism-replay'] \n    ['QA.FUNC.playtest', 'Playtest capture, heatmaps & UX-research instrumentation', 'functional-automation-soak', 'E'] ['observability-telemetry'] \n AREA QA.ROBUST Robustness\n    ['QA.ROBUST.fuzzing', 'Fuzzing of every registered untrusted input (see fuzz_targets)', 'robustness-fuzzing', 'E']  \n    ['QA.ROBUST.sanitizers', 'Sanitizer build policy (ASan, UBSan, TSan)', 'robustness-fuzzing', 'E']  \n    ['QA.ROBUST.faults', 'Fault injection (IO errors, OOM, device lost)', 'robustness-fuzzing', 'E']  \n    ['QA.ROBUST.concurrency', 'Concurrency stress & schedule perturbation', 'robustness-fuzzing', 'E'] ['concurrency-primitives'] \n AREA QA.CERT Certification & compliance\n    ['QA.CERT.platform', 'Platform certification requirements tracking', 'certification-compliance', 'E']  \n    ['QA.CERT.prechecks', 'Automated certification pre-checks', 'certification-compliance', 'E']  \n    ['QA.CERT.ratings', 'Age-rating content compliance', 'certification-compliance', 'E']  \n    ['QA.CERT.privacy', 'Privacy-law compliance (GDPR, COPPA class)', 'certification-compliance', 'E'] ['security-engineering'] \n    ['QA.CERT.a11y-law', 'Accessibility-law compliance', 'certification-compliance', 'E'] ['accessibility'] \n    ['QA.CERT.licenses', 'Third-party license compliance & SBOM', 'certification-compliance', 'E'] ['security-engineering'] \n    ['QA.CERT.photosensitivity', 'Photosensitive-seizure testing', 'certification-compliance', 'E'] ['render-validation'] \n    ['QA.CERT.programs', 'Non-console verification programs (Steam Deck Verified, store review)', 'certification-compliance', 'E'] ['platform-desktop', 'platform-mobile'] \n    ['QA.CERT.store-policy', 'Store-policy compliance (account deletion, tracking, IAP rules, alternative stores)', 'certification-compliance', 'E'] ['platform-services'] \n    ['QA.CERT.monetization-law', 'Loot-box & odds-disclosure law', 'certification-compliance', 'E'] ['platform-services'] \n    ['QA.CERT.regional', \"Regional regimes (licensing, real-name, minors' playtime, data localization)\", 'certification-compliance', 'E'] ['platform-services'] \n    ['QA.CERT.export-crypto', 'Encryption export compliance', 'certification-compliance', 'E'] ['security-engineering'] \n    ['QA.CERT.genai', 'Rating & platform disclosure for runtime-generated content', 'certification-compliance', 'E'] ['ai-behavior-perception'] \n AREA QA.REF Reference games\n    ['QA.REF.ladder', 'Reference-game ladder per configuration as milestone & release gate', 'reference-games', 'E'] ['test-architect'] \n    ['QA.REF.content', 'Representative production-scale content sets', 'reference-games', 'E'] ['perf-benchmarking'] \n    ['QA.REF.dogfood', 'Internal playtest & dogfood loop', 'reference-games', 'E']  \n AREA QA.AGENT Validation of agent-produced work\n    ['QA.AGENT.oracle-independence', 'Acceptance tests & oracles authored or approved by an agent other than the implementer', 'test-architect', 'E'] ['program-orchestration'] \n    ['QA.AGENT.baseline-governance', 'Governed changes to goldens, tolerances, perf thresholds, hashes & corpora', 'test-architect', 'E'] ['render-validation', 'perf-benchmarking'] \n    ['QA.AGENT.test-integrity', 'Detection of weakened tests (deleted/skipped cases, loosened tolerances, assert-free tests, input special-casing) as a merge gate', 'test-architect', 'E'] ['ci-cd-automation'] \n    ['QA.AGENT.mutation-gate', 'Mutation-score thresholds per skill tier as part of the definition of done', 'test-architect', 'E']  \n AREA QA.SIM Simulation & systems validation\n    ['QA.SIM.stability-suite', 'Physics stability regression suite (stacking, joints, mass ratios, CCD)', 'simulation-validation', 'E'] ['rigid-body-dynamics', 'physics-2d'] \n    ['QA.SIM.golden-traces', 'Simulation golden-trace comparison', 'simulation-validation', 'E'] ['determinism-replay'] \n    ['QA.SIM.netsim', 'Deterministic network simulation under link conditions', 'simulation-validation', 'E'] ['prediction-rollback', 'replication'] \n    ['QA.SIM.animation', 'Animation error suites (compression, retarget, IK)', 'simulation-validation', 'E'] ['animation-architect'] \n    ['QA.SIM.audio', 'Audio offline-render, loudness & glitch suites', 'simulation-validation', 'E'] ['audio-architect'] \nDOMAIN PRF Performance engineering\nDOMAIN OBS Observability & diagnostics\nDOMAIN XC Cross-cutting runtime disciplines","is_error":false}]},"uuid":"8f82831f-fc35-4472-ae42-c049d5f062cd","timestamp":"2026-09-29T16:21:41.998Z","sourceToolAssistantUUID":"3131ab9d-774e-4ace-8d29-6e3325129547","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
