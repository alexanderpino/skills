{"parentUuid":"6ee3e54c-c2e9-470d-af7a-0e07a30d9174","isSidechain":true,"promptId":"9bdfc07b-8ff1-4e95-9c88-de7440fd6192","agentId":"a7253f978e1829a88","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018ZkibDizrHZHWo9kiN2iaU","type":"tool_result","content":"===== ml-inference-runtime\n{\"id\": \"ml-inference-runtime\", \"name\": \"ML Inference Runtime\", \"tier\": \"expert\", \"parent\": \"gpu-platform-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Runtime neural-network inference shared by neural rendering, animation, audio and AI: GPU (cooperative-vector / tensor) and CPU backends, model packaging and quantization, scheduling within frame budgets, determinism characteristics.\", \"non_responsibilities\": [[\"Vendor upscalers\", \"reconstruction-upscaling\"], [\"In-shader (fused) networks\", \"shader-system\"], [\"Neural feature design\", \"owning-skill\"], [\"Model training\", \"external:ml-training\"]], \"provides\": [\"C-ML\", \"C-MLGPU\"], \"consumes\": [\"C-TASK\", \"C-RHI?@C-MLGPU\", \"C-RG?@C-MLGPU\", \"C-PAL\"], \"expertise\": [\"inference engines\", \"quantization\", \"cooperative vectors\", \"ONNX\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"headless-client\", \"server\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== xr-runtime\n{\"id\": \"xr-runtime\", \"name\": \"XR Runtime\", \"tier\": \"expert\", \"parent\": \"platform-architect\", \"profiles\": [\"xr\"], \"purpose\": \"XR integration: OpenXR, stereo/multiview rendering hooks, foveation, reprojection and latency, XR input and hand tracking, comfort and safety requirements.\", \"non_responsibilities\": [[\"Render pipeline\", \"render-architect\"], [\"Generic input actions\", \"input-system\"]], \"provides\": [\"C-XRVIEW\"], \"consumes\": [\"C-PAL\", \"C-INPUT\", \"C-FRAME\", \"C-PRESENT\", \"C-VIEW\", \"C-DEVICE\", \"C-TEMPORAL?\", \"C-A11Y\"], \"expertise\": [\"OpenXR\", \"stereo rendering\", \"motion-