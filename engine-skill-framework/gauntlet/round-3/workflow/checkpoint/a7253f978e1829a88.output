\", \"name\": \"Path Tracing\", \"tier\": \"expert\", \"parent\": \"render-architect\", \"profiles\": [\"lite3d\", \"std3d\"], \"purpose\": \"Reference path tracer as ground-truth oracle for validation, real-time path tracing, offline cinematic render mode.\", \"non_responsibilities\": [[\"Movie render orchestration\", \"cinematics-sequencer\"], [\"Image comparison tests\", \"render-validation\"]], \"provides\": [], \"consumes\": [\"C-RT?\", \"C-MATIF\", \"C-RSCENE\", \"C-LIGHT\", \"C-GI?\"], \"expertise\": [\"Monte Carlo rendering\", \"ReSTIR PT\", \"spectral rendering\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [], \"implements\": [], \"workstream\": \"rendering\"}\n===== audio-content-runtime\n{\"id\": \"audio-content-runtime\", \"name\": \"Audio Content Runtime\", \"tier\": \"expert\", \"parent\": \"audio-architect\", \"profiles\": [\"all\"], \"purpose\": \"Audio event system and parameters, interactive music, dialogue and VO, authoring tool integration, audio-to-haptics.\", \"non_responsibilities\": [[\"Localization pipeline\", \"localization-i18n\"], [\"Haptics devices\", \"input-devices-haptics\"]], \"provides\": [], \"consumes\": [\"C-AUDIO\", \"C-ASSET\", \"C-LOC\", \"C-DIALOGUE?\", \"C-DEVICE?\", \"C-ML?\", \"C-A11Y\"], \"expertise\": [\"sound design systems\", \"adaptive music\", \"VO pipelines\"], \"kind\": \"runtime\", \"targets\": [\"client\", \"tools\"], \"tool_consumes\": [\"C-GRAPH\", \"C-EDCMD\", \"C-EDHOST\"], \"implements\": [], \"workstream\": \"audio\"}\n===== ai-behavior-perception\n{\"id\": \"ai-behavior-perception\", \"name\": \"AI Behavior & Perception\", \"tier\": \"expert\", \"parent\": \"gameplay-architect\", \"profiles\": [\"all\"], \"purpose\": \"Decision making (behavior trees, utility, HTN/GOAP, state trees), perception, environment queries, smart objects, AI scheduling and LOD; evaluates learned and LLM-driven agents.\", \"non_responsibilities\": [[\"Navigation\", \"navigation-pathfinding\"], 