\", 6634- [ 6635- \"narrative-dialogue\", 6636- \"persistence-save\" 6640: \"GAM.FW.streamer-mode\", 6641- \"Streamer-safe mode (licensed music, PII hiding)\", 6642- \"gameplay-architect\", 6643- \"E\", 6644- [ 6645- \"audio-content-runtime\" 6646- ]\n2: \"_doc\": \"Milestone ladder (walking skeleton first, then widening). Each milestone lists the build skills that join it; check.py proves each milestone closed over its own and earlier milestones' skills. Process skills are active from M0. Contracts reach 'draft' when first consumed and 'frozen' at the listed milestone.\",\n3: \"milestones\": [\n199:   \"name\": \"Online\",\n200:   \"configuration\": \"online-3d-server\",\n202:    \"network-architect\",\n203:    \"network-transport\",\n208:    \"online-services-liveops\"\n210:   \"exit\": \"Online reference game with dedicated server, prediction/rollback, bot load test and cert pre-checks for online features.\",\n212:    \"C-NET\",\n213:    \"C-NETLINK\",\n222:   \"configuration\": \"aaa-open-world-online-client\",","is_error":false}]},"uuid":"cf473b92-56f3-4163-a562-7b287f2c9ac4","timestamp":"2026-09-29T16:22:06.879Z","sourceToolAssistantUUID":"8cb5b5c7-6be7-4789-9845-1aa504d7046b","userType":"external","entrypoint":"remote_mobile","cwd":"/home/user/skills","sessionId":"64f15158-6a4e-5bdf-8a90-7f2bd7b05b82","version":"2.1.284","gitBranch":"claude/engine-skill-framework-phase1"}
